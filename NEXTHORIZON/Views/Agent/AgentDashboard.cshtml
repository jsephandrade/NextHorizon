@{
    ViewData["Title"] = "Agent Dashboard";
    Layout = "~/Views/Shared/_AgentLayout.cshtml";
}

<link rel="stylesheet" href="~/css/AgentDashboard.css" asp-append-version="true" />

<section class="qa-page">
    <div class="agent-welcome-message">
        <div class="agent-welcome-kicker">Agent workspace</div>
        <h2>Welcome, @ViewBag.AgentName</h2>
        <p>Here is your monthly performance view, queue history, and scorecard access.</p>
    </div>

    <div class="hero-container">
        <button class="hero tab-btn active" data-tab="qa" aria-label="View QA Score Tab" type="button">
            <div class="hero-top-flex">
                <h1>QA Score</h1>
                <div class="hero-metric" id="qa-score-metric">0.0%</div>
            </div>
            <p id="qa-score-update">Last Update: No updates yet</p>
            <p id="qa-score-reviewed">0/0 reviewed this month</p>
            <p id="qa-score-rank">Rank: Not ranked yet</p>
            <span class="tab-btn-spinner" aria-hidden="true"></span>
        </button>

        <button class="hero tab-btn" data-tab="aht" aria-label="View Average Handling Time Tab" type="button">
            <div class="hero-top-flex">
                <h1>Average Handling Time (AHT)</h1>
                <div class="hero-metric hero-metric-clock" id="aht-metric">0:00<span class="hero-metric-unit">minutes</span></div>
            </div>
            <p id="aht-update">Last Update: No updates yet</p>
            <p id="aht-rank">Rank: Not ranked yet</p>
            <span class="tab-btn-spinner" aria-hidden="true"></span>
        </button>

        <button class="hero tab-btn" data-tab="acw" aria-label="View After Chat Work Tab" type="button">
            <div class="hero-top-flex">
                <h1>After Chat Work (ACW)</h1>
                <div class="hero-metric hero-metric-clock" id="acw-metric">0:00<span class="hero-metric-unit">minutes</span></div>
            </div>
            <p>Completed after-chat intervals this month</p>
            <span class="tab-btn-spinner" aria-hidden="true"></span>
        </button>
    </div>

    <section class="dashboard-lower-grid">
        <section class="page-wrap">
            <div class="head">
                <div class="head-top">
                    <div>
                        <h2 id="dynamic-section-title">Quality Evaluations</h2>
                        <div class="head-sub" id="dynamic-section-sub">Review your performance evaluations and detailed quality
                            feedback.</div>
                    </div>
                    <button id="resolved-tickets-trigger" class="btn secondary head-action-btn" type="button">Resolved tickets</button>
                </div>
                    <div class="filters">
                        <div class="filter-help" id="filter-help">
                            Use the filters below to browse rated tickets from your dashboard history.
                        </div>
                        <div class="filter-grid">
                            <div class="filter-field">
                                <label class="filter-label" for="quick-range">Date preset</label>
                                <select id="quick-range" class="filter-select">
                                    <option value="custom">Custom range</option>
                                    <option value="today">Today</option>
                                    <option value="last7">Last 7 days</option>
                                    <option value="last30">Last 30 days</option>
                                </select>
                            </div>
                            <div class="filter-field">
                                <label class="filter-label" for="from-date">Rated date from</label>
                                <input id="from-date" class="filter-input" type="date" />
                            </div>
                            <div class="filter-field">
                                <label class="filter-label" for="to-date">Rated date to</label>
                                <input id="to-date" class="filter-input" type="date" />
                            </div>
                            <div class="filter-field">
                                <label class="filter-label" for="score-filter">Score range</label>
                                <select id="score-filter" class="filter-select">
                                    <option value="">Score filter</option>
                                    <option value="high">90% to 100%</option>
                                    <option value="good">80% to 89.9%</option>
                                    <option value="mid">70% to 79.9%</option>
                                    <option value="low">Below 70%</option>
                                </select>
                            </div>
                        </div>
                        <div class="search-wrap">
                            <i class="bi bi-search"></i>
                            <input id="rated-search" class="search" type="text"
                                   placeholder="Search by ticket, customer, reviewer, or date..." />
                        </div>
                    </div>
                </div>

                <div class="rows" id="rated-list"></div>
                <div class="pagination-bar" id="rated-pagination" hidden></div>
                <div id="rated-empty" class="empty-state" style="display:none;">No rated tickets found for the selected filters.
                </div>
                <div id="dashboard-loading" class="empty-state">Loading dashboard data...</div>
                <div id="tab-loading-overlay" class="tab-loading-overlay" aria-hidden="true" aria-live="polite">
                    <div class="tab-loading-spinner" aria-hidden="true"></div>
                    <span class="tab-loading-label">Loading records...</span>
                </div>
            </section>

        <aside class="scorecard-widget" aria-labelledby="scorecard-title">
            <div class="scorecard-head">
                <div>
                    <p class="scorecard-kicker">Monthly scorecards</p>
                    <h3 id="scorecard-title">Scorecard</h3>
                </div>
                <div class="scorecard-month">Per month</div>
            </div>

            <div class="scorecard-subtext">
                Filter by month to open past, current, or future scorecards.
            </div>

            <div class="scorecard-filter">
                <label class="scorecard-filter-label" for="scorecard-month-filter">Filter month</label>
                <input id="scorecard-month-filter" class="scorecard-filter-input" type="month" />
                <p class="scorecard-filter-help">Choose any month to check scorecard history or preview a future month.</p>
            </div>

            <div class="scorecard-month-list" id="scorecard-month-list">
                <div class="scorecard-month-empty">Loading monthly scorecards...</div>
            </div>

            <div class="scorecard-foot">
                <span class="scorecard-foot-label">Source</span>
                <span>Monthly values are loaded from the database.</span>
            </div>
        </aside>
    </section>

    <div id="scorecard-modal" class="scorecard-modal-overlay" aria-hidden="true">
        <div class="scorecard-modal-card" role="dialog" aria-modal="true" aria-labelledby="scorecard-modal-title">
            <button class="scorecard-modal-close" id="scorecard-modal-close" type="button" aria-label="Close scorecard">&times;</button>
            <div class="scorecard-modal-head">
                <div>
                    <p class="scorecard-kicker">Monthly scorecard</p>
                    <h3 id="scorecard-modal-title">Scorecard</h3>
                </div>
                <div class="scorecard-month" id="scorecard-modal-month">Month</div>
            </div>

            <div class="scorecard-modal-grid">
                <article class="scorecard-modal-item">
                    <div class="scorecard-metric-label">QA Score</div>
                    <div class="scorecard-modal-value" id="scorecard-modal-qa">No data</div>
                    <div class="scorecard-metric-meta" id="scorecard-modal-qa-rank">Rank: Not ranked yet</div>
                </article>

                <article class="scorecard-modal-item">
                    <div class="scorecard-metric-label">AHT</div>
                    <div class="scorecard-modal-value scorecard-modal-value-clock" id="scorecard-modal-aht">No data</div>
                    <div class="scorecard-metric-meta" id="scorecard-modal-aht-rank">Rank: Not ranked yet</div>
                </article>

                <article class="scorecard-modal-item">
                    <div class="scorecard-metric-label">ACW</div>
                    <div class="scorecard-modal-value scorecard-modal-value-clock" id="scorecard-modal-acw">No data</div>
                    <div class="scorecard-metric-meta">Monthly average from tracked ACW records</div>
                </article>
            </div>

            <div class="scorecard-foot">
                <span class="scorecard-foot-label">Database sync</span>
                <span id="scorecard-modal-updated">Last Update: No updates yet</span>
            </div>
        </div>
    </div>

    <div id="resolved-tickets-modal" class="resolved-modal-overlay" aria-hidden="true" hidden>
        <div class="resolved-modal-card" role="dialog" aria-modal="true" aria-labelledby="resolved-modal-title">
            <button class="scorecard-modal-close" id="resolved-modal-close" type="button" aria-label="Close resolved tickets">&times;</button>
            <div class="resolved-modal-head">
                <div>
                    <h3 id="resolved-modal-title">Resolved tickets</h3>
                </div>
                <div class="scorecard-month" id="resolved-modal-count">0 tickets</div>
            </div>

            <div class="resolved-summary-grid">
                <article class="resolved-summary-card">
                    <div class="resolved-summary-label">Total resolved tickets</div>
                    <div class="resolved-summary-value" id="resolved-summary-total">0</div>
                </article>
                <article class="resolved-summary-card">
                    <div class="resolved-summary-label">Reviewed tickets</div>
                    <div class="resolved-summary-value" id="resolved-summary-reviewed">0</div>
                </article>
                <article class="resolved-summary-card">
                    <div class="resolved-summary-label">Pending tickets</div>
                    <div class="resolved-summary-value" id="resolved-summary-pending">0</div>
                </article>
            </div>

            <div class="resolved-modal-filters">
                <div class="filter-grid resolved-filter-grid">
                    <div class="filter-field">
                        <label class="filter-label" for="resolved-quick-range">Date preset</label>
                        <select id="resolved-quick-range" class="filter-select">
                            <option value="custom">Custom range</option>
                            <option value="today">Today</option>
                            <option value="last7">Last 7 days</option>
                            <option value="last30">Last 30 days</option>
                        </select>
                    </div>
                    <div class="filter-field">
                        <label class="filter-label" for="resolved-from-date">Resolved date from</label>
                        <input id="resolved-from-date" class="filter-input" type="date" />
                    </div>
                    <div class="filter-field">
                        <label class="filter-label" for="resolved-to-date">Resolved date to</label>
                        <input id="resolved-to-date" class="filter-input" type="date" />
                    </div>
                </div>
                <div class="search-wrap">
                    <i class="bi bi-search"></i>
                    <input id="resolved-search" class="search" type="text"
                           placeholder="Search by ticket, customer, review status, reviewer, or date..." />
                </div>
            </div>

            <div id="resolved-ticket-list" class="resolved-ticket-list"></div>
            <div class="pagination-bar" id="resolved-pagination" hidden></div>
            <div id="resolved-ticket-empty" class="empty-state resolved-empty-state" style="display:none;">No resolved tickets found for the selected filters.</div>
        </div>
    </div>

        <div id="qa-review-modal" class="qa-modal-overlay" aria-hidden="true">
            <div class="qa-modal-container" role="dialog" aria-modal="true" aria-labelledby="modal-rating-title">
                <button class="qa-modal-close" id="close-qa-modal" aria-label="Close modal" type="button">&times;</button>

                <div class="rating-shell">
                    <article class="panel">
                        <header class="panel-head">
                            <div>
                                <div class="panel-title">Conversation view</div>
                                <div id="modal-convo-summary" class="sub conversation-summary">Loading review...</div>
                                <div class="sub">QA comments are read-only.</div>
                            </div>
                        </header>

                        <div class="convo-body" id="modal-convo-body">
                            <div class="modal-state">Loading review details...</div>
                        </div>
                    </article>

                    <article class="panel qa-panel">
                        <header class="panel-head">
                            <div>
                                <div class="panel-title" id="modal-rating-title">QA rating panel</div>
                                <div class="sub">Review your interaction evaluation</div>
                            </div>
                            <span class="rated-badge" id="modal-review-badge">Rated</span>
                        </header>

                        <div class="rate-body">
                            <div id="modal-rating-summary" class="summary-grid summary-grid-compact" hidden></div>

                            <div id="modal-rating-overall" class="summary-card" hidden>
                                <div class="summary-label" id="modal-overall-label">Overall weighted score</div>
                                <div id="modal-overall" class="summary-value"><strong>0.0 / 100</strong></div>
                            </div>

                            <div id="modal-rating-meta" class="summary-meta" hidden>
                                <div id="modal-reviewed-by">QA: QA Reviewer</div>
                            </div>

                            <div id="modal-rating-notes-wrap" hidden>
                                <div class="summary-label">QA notes</div>
                                <div id="modal-qa-notes" class="summary-note">No QA notes were recorded for this review.
                                </div>
                            </div>

                            <div class="agent-notes-box">
                                <label class="summary-label" for="modal-agent-notes">Agent Notes</label>
                                <textarea id="modal-agent-notes" class="agent-notes-input"
                                          placeholder="Add your notes or reflections on this QA review..."></textarea>
                            </div>

                            <div class="summary-actions modal-action-row">
                                <button id="modal-view-rating-btn" class="btn secondary" type="button">View rating</button>
                                <button id="modal-save-notes-btn" class="btn secondary" type="button">Save notes</button>
                                <button id="modal-acknowledge-btn" class="btn primary" type="button">Acknowledge</button>
                            </div>
                            <div id="modal-feedback-status" class="modal-feedback-status" hidden></div>

                            <div id="modal-rating-breakdown" class="rated-readonly" hidden></div>

                            <div class="summary-actions">
                                <button id="modal-close-btn" class="btn secondary" type="button">Close</button>
                            </div>
                        </div>
                    </article>
                </div>
            </div>
        </div>
    </section>

    <script>
        (function () {
            const dashboardEndpoint = '/Agent/api/dashboard';
            const ticketDetailEndpointBase = '/Agent/api/dashboard/';
            const tabs = document.querySelectorAll('.tab-btn[data-tab]');
            const ratedList = document.getElementById('rated-list');
            const emptyState = document.getElementById('rated-empty');
            const loadingState = document.getElementById('dashboard-loading');
            const pageWrap = document.querySelector('.page-wrap');
            const tabLoadingOverlay = document.getElementById('tab-loading-overlay');
            const searchInput = document.getElementById('rated-search');
            const quickRange = document.getElementById('quick-range');
            const fromDate = document.getElementById('from-date');
            const toDate = document.getElementById('to-date');
            const scoreFilter = document.getElementById('score-filter');
            const scorecardMonthList = document.getElementById('scorecard-month-list');
            const scorecardMonthFilter = document.getElementById('scorecard-month-filter');
            const scorecardModal = document.getElementById('scorecard-modal');
            const scorecardModalClose = document.getElementById('scorecard-modal-close');
            const scorecardModalTitle = document.getElementById('scorecard-modal-title');
            const scorecardModalMonth = document.getElementById('scorecard-modal-month');
            const scorecardModalQa = document.getElementById('scorecard-modal-qa');
            const scorecardModalQaRank = document.getElementById('scorecard-modal-qa-rank');
            const scorecardModalAht = document.getElementById('scorecard-modal-aht');
            const scorecardModalAhtRank = document.getElementById('scorecard-modal-aht-rank');
            const scorecardModalAcw = document.getElementById('scorecard-modal-acw');
            const scorecardModalUpdated = document.getElementById('scorecard-modal-updated');
            const resolvedTicketsTrigger = document.getElementById('resolved-tickets-trigger');
            const resolvedTicketsModal = document.getElementById('resolved-tickets-modal');
            const resolvedModalClose = document.getElementById('resolved-modal-close');
            const resolvedModalCount = document.getElementById('resolved-modal-count');
            const resolvedSummaryTotal = document.getElementById('resolved-summary-total');
            const resolvedSummaryReviewed = document.getElementById('resolved-summary-reviewed');
            const resolvedSummaryPending = document.getElementById('resolved-summary-pending');
            const resolvedTicketList = document.getElementById('resolved-ticket-list');
            const resolvedPagination = document.getElementById('resolved-pagination');
            const resolvedTicketEmpty = document.getElementById('resolved-ticket-empty');
            const resolvedQuickRange = document.getElementById('resolved-quick-range');
            const resolvedFromDate = document.getElementById('resolved-from-date');
            const resolvedToDate = document.getElementById('resolved-to-date');
            const resolvedSearch = document.getElementById('resolved-search');
            const qaModal = document.getElementById('qa-review-modal');
            const closeQaModal = document.getElementById('close-qa-modal');
            const modalCloseBtn = document.getElementById('modal-close-btn');
            const modalViewRatingBtn = document.getElementById('modal-view-rating-btn');
            const modalSaveNotesBtn = document.getElementById('modal-save-notes-btn');
            const modalAcknowledgeBtn = document.getElementById('modal-acknowledge-btn');
            const modalAgentNotes = document.getElementById('modal-agent-notes');
            const modalFeedbackStatus = document.getElementById('modal-feedback-status');
            const modalReviewBadge = document.getElementById('modal-review-badge');
            const sectionTitle = document.getElementById('dynamic-section-title');
            const sectionSub = document.getElementById('dynamic-section-sub');
            const filterHelp = document.getElementById('filter-help');
            const fromDateLabel = document.querySelector('label[for="from-date"]');
            const toDateLabel = document.querySelector('label[for="to-date"]');
            const detailCache = new Map();
            const minTabTransitionMs = 220;
            const initialTicketIdParam = new URLSearchParams(window.location.search).get('ticketId');
            const ratedPagination = document.getElementById('rated-pagination');
            const dashboardRefreshIntervalMs = 5000;

            const tabConfig = {
                qa: {
                    title: 'Quality Evaluations',
                    sub: 'Review your performance evaluations and detailed quality feedback.',
                    help: 'Use the filters below to browse rated tickets from your dashboard history.',
                    overallLabel: 'Overall weighted score'
                },
                aht: {
                    title: 'Average Handling Time Records',
                    sub: 'Review your interaction durations and efficiency metrics.',
                    help: 'Use the filters below to review your rated tickets and recorded handling times.',
                    overallLabel: 'Handling time'
                },
                acw: {
                    title: 'After Chat Work Records',
                    sub: 'Review completed after-chat intervals captured from your live chat sessions.',
                    help: 'Use the filters below to review completed ACW intervals backed by QA-reviewed conversations.',
                    overallLabel: 'After chat work'
                }
            };

            let currentTab = 'qa';
            let dashboardData = null;
            let currentDetail = null;
            let currentScorecard = null;
            let tabTransitionRequestId = 0;
            let currentMainPage = 1;
            let currentResolvedPage = 1;
            let hasOpenedTicketFromQueryParam = false;
            let isDashboardLoading = false;
            let dashboardRefreshTimerId = 0;
            let modalNotesDirty = false;
            const pageSize = 5;

            function getCurrentMonthKey() {
                const now = new Date();
                return `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;
            }

            function setMetricText(id, text) {
                const node = document.getElementById(id);
                if (node) node.textContent = text;
            }

            function wait(milliseconds) {
                return new Promise(function (resolve) {
                    window.setTimeout(resolve, milliseconds);
                });
            }

            function setActiveTabButton(tabName) {
                tabs.forEach(function (node) {
                    node.classList.toggle('active', node.dataset.tab === tabName);
                });
            }

            function setTabTransitionLoading(isLoading) {
                if (pageWrap) {
                    pageWrap.classList.toggle('is-tab-switching', isLoading);
                }

                if (tabLoadingOverlay) {
                    tabLoadingOverlay.setAttribute('aria-hidden', isLoading ? 'false' : 'true');
                }
            }

            function setTabButtonLoading(tabName, isLoading) {
                tabs.forEach(function (node) {
                    node.classList.toggle('loading', node.dataset.tab === tabName && isLoading);
                });
            }

            async function switchDashboardTab(nextTab) {
                if (!nextTab || nextTab === currentTab) {
                    return;
                }

                const requestId = ++tabTransitionRequestId;
                const transitionStartedAt = Date.now();
                setActiveTabButton(nextTab);
                setTabButtonLoading(nextTab, true);
                setTabTransitionLoading(true);

                try {
                    currentTab = nextTab;
                    currentMainPage = 1;
                    setSectionState();
                    applyFilters();

                    if (currentDetail) {
                        const matchedSummary = getCurrentRows().find(item => item.supportFaqId === currentDetail.supportFaqId);
                        renderModal(currentDetail, matchedSummary || null);
                    }
                } finally {
                    const elapsed = Date.now() - transitionStartedAt;
                    const remaining = minTabTransitionMs - elapsed;
                    if (remaining > 0) {
                        await wait(remaining);
                    }

                    if (requestId === tabTransitionRequestId) {
                        setTabTransitionLoading(false);
                        setTabButtonLoading(nextTab, false);
                    }
                }
            }

            function toIsoDate(date) {
                const y = date.getFullYear();
                const m = String(date.getMonth() + 1).padStart(2, '0');
                const d = String(date.getDate()).padStart(2, '0');
                return y + '-' + m + '-' + d;
            }

            function applyQuickRange() {
                applyRangeInputs(quickRange, fromDate, toDate);
            }

            function applyResolvedQuickRange() {
                applyRangeInputs(resolvedQuickRange, resolvedFromDate, resolvedToDate);
            }

            function applyRangeInputs(rangeSelect, startInput, endInput) {
                const selected = rangeSelect.value;
                if (!selected || selected === 'custom') return;

                const end = new Date();
                end.setHours(0, 0, 0, 0);

                const start = new Date(end);
                if (selected === 'last7') start.setDate(start.getDate() - 6);
                else if (selected === 'last30') start.setDate(start.getDate() - 29);

                startInput.value = toIsoDate(start);
                endInput.value = toIsoDate(end);
            }

            function setSectionState() {
                const config = tabConfig[currentTab];
                sectionTitle.textContent = config.title;
                sectionSub.textContent = config.sub;
                filterHelp.textContent = config.help;
                document.getElementById('modal-overall-label').textContent = config.overallLabel;
                if (resolvedTicketsTrigger) {
                    resolvedTicketsTrigger.hidden = currentTab !== 'qa';
                }

                if (fromDateLabel) {
                    fromDateLabel.textContent = currentTab === 'acw' ? 'ACW end date from' : 'Rated date from';
                }

                if (toDateLabel) {
                    toDateLabel.textContent = currentTab === 'acw' ? 'ACW end date to' : 'Rated date to';
                }

                if (searchInput) {
                    searchInput.placeholder = currentTab === 'acw'
                        ? 'Search by ticket, customer, category, chat status, or date...'
                        : 'Search by ticket, customer, reviewer, or date...';
                }
            }

            function escapeHtml(value) {
                return String(value || '')
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;');
            }

            function escapeWithBreaks(value) {
                return escapeHtml(value).replace(/\r?\n/g, '<br>');
            }

            function renderMinuteClock(totalSeconds) {
                const safeSeconds = Number.isFinite(totalSeconds) && totalSeconds > 0 ? Math.round(totalSeconds) : 0;
                const minutes = Math.floor(safeSeconds / 60);
                const seconds = safeSeconds % 60;
                return `${minutes}:${String(seconds).padStart(2, '0')}<span class="hero-metric-unit">minutes</span>`;
            }

            function setClockMetricHtml(id, totalSeconds) {
                const node = document.getElementById(id);
                if (!node) return;
                node.innerHTML = renderMinuteClock(totalSeconds);
            }

            function findScorecardByMonthKey(months, monthKey) {
                if (!monthKey) {
                    return null;
                }

                return (months || []).find(function (item) {
                    return item.monthKey === monthKey;
                }) || null;
            }

            function setSelectedScorecardMonth(monthKey, options) {
                if (!scorecardMonthFilter) {
                    return;
                }

                const shouldOpen = !options || options.openModal !== false;
                const normalizedMonthKey = monthKey || getCurrentMonthKey();
                scorecardMonthFilter.value = normalizedMonthKey;

                if (!dashboardData) {
                    return;
                }

                renderScorecardMonths(dashboardData.monthScorecards || []);

                if (!shouldOpen) {
                    return;
                }

                const matchingScorecard = findScorecardByMonthKey(dashboardData.monthScorecards || [], normalizedMonthKey);
                openScorecardModal(matchingScorecard || buildEmptyScorecard(normalizedMonthKey));
            }

            function renderScorecardMonths(months) {
                if (!scorecardMonthList) {
                    return;
                }

                const selectedMonthKey = scorecardMonthFilter && scorecardMonthFilter.value
                    ? scorecardMonthFilter.value
                    : getCurrentMonthKey();
                const filteredMonths = selectedMonthKey
                    ? (months || []).filter(function (item) { return item.monthKey === selectedMonthKey; })
                    : (months || []);

                if (selectedMonthKey && filteredMonths.length === 0) {
                    scorecardMonthList.innerHTML = `
                        <button class="scorecard-month-button is-empty-month is-selected" type="button" data-empty-month="${escapeHtml(selectedMonthKey)}">
                            <span class="scorecard-month-button-title">${escapeHtml(formatMonthKeyLabel(selectedMonthKey))}</span>
                            <span class="scorecard-month-button-tags">No scorecard data yet</span>
                        </button>
                    `;
                    return;
                }

                if (!filteredMonths.length) {
                    scorecardMonthList.innerHTML = '<div class="scorecard-month-empty">No monthly scorecards available.</div>';
                    return;
                }

                scorecardMonthList.innerHTML = filteredMonths.map(function (item) {
                    const tags = [];
                    if (item.hasQaData) tags.push('QA');
                    if (item.hasAhtData) tags.push('AHT');
                    if (item.hasAcwData) tags.push('ACW');

                    return `
                        <button class="scorecard-month-button${item.monthKey === getCurrentMonthKey() ? ' is-current' : ''}${item.monthKey === selectedMonthKey ? ' is-selected' : ''}" type="button" data-month-scorecard='${escapeHtml(JSON.stringify(item))}'>
                            <span class="scorecard-month-button-title">${escapeHtml(item.monthLabel)}</span>
                            <span class="scorecard-month-button-tags">${escapeHtml(tags.length ? tags.join(' • ') : 'No data')}</span>
                        </button>
                    `;
                }).join('');
            }

            function formatMonthKeyLabel(monthKey) {
                if (!monthKey || !/^\d{4}-\d{2}$/.test(monthKey)) {
                    return 'Selected month';
                }

                const parts = monthKey.split('-');
                const year = Number(parts[0]);
                const monthIndex = Number(parts[1]) - 1;
                const date = new Date(year, monthIndex, 1);
                return date.toLocaleDateString(undefined, { month: 'long', year: 'numeric' });
            }

            function buildEmptyScorecard(monthKey) {
                return {
                    monthKey: monthKey,
                    monthLabel: formatMonthKeyLabel(monthKey),
                    qaScoreLabel: 'No data',
                    qaRankLabel: 'Rank: Not ranked yet',
                    ahtSeconds: 0,
                    ahtLabel: 'No data',
                    ahtRankLabel: 'Rank: Not ranked yet',
                    acwSeconds: 0,
                    acwLabel: 'No data',
                    lastUpdatedLabel: 'No updates yet',
                    hasQaData: false,
                    hasAhtData: false,
                    hasAcwData: false
                };
            }

            function openScorecardModal(scorecard) {
                if (!scorecardModal || !scorecard) {
                    return;
                }

                currentScorecard = scorecard;
                syncBodyModalState(true);
                scorecardModalTitle.textContent = 'Scorecard';
                scorecardModalMonth.textContent = scorecard.monthLabel || 'Month';
                scorecardModalQa.textContent = scorecard.qaScoreLabel || 'No data';
                scorecardModalQaRank.textContent = scorecard.qaRankLabel || 'Rank: Not ranked yet';
                scorecardModalAht.innerHTML = scorecard.hasAhtData ? renderMinuteClock(scorecard.ahtSeconds) : 'No data';
                scorecardModalAhtRank.textContent = scorecard.ahtRankLabel || 'Rank: Not ranked yet';
                scorecardModalAcw.innerHTML = scorecard.hasAcwData ? renderMinuteClock(scorecard.acwSeconds) : 'No data';
                scorecardModalUpdated.textContent = 'Last Update: ' + (scorecard.lastUpdatedLabel || 'No updates yet');
                scorecardModal.classList.add('is-open');
                scorecardModal.setAttribute('aria-hidden', 'false');
            }

            function closeScorecardModal() {
                if (!scorecardModal) {
                    return;
                }

                scorecardModal.classList.remove('is-open');
                scorecardModal.setAttribute('aria-hidden', 'true');
                currentScorecard = null;
                syncBodyModalState();
            }

            function renderRows(items) {
                ratedList.innerHTML = '';

                items.forEach(item => {
                    const isAcwTab = currentTab === 'acw';
                    const metricText = currentTab === 'qa'
                        ? item.overallPercent.toFixed(1) + ' / 100'
                        : isAcwTab
                            ? item.acwLabel
                            : item.handlingLabel;
                    const rowDate = isAcwTab ? item.acwEndDate : item.ratedAtDate;
                    const rowSubline = isAcwTab
                        ? `${item.isRated ? `QA <strong>${escapeHtml(item.reviewerName)}</strong>` : `<strong>${escapeHtml(item.ratingLabel || 'Not rated yet')}</strong>`} &middot; <strong>${escapeHtml(item.category)}</strong> &middot; ${escapeHtml(item.chatStatus)} &middot; ACW ${escapeHtml(item.acwStartLabel)} - ${escapeHtml(item.acwEndLabel)}`
                        : `QA <strong>${escapeHtml(item.reviewerName)}</strong> on ${escapeHtml(item.ratedAtLabel)} &middot; <strong>${escapeHtml(item.categorySummaryLabel || 'No category scores recorded')}</strong>`;
                    const rowName = `Ticket #${escapeHtml(item.supportFaqId)} - Agent: ${escapeHtml(item.agentName)} &middot; Concern from: ${escapeHtml(item.concernSourceLabel)}`;
                    const canViewDetails = !isAcwTab || !!item.canViewDetails;
                    const viewButtonAttr = canViewDetails ? '' : 'disabled title="No QA review yet"';

                    const row = document.createElement('div');
                    row.className = 'row';
                    row.dataset.date = rowDate || '';
                    row.dataset.score = item.overallPercent.toFixed(1);
                    row.dataset.search = item.searchText;
                    row.dataset.isRated = isAcwTab ? String(!!item.isRated) : 'true';
                    row.dataset.ticket = JSON.stringify(item);
                    row.innerHTML = `
                            <div>
                                <div class="name">${rowName}</div>
                                <div class="sub">${rowSubline}</div>
                            </div>
                            <div class="score"><strong class="row-metric">${escapeHtml(metricText)}</strong></div>
                            <button class="btn view-ticket-btn" type="button" ${viewButtonAttr}>View</button>
                        `;

                    ratedList.appendChild(row);
                });
            }

            function paginateItems(items, page) {
                const totalPages = Math.max(1, Math.ceil(items.length / pageSize));
                const safePage = Math.min(Math.max(1, page), totalPages);
                const start = (safePage - 1) * pageSize;
                return {
                    items: items.slice(start, start + pageSize),
                    page: safePage,
                    totalPages: items.length === 0 ? 0 : totalPages
                };
            }

            function buildPaginationHtml(totalPages, currentPage, clickHandlerName) {
                if (totalPages <= 1) {
                    return '';
                }

                let numberButtons = '';
                for (let page = 1; page <= totalPages; page++) {
                    numberButtons += `<button class="pagination-btn${page === currentPage ? ' is-active' : ''}" type="button" onclick="${clickHandlerName}(${page})">${page}</button>`;
                }

                return `
                    <div class="pagination-controls">
                        ${numberButtons}
                        <button class="pagination-btn pagination-next-btn" type="button" onclick="${clickHandlerName}(${currentPage + 1})" ${currentPage >= totalPages ? 'disabled' : ''}>Next page</button>
                    </div>
                `;
            }

            function getPaginationGroup(totalPages, currentPage, groupSize) {
                const safeGroupSize = Math.max(1, groupSize || 1);
                const safeCurrentPage = Math.min(Math.max(1, currentPage), totalPages);
                const groupIndex = Math.floor((safeCurrentPage - 1) / safeGroupSize);
                const startPage = (groupIndex * safeGroupSize) + 1;
                const endPage = Math.min(totalPages, startPage + safeGroupSize - 1);

                return {
                    startPage: startPage,
                    endPage: endPage,
                    previousGroupPage: Math.max(1, startPage - safeGroupSize),
                    nextGroupPage: Math.min(totalPages, endPage + 1),
                    hasPreviousGroup: startPage > 1,
                    hasNextGroup: endPage < totalPages
                };
            }

            function buildResolvedPaginationHtml(totalPages, currentPage, clickHandlerName) {
                if (totalPages <= 1) {
                    return '';
                }

                const group = getPaginationGroup(totalPages, currentPage, 3);
                let numberButtons = '';

                for (let page = group.startPage; page <= group.endPage; page++) {
                    numberButtons += `<button class="pagination-btn${page === currentPage ? ' is-active' : ''}" type="button" onclick="${clickHandlerName}(${page})">${page}</button>`;
                }

                const previousGroupButton = group.hasPreviousGroup
                    ? `<button class="pagination-btn pagination-next-btn" type="button" onclick="${clickHandlerName}(${group.previousGroupPage})">Previous pages</button>`
                    : '';
                const trailingEllipsis = group.hasNextGroup
                    ? '<span class="pagination-ellipsis" aria-hidden="true">...</span>'
                    : '';
                const nextGroupButton = group.hasNextGroup
                    ? `<button class="pagination-btn pagination-next-btn" type="button" onclick="${clickHandlerName}(${group.nextGroupPage})">Next page</button>`
                    : '';

                return `
                    <div class="pagination-controls">
                        ${previousGroupButton}
                        ${numberButtons}
                        ${trailingEllipsis}
                        ${nextGroupButton}
                    </div>
                `;
            }

            function renderRatedPagination(totalPages, currentPage) {
                if (!ratedPagination) {
                    return;
                }

                if (totalPages <= 1) {
                    ratedPagination.hidden = true;
                    ratedPagination.innerHTML = '';
                    return;
                }

                ratedPagination.hidden = false;
                ratedPagination.innerHTML = buildPaginationHtml(totalPages, currentPage, 'window.setRatedPage');
            }

            function applyFilters() {
                const query = (searchInput.value || '').toLowerCase().trim();
                const fromVal = fromDate.value || '';
                const toVal = toDate.value || '';
                const scoreVal = scoreFilter.value || '';
                const filteredItems = getCurrentRows().filter(item => {
                    const isAcwTab = currentTab === 'acw';
                    const searchText = (item.searchText || '').toLowerCase();
                    const rowDate = isAcwTab ? (item.acwEndDate || '') : (item.ratedAtDate || '');
                    const rowScore = Number.parseFloat(item.overallPercent || '0');
                    const isRatedRow = isAcwTab ? !!item.isRated : true;

                    const matchesSearch = !query || searchText.includes(query);
                    const matchesFrom = !fromVal || (rowDate && rowDate >= fromVal);
                    const matchesTo = !toVal || (rowDate && rowDate <= toVal);

                    let matchesScore = true;
                    if (currentTab === 'acw' && scoreVal && !isRatedRow) {
                        matchesScore = false;
                    } else if (scoreVal === 'high') matchesScore = rowScore >= 90 && rowScore <= 100;
                    else if (scoreVal === 'good') matchesScore = rowScore >= 80 && rowScore < 90;
                    else if (scoreVal === 'mid') matchesScore = rowScore >= 70 && rowScore < 80;
                    else if (scoreVal === 'low') matchesScore = rowScore < 70;

                    return matchesSearch && matchesFrom && matchesTo && matchesScore;
                });

                const pagination = paginateItems(filteredItems, currentMainPage);
                currentMainPage = pagination.page || 1;
                renderRows(pagination.items);
                renderRatedPagination(pagination.totalPages, currentMainPage);
                emptyState.style.display = filteredItems.length === 0 ? 'block' : 'none';
            }

            function renderResolvedRows(items) {
                resolvedTicketList.innerHTML = '';

                items.forEach(function (item) {
                    const row = document.createElement('div');
                    row.className = 'row resolved-row';
                    row.dataset.date = item.resolvedAtDate || '';
                    row.dataset.search = item.searchText || '';
                    row.dataset.ticket = JSON.stringify(item);
                    row.dataset.isReviewed = String(!!item.isReviewed);
                    row.setAttribute('data-is-reviewed', String(!!item.isReviewed));
                    row.dataset.isClickable = String(!!item.isReviewed);
                    row.tabIndex = item.isReviewed ? 0 : -1;
                    row.setAttribute('role', item.isReviewed ? 'button' : 'group');
                    row.setAttribute('aria-disabled', item.isReviewed ? 'false' : 'true');
                    row.innerHTML = `
                            <div>
                                <div class="name">Ticket #${escapeHtml(item.supportFaqId)} - Agent: ${escapeHtml(item.agentName)} &middot; Concern from: ${escapeHtml(item.concernSourceLabel)}</div>
                                <div class="sub">
                                    <span class="resolved-status-pill${item.isReviewed ? ' reviewed' : ' pending'}">${escapeHtml(item.reviewStateLabel)}</span>
                                    Resolved on ${escapeHtml(item.resolvedAtLabel)} &middot; QA ${escapeHtml(item.reviewerName)}
                                    ${item.isReviewed ? ` &middot; <strong>${escapeHtml(item.overallPercent.toFixed(1))} / 100</strong>` : ''}
                                </div>
                            </div>
                            <div class="score"><strong class="row-metric">${item.isReviewed ? escapeHtml(item.overallPercent.toFixed(1) + ' / 100') : 'Pending'}</strong></div>
                            <button class="btn view-resolved-ticket-btn" type="button">${item.isReviewed ? 'Open review' : 'Open ticket'}</button>
                        `;

                    resolvedTicketList.appendChild(row);
                });
            }

            function renderResolvedPagination(totalPages, currentPage) {
                if (!resolvedPagination) {
                    return;
                }

                if (totalPages <= 1) {
                    resolvedPagination.hidden = true;
                    resolvedPagination.innerHTML = '';
                    return;
                }

                resolvedPagination.hidden = false;
                resolvedPagination.innerHTML = buildResolvedPaginationHtml(totalPages, currentPage, 'window.setResolvedPage');
            }

            function applyResolvedFilters() {
                const query = (resolvedSearch.value || '').toLowerCase().trim();
                const fromVal = resolvedFromDate.value || '';
                const toVal = resolvedToDate.value || '';
                const filteredItems = ((dashboardData && dashboardData.resolvedTickets) || []).filter(function (item) {
                    const searchText = (item.searchText || '').toLowerCase();
                    const rowDate = item.resolvedAtDate || '';
                    const matchesSearch = !query || searchText.includes(query);
                    const matchesFrom = !fromVal || (rowDate && rowDate >= fromVal);
                    const matchesTo = !toVal || (rowDate && rowDate <= toVal);

                    return matchesSearch && matchesFrom && matchesTo;
                });

                const visibleCount = filteredItems.length;
                const reviewedCount = filteredItems.filter(function (item) { return !!item.isReviewed; }).length;
                const pendingCount = visibleCount - reviewedCount;
                const pagination = paginateItems(filteredItems, currentResolvedPage);
                currentResolvedPage = pagination.page || 1;

                renderResolvedRows(pagination.items);
                renderResolvedPagination(pagination.totalPages, currentResolvedPage);

                resolvedModalCount.textContent = `${visibleCount} ticket${visibleCount === 1 ? '' : 's'}`;
                resolvedSummaryTotal.textContent = String(visibleCount);
                resolvedSummaryReviewed.textContent = String(reviewedCount);
                resolvedSummaryPending.textContent = String(pendingCount);
                resolvedTicketEmpty.style.display = visibleCount === 0 ? 'block' : 'none';
            }

            function openResolvedTicketsModal() {
                if (!resolvedTicketsModal) {
                    return;
                }

                syncBodyModalState(true);
                if (!dashboardData) {
                    resolvedTicketList.innerHTML = '<div class="modal-state">Loading resolved tickets...</div>';
                    if (resolvedTicketEmpty) {
                        resolvedTicketEmpty.style.display = 'none';
                    }
                    resolvedTicketsModal.hidden = false;
                    resolvedTicketsModal.classList.add('is-open');
                    resolvedTicketsModal.setAttribute('aria-hidden', 'false');
                    loadDashboard();
                    return;
                }

                renderResolvedRows(dashboardData.resolvedTickets || []);
                applyResolvedFilters();
                resolvedTicketsModal.hidden = false;
                resolvedTicketsModal.classList.add('is-open');
                resolvedTicketsModal.setAttribute('aria-hidden', 'false');
            }

            function closeResolvedTicketsModal() {
                if (!resolvedTicketsModal) {
                    return;
                }

                resolvedTicketsModal.classList.remove('is-open');
                resolvedTicketsModal.setAttribute('aria-hidden', 'true');
                resolvedTicketsModal.hidden = true;
                syncBodyModalState();
            }

            function setResolvedRowLoading(row, isLoading) {
                if (!row) {
                    return;
                }

                row.classList.toggle('is-loading', isLoading);
                const actionButton = row.querySelector('.view-resolved-ticket-btn');
                if (actionButton) {
                    actionButton.disabled = isLoading;
                    actionButton.textContent = isLoading ? 'Loading...' : 'Open';
                }
            }

            function openResolvedTicketFromRow(row) {
                if (!row || !row.dataset.ticket) {
                    return;
                }

                setResolvedRowLoading(row, true);
                row.classList.add('is-opening');
                closeResolvedTicketsModal();
                window.setTimeout(function () {
                    openModal(JSON.parse(row.dataset.ticket)).finally(function () {
                        row.classList.remove('is-opening');
                        setResolvedRowLoading(row, false);
                    });
                }, 140);
            }

            function resetModalState() {
                currentDetail = null;
                document.getElementById('modal-convo-summary').textContent = 'Loading review...';
                document.getElementById('modal-convo-body').innerHTML = '<div class="modal-state">Loading review details...</div>';
                document.getElementById('modal-overall').innerHTML = '<strong>0.0 / 100</strong>';
                document.getElementById('modal-reviewed-by').textContent = 'QA: QA Reviewer';
                document.getElementById('modal-qa-notes').textContent = 'No QA notes were recorded for this review.';
                document.getElementById('modal-rating-summary').innerHTML = `
                    <div class="summary-card summary-card-compact">
                        <div class="summary-label">Category score</div>
                        <div class="summary-value"><strong>0.0 / 100</strong></div>
                    </div>
                `;
                modalAgentNotes.value = '';
                modalAgentNotes.disabled = true;
                modalSaveNotesBtn.disabled = true;
                modalAcknowledgeBtn.disabled = true;
                modalSaveNotesBtn.hidden = false;
                modalAcknowledgeBtn.hidden = false;
                modalViewRatingBtn.hidden = false;
                if (modalReviewBadge) {
                    modalReviewBadge.textContent = 'Loading';
                    modalReviewBadge.className = 'rated-badge';
                }
                setRatingVisibility(false);
                hideFeedbackStatus();
            }

            function showFeedbackStatus(message, type) {
                modalFeedbackStatus.textContent = message;
                modalFeedbackStatus.className = 'modal-feedback-status ' + (type || 'info');
                modalFeedbackStatus.hidden = false;
            }

            function hideFeedbackStatus() {
                modalFeedbackStatus.hidden = true;
                modalFeedbackStatus.textContent = '';
                modalFeedbackStatus.className = 'modal-feedback-status';
            }

            function setRatingVisibility(isVisible) {
                const sectionIds = [
                    'modal-rating-summary',
                    'modal-rating-overall',
                    'modal-rating-meta',
                    'modal-rating-notes-wrap',
                    'modal-rating-breakdown'
                ];

                sectionIds.forEach(id => {
                    const node = document.getElementById(id);
                    if (node) {
                        node.hidden = !isVisible;
                    }
                });

                modalViewRatingBtn.textContent = isVisible ? 'Hide rating' : 'View rating';
            }

            function setButtonBusy(button, isBusy, busyText) {
                if (!button) return;

                if (isBusy) {
                    button.dataset.originalText = button.textContent || '';
                    button.disabled = true;
                    button.textContent = busyText;
                    return;
                }

                button.disabled = false;
                if (button.dataset.originalText) {
                    button.textContent = button.dataset.originalText;
                }
            }

            function renderInlineComments(inlineComments) {
                if (!inlineComments || !inlineComments.length) return '';

                const entries = inlineComments.map(comment => {
                    const images = comment.images && comment.images.length
                        ? `<span class="msg-comment-images">Images: ${escapeHtml(comment.images.join(', '))}</span>`
                        : '';

                    return `
                            <div class="msg-comment-entry">
                                <div class="msg-comment-meta">${escapeHtml(comment.by)}${comment.on ? ' - ' + escapeHtml(comment.on) : ''}</div>
                                <div>${escapeWithBreaks(comment.comment)}</div>
                                ${images}
                            </div>
                        `;
                }).join('');

                return `<div class="msg-comment-thread">${entries}</div>`;
            }

            function renderConversation(messages) {
                if (!messages || !messages.length) {
                    return '<div class="modal-state">No conversation messages were recorded for this ticket.</div>';
                }

                return messages.map(message => {
                    const hasInlineComment = message.inlineComments && message.inlineComments.length > 0;
                    const inlineThread = renderInlineComments(message.inlineComments || []);
                    return `
                            <div class="msg ${escapeHtml(message.senderCssClass)}${hasInlineComment ? ' has-inline-comment' : ''}">
                                <div>${escapeWithBreaks(message.messageText)}</div>
                                ${inlineThread}
                                <span class="msg-meta"><span class="msg-sender">${escapeHtml(message.senderDisplayName)}</span> &middot; <span class="msg-time">${escapeHtml(message.timestampLabel)}</span></span>
                            </div>
                        `;
                }).join('');
            }

            function renderBreakdown(questionScores) {
                const groupedMap = new Map();

                (questionScores || []).forEach(score => {
                    const categoryKey = score.categoryKey || 'detailed-scoring';
                    if (!groupedMap.has(categoryKey)) {
                        groupedMap.set(categoryKey, {
                            key: categoryKey,
                            title: score.categoryTitle || 'Detailed Scoring',
                            weight: Number.isFinite(score.categoryWeightPercent) && score.categoryWeightPercent > 0
                                ? score.categoryWeightPercent.toFixed(0) + '%'
                                : '',
                            order: Number.isFinite(score.categoryDisplayOrder) ? score.categoryDisplayOrder : 999,
                            items: []
                        });
                    }

                    groupedMap.get(categoryKey).items.push(score);
                });

                const groups = Array.from(groupedMap.values())
                    .sort(function (left, right) {
                        if (left.order !== right.order) return left.order - right.order;
                        return left.title.localeCompare(right.title);
                    });

                if (!groups.length) {
                    return `
                            <section class="category-block">
                                <div class="category-head">
                                    <div class="category-title">Detailed Scoring</div>
                                </div>
                                <div class="question-grid"><div class="question-text">No detailed question scores were recorded.</div></div>
                            </section>
                        `;
                }

                const html = groups.map(group => {
                    const items = (group.items || []).slice().sort(function (left, right) {
                        if (left.questionDisplayOrder !== right.questionDisplayOrder) {
                            return left.questionDisplayOrder - right.questionDisplayOrder;
                        }

                        return (left.questionText || left.questionKey || '').localeCompare(right.questionText || right.questionKey || '');
                    });
                    const rows = items.map(score => {
                        const isScored = score.score >= 1 && score.score <= 5;
                        const options = [1, 2, 3, 4, 5].map(value => `
                                <label class="score-radio-option">
                                    <input type="radio" disabled ${isScored && score.score === value ? 'checked' : ''} />
                                    <span>${value}</span>
                                </label>
                            `).join('');
                        const scoreState = isScored
                            ? `<div class="question-score-caption">Selected score: ${escapeHtml(String(score.score))} / 5</div>`
                            : '<div class="question-score-caption">Not scored</div>';

                        return `
                                <div class="question-row">
                                    <div class="question-text">${escapeHtml(score.questionText || score.questionKey || 'Question')}</div>
                                    <div class="score-radio-group">${options}</div>
                                    ${scoreState}
                                </div>
                            `;
                    }).join('');
                    const title = group.weight
                        ? `${group.title} (${group.weight})`
                        : group.title;

                    return `
                            <section class="category-block">
                                <div class="category-head">
                                    <div class="category-title">${escapeHtml(title)}</div>
                                </div>
                                <div class="question-grid">${rows || '<div class="question-text">No detailed question scores were recorded.</div>'}</div>
                            </section>
                        `;
                }).join('');

                return html;
            }

            function buildModalSummaryCards(detail) {
                const groups = Array.from(detail.categoryCards || [])
                    .sort(function (left, right) {
                        if (left.displayOrder !== right.displayOrder) return left.displayOrder - right.displayOrder;
                        return (left.categoryTitle || '').localeCompare(right.categoryTitle || '');
                    });

                if (groups.length) {
                    return groups.map(group => {
                        const weightPercent = Number.isFinite(group.weightPercent) ? group.weightPercent : 0;
                        const scorePoints = Number.isFinite(group.scorePoints) ? group.scorePoints : 0;
                        const label = weightPercent > 0
                            ? `${group.categoryTitle} (${weightPercent.toFixed(0)}%)`
                            : group.categoryTitle;
                        const denominator = weightPercent > 0
                            ? weightPercent.toFixed(0)
                            : '0';

                        return `
                                <div class="summary-card summary-card-compact">
                                    <div class="summary-label">${escapeHtml(label)}</div>
                                    <div class="summary-value"><strong>${scorePoints.toFixed(1)} / ${escapeHtml(denominator)}</strong></div>
                                </div>
                            `;
                    }).join('');
                }

                return `
                        <div class="summary-card summary-card-compact">
                            <div class="summary-label">Category score</div>
                            <div class="summary-value"><strong>${detail.overallPercent.toFixed(1)} / 100</strong></div>
                        </div>
                    `;
            }

            function renderModal(detail, summaryItem, options) {
                const preserveAgentNotes = !!(options && options.preserveAgentNotes);
                const preservedAgentNotes = preserveAgentNotes ? modalAgentNotes.value : null;
                const preservedFeedbackStatus = preserveAgentNotes && !modalFeedbackStatus.hidden
                    ? {
                        text: modalFeedbackStatus.textContent || '',
                        className: modalFeedbackStatus.className || 'modal-feedback-status'
                    }
                    : null;

                currentDetail = detail;
                document.getElementById('modal-convo-summary').textContent = 'Agent: ' + detail.agentName + ' - Ticket #' + detail.supportFaqId + ' - Concern from: ' + detail.concernSourceLabel;
                document.getElementById('modal-convo-body').innerHTML = renderConversation(detail.messages || []);
                document.getElementById('modal-rating-summary').innerHTML = buildModalSummaryCards(detail);
                document.getElementById('modal-reviewed-by').textContent = detail.isReviewed ? 'QA: ' + detail.reviewerName : detail.reviewStateLabel;
                document.getElementById('modal-qa-notes').innerHTML = escapeWithBreaks(detail.qaNotes);
                document.getElementById('modal-rating-breakdown').innerHTML = renderBreakdown(detail.questionScores || []);
                modalAgentNotes.value = detail.agentNotes || '';
                modalAgentNotes.disabled = !detail.isReviewed;
                modalSaveNotesBtn.disabled = !detail.isReviewed;
                modalAcknowledgeBtn.disabled = !detail.isReviewed;
                modalSaveNotesBtn.hidden = !detail.isReviewed;
                modalAcknowledgeBtn.hidden = !detail.isReviewed;
                modalViewRatingBtn.hidden = !detail.isReviewed;
                modalAcknowledgeBtn.textContent = detail.isAcknowledged ? 'Acknowledged' : 'Acknowledge';
                if (detail.isReviewed && detail.isAcknowledged) {
                    modalAcknowledgeBtn.disabled = true;
                }
                if (modalReviewBadge) {
                    modalReviewBadge.textContent = detail.isReviewed
                        ? detail.reviewStateLabel + ' • ' + detail.overallPercent.toFixed(1) + ' / 100'
                        : detail.reviewStateLabel;
                    modalReviewBadge.className = detail.isReviewed ? 'rated-badge' : 'rated-badge pending';
                }

                if (!detail.isReviewed) {
                    document.getElementById('modal-overall').innerHTML = '<strong>Pending QA review</strong>';
                    setRatingVisibility(false);
                } else {
                    document.getElementById('modal-overall').innerHTML = '<strong>' + detail.overallPercent.toFixed(1) + ' / 100</strong>';
                }

                if (preserveAgentNotes && preservedAgentNotes !== null) {
                    modalAgentNotes.value = preservedAgentNotes;
                    currentDetail.agentNotes = preservedAgentNotes;
                    modalAgentNotes.disabled = !detail.isReviewed;
                    modalSaveNotesBtn.disabled = !detail.isReviewed;
                    if (preservedFeedbackStatus && preservedFeedbackStatus.text) {
                        modalFeedbackStatus.textContent = preservedFeedbackStatus.text;
                        modalFeedbackStatus.className = preservedFeedbackStatus.className;
                        modalFeedbackStatus.hidden = false;
                    }
                } else {
                    modalNotesDirty = false;
                }
            }

            function getCurrentRows() {
                if (!dashboardData) return [];
                if (currentTab === 'acw') {
                    return dashboardData.acwRecords || [];
                }

                return dashboardData.ratedTickets || [];
            }

            window.setRatedPage = function (page) {
                currentMainPage = page;
                applyFilters();
            };

            window.setResolvedPage = function (page) {
                currentResolvedPage = page;
                applyResolvedFilters();
            };

            function renderModalError(message) {
                document.getElementById('modal-convo-summary').textContent = 'Unable to load ticket';
                document.getElementById('modal-convo-body').innerHTML = '<div class="modal-state">' + escapeHtml(message) + '</div>';
                document.getElementById('modal-qa-notes').textContent = 'Ticket details are unavailable.';
            }

            async function fetchTicketDetail(supportFaqId, options) {
                const forceRefresh = !!(options && options.forceRefresh);

                if (!forceRefresh && detailCache.has(supportFaqId)) {
                    return detailCache.get(supportFaqId);
                }

                const response = await fetch(ticketDetailEndpointBase + supportFaqId, {
                    headers: { 'Accept': 'application/json' }
                });

                if (!response.ok) {
                    throw new Error(response.status === 404
                        ? 'No ticket detail was found for this ticket.'
                        : 'Ticket detail request failed with status ' + response.status);
                }

                const payload = await response.json();
                detailCache.set(supportFaqId, payload);
                return payload;
            }

            async function postJson(url, payload) {
                const response = await fetch(url, {
                    method: 'POST',
                    headers: {
                        'Accept': 'application/json',
                        'Content-Type': 'application/json'
                    },
                    body: payload ? JSON.stringify(payload) : null
                });

                const result = await response.json().catch(function () {
                    return { success: false, message: 'Request failed.' };
                });

                if (!response.ok || !result.success) {
                    throw new Error(result.message || 'Request failed.');
                }

                return result;
            }

            async function openModal(item, options) {
                const openedFromNotification = !!(options && options.fromNotification);
                if (typeof window.showGlobalNhLoading === 'function') {
                    window.showGlobalNhLoading();
                }
                resetModalState();
                modalNotesDirty = false;
                syncBodyModalState(true);
                qaModal.classList.toggle('from-notification', openedFromNotification);
                qaModal.classList.add('is-open');
                qaModal.setAttribute('aria-hidden', 'false');

                try {
                    const detail = await fetchTicketDetail(item.supportFaqId);
                    renderModal(detail, item);
                } catch (error) {
                    renderModalError(error && error.message ? error.message : 'Unable to load review details.');
                    console.error(error);
                } finally {
                    if (typeof window.hideGlobalNhLoading === 'function') {
                        window.hideGlobalNhLoading();
                    }
                }
            }

            function closeModal() {
                qaModal.classList.remove('is-open');
                qaModal.classList.remove('from-notification');
                qaModal.setAttribute('aria-hidden', 'true');
                syncBodyModalState();
            }

            function syncBodyModalState(forceOpen) {
                const hasOpenModal = forceOpen || document.querySelector('.qa-modal-overlay.is-open, .resolved-modal-overlay.is-open, .scorecard-modal-overlay.is-open');
                document.body.classList.toggle('modal-open', !!hasOpenModal);
            }

            async function openTicketFromQueryParam() {
                if (hasOpenedTicketFromQueryParam) {
                    return;
                }

                const parsedTicketId = Number.parseInt(initialTicketIdParam || '', 10);
                if (!Number.isInteger(parsedTicketId) || parsedTicketId <= 0) {
                    hasOpenedTicketFromQueryParam = true;
                    return;
                }

                const summaryItem = (dashboardData && dashboardData.ratedTickets || []).find(function (item) {
                    return item.supportFaqId === parsedTicketId;
                }) || (dashboardData && dashboardData.resolvedTickets || []).find(function (item) {
                    return item.supportFaqId === parsedTicketId;
                }) || { supportFaqId: parsedTicketId };

                try {
                    await openModal(summaryItem, { fromNotification: true });
                } finally {
                    hasOpenedTicketFromQueryParam = true;
                    const url = new URL(window.location.href);
                    url.searchParams.delete('ticketId');
                    window.history.replaceState({}, document.title, url.pathname + url.search + url.hash);
                }
            }

            async function refreshCurrentDetail() {
                if (!currentDetail || !qaModal || !qaModal.classList.contains('is-open')) {
                    return;
                }

                try {
                    const preserveAgentNotes = modalNotesDirty && document.activeElement === modalAgentNotes;
                    const matchedSummary = getCurrentRows().find(function (item) {
                        return item.supportFaqId === currentDetail.supportFaqId;
                    }) || ((dashboardData && dashboardData.resolvedTickets) || []).find(function (item) {
                        return item.supportFaqId === currentDetail.supportFaqId;
                    }) || null;
                    const detail = await fetchTicketDetail(currentDetail.supportFaqId, { forceRefresh: true });
                    renderModal(detail, matchedSummary, { preserveAgentNotes: preserveAgentNotes });
                } catch (error) {
                    console.error(error);
                }
            }

            function syncOpenScorecard() {
                if (!currentScorecard || !scorecardModal || !scorecardModal.classList.contains('is-open') || !dashboardData) {
                    return;
                }

                const monthKey = currentScorecard.monthKey || (scorecardMonthFilter ? scorecardMonthFilter.value : '');
                const nextScorecard = findScorecardByMonthKey(dashboardData.monthScorecards || [], monthKey)
                    || buildEmptyScorecard(monthKey || getCurrentMonthKey());
                openScorecardModal(nextScorecard);
            }

            async function loadDashboard(options) {
                const silent = !!(options && options.silent);
                if (isDashboardLoading) {
                    return;
                }

                isDashboardLoading = true;
                try {
                    if (!silent) {
                        loadingState.style.display = 'block';
                    }

                    const response = await fetch(dashboardEndpoint, {
                        headers: { 'Accept': 'application/json' }
                    });

                    if (!response.ok) {
                        throw new Error('Dashboard request failed with status ' + response.status);
                    }

                    dashboardData = await response.json();
                    if (scorecardMonthFilter && !scorecardMonthFilter.value) {
                        const defaultMonthKey = dashboardData.monthScorecards && dashboardData.monthScorecards.length
                            ? dashboardData.monthScorecards[0].monthKey
                            : getCurrentMonthKey();
                        setSelectedScorecardMonth(defaultMonthKey, { openModal: false });
                    }
                    setMetricText('qa-score-metric', dashboardData.qaScoreLabel);
                    setClockMetricHtml('aht-metric', dashboardData.averageHandlingSeconds);
                    setMetricText('qa-score-update', 'Last Update: ' + dashboardData.lastUpdatedLabel);
                    setMetricText('qa-score-reviewed', dashboardData.qaReviewedResolvedLabel || '0/0 reviewed this month');
                    setMetricText('qa-score-rank', dashboardData.qaRankLabel || 'Rank: Not ranked yet');
                    setMetricText('aht-update', 'Last Update: ' + dashboardData.lastUpdatedLabel);
                    setMetricText('aht-rank', dashboardData.ahtRankLabel || 'Rank: Not ranked yet');
                    setClockMetricHtml('acw-metric', dashboardData.averageAcwSeconds);
                    renderScorecardMonths(dashboardData.monthScorecards || []);
                    syncOpenScorecard();

                    renderRows(getCurrentRows());
                    if (resolvedTicketsModal && resolvedTicketsModal.classList.contains('is-open')) {
                        applyResolvedFilters();
                    }
                    loadingState.style.display = 'none';
                    applyFilters();
                    await refreshCurrentDetail();
                    await openTicketFromQueryParam();
                } catch (error) {
                    if (!silent) {
                        setClockMetricHtml('aht-metric', 0);
                        setClockMetricHtml('acw-metric', 0);
                        setMetricText('qa-score-reviewed', '0/0 reviewed this month');
                        setMetricText('qa-score-rank', 'Rank: Not ranked yet');
                        setMetricText('aht-rank', 'Rank: Not ranked yet');
                        renderScorecardMonths([]);
                        loadingState.textContent = 'Unable to load dashboard data.';
                    }
                    console.error(error);
                } finally {
                    isDashboardLoading = false;
                }
            }

            function startDashboardAutoRefresh() {
                if (dashboardRefreshTimerId) {
                    window.clearInterval(dashboardRefreshTimerId);
                }

                dashboardRefreshTimerId = window.setInterval(function () {
                    if (document.hidden) {
                        return;
                    }

                    loadDashboard({ silent: true });
                }, dashboardRefreshIntervalMs);
            }

            tabs.forEach(tab => {
                tab.addEventListener('click', function () {
                    switchDashboardTab(tab.dataset.tab);
                });
            });

            quickRange.addEventListener('change', function () {
                currentMainPage = 1;
                if (quickRange.value === 'custom') {
                    fromDate.value = '';
                    toDate.value = '';
                } else {
                    applyQuickRange();
                }
                applyFilters();
            });

            fromDate.addEventListener('change', function () {
                currentMainPage = 1;
                quickRange.value = 'custom';
                applyFilters();
            });

            toDate.addEventListener('change', function () {
                currentMainPage = 1;
                quickRange.value = 'custom';
                applyFilters();
            });

            searchInput.addEventListener('input', function () {
                currentMainPage = 1;
                applyFilters();
            });
            scoreFilter.addEventListener('change', function () {
                currentMainPage = 1;
                applyFilters();
            });
            resolvedTicketsTrigger.addEventListener('click', openResolvedTicketsModal);
            resolvedModalClose.addEventListener('click', closeResolvedTicketsModal);
            resolvedQuickRange.addEventListener('change', function () {
                currentResolvedPage = 1;
                if (resolvedQuickRange.value === 'custom') {
                    resolvedFromDate.value = '';
                    resolvedToDate.value = '';
                } else {
                    applyResolvedQuickRange();
                }
                applyResolvedFilters();
            });
            resolvedFromDate.addEventListener('change', function () {
                currentResolvedPage = 1;
                resolvedQuickRange.value = 'custom';
                applyResolvedFilters();
            });
            resolvedToDate.addEventListener('change', function () {
                currentResolvedPage = 1;
                resolvedQuickRange.value = 'custom';
                applyResolvedFilters();
            });
            resolvedSearch.addEventListener('input', function () {
                currentResolvedPage = 1;
                applyResolvedFilters();
            });
            scorecardMonthFilter.addEventListener('change', function () {
                setSelectedScorecardMonth(scorecardMonthFilter.value);
            });
            scorecardMonthList.addEventListener('click', function (event) {
                const button = event.target.closest('.scorecard-month-button');
                if (!button) return;

                if (button.dataset.emptyMonth) {
                    setSelectedScorecardMonth(button.dataset.emptyMonth);
                    return;
                }

                if (!button.dataset.monthScorecard) return;

                try {
                    const scorecard = JSON.parse(button.dataset.monthScorecard);
                    setSelectedScorecardMonth(scorecard.monthKey);
                } catch (error) {
                    console.error(error);
                }
            });
            ratedList.addEventListener('click', function (event) {
                const button = event.target.closest('.view-ticket-btn');
                if (!button) return;
                if (button.disabled) return;
                const row = button.closest('.row');
                if (!row || !row.dataset.ticket) return;
                if (currentTab === 'acw' && row.dataset.isRated !== 'true') return;
                row.classList.add('is-opening');
                window.setTimeout(function () {
                    openModal(JSON.parse(row.dataset.ticket)).finally(function () {
                        row.classList.remove('is-opening');
                    });
                }, 140);
            });
            resolvedTicketList.addEventListener('click', function (event) {
                const row = event.target.closest('.resolved-row');
                if (!row) return;

                const button = event.target.closest('.view-resolved-ticket-btn');
                if (button && button.disabled) return;
                openResolvedTicketFromRow(row);
            });
            resolvedTicketList.addEventListener('keydown', function (event) {
                if (event.key !== 'Enter' && event.key !== ' ') return;
                const row = event.target.closest('.resolved-row');
                if (!row) return;
                event.preventDefault();
                openResolvedTicketFromRow(row);
            });

            closeQaModal.addEventListener('click', closeModal);
            modalCloseBtn.addEventListener('click', closeModal);
            scorecardModalClose.addEventListener('click', closeScorecardModal);
            modalViewRatingBtn.addEventListener('click', function () {
                const summary = document.getElementById('modal-rating-summary');
                const isCurrentlyVisible = summary ? !summary.hidden : false;
                setRatingVisibility(!isCurrentlyVisible);
            });
            modalSaveNotesBtn.addEventListener('click', async function () {
                if (!currentDetail) return;

                hideFeedbackStatus();
                setButtonBusy(modalSaveNotesBtn, true, 'Saving...');
                modalAgentNotes.disabled = true;

                try {
                    if (typeof window.showGlobalNhLoading === 'function') {
                        window.showGlobalNhLoading();
                    }
                    const result = await postJson(ticketDetailEndpointBase + currentDetail.supportFaqId + '/notes', {
                        notes: modalAgentNotes.value || ''
                    });

                    currentDetail.agentNotes = result.agentNotes || '';
                    currentDetail.isAcknowledged = result.isAcknowledged;
                    currentDetail.acknowledgedLabel = result.acknowledgedLabel || 'Not acknowledged';
                    modalAgentNotes.value = currentDetail.agentNotes;
                    modalNotesDirty = false;
                    showFeedbackStatus(result.message || 'Agent notes saved.', 'success');

                    detailCache.set(currentDetail.supportFaqId, currentDetail);
                    await loadDashboard({ silent: true });
                } catch (error) {
                    showFeedbackStatus(error && error.message ? error.message : 'Unable to save agent notes.', 'error');
                } finally {
                    modalAgentNotes.disabled = false;
                    setButtonBusy(modalSaveNotesBtn, false);
                    if (typeof window.hideGlobalNhLoading === 'function') {
                        window.hideGlobalNhLoading();
                    }
                    if (currentDetail && currentDetail.isAcknowledged) {
                        modalAcknowledgeBtn.textContent = 'Acknowledged';
                        modalAcknowledgeBtn.disabled = true;
                    }
                }
            });
            modalAcknowledgeBtn.addEventListener('click', async function () {
                if (!currentDetail || currentDetail.isAcknowledged) return;

                hideFeedbackStatus();
                setButtonBusy(modalAcknowledgeBtn, true, 'Saving...');

                try {
                    if (typeof window.showGlobalNhLoading === 'function') {
                        window.showGlobalNhLoading();
                    }
                    const result = await postJson(ticketDetailEndpointBase + currentDetail.supportFaqId + '/acknowledge');
                    currentDetail.agentNotes = result.agentNotes || currentDetail.agentNotes || '';
                    currentDetail.isAcknowledged = result.isAcknowledged;
                    currentDetail.acknowledgedLabel = result.acknowledgedLabel || 'Acknowledged';
                    modalAgentNotes.value = currentDetail.agentNotes || '';
                    modalNotesDirty = false;
                    showFeedbackStatus(result.message || 'QA review acknowledged.', 'success');

                    detailCache.set(currentDetail.supportFaqId, currentDetail);
                    await loadDashboard({ silent: true });
                } catch (error) {
                    showFeedbackStatus(error && error.message ? error.message : 'Unable to acknowledge this QA review.', 'error');
                } finally {
                    setButtonBusy(modalAcknowledgeBtn, false);
                    if (typeof window.hideGlobalNhLoading === 'function') {
                        window.hideGlobalNhLoading();
                    }
                    if (currentDetail && currentDetail.isAcknowledged) {
                        modalAcknowledgeBtn.textContent = 'Acknowledged';
                        modalAcknowledgeBtn.disabled = true;
                    }
                }
            });
            qaModal.addEventListener('click', function (event) {
                if (event.target === qaModal) closeModal();
            });
            resolvedTicketsModal.addEventListener('click', function (event) {
                if (event.target === resolvedTicketsModal) closeResolvedTicketsModal();
            });
            scorecardModal.addEventListener('click', function (event) {
                if (event.target === scorecardModal) closeScorecardModal();
            });
            window.addEventListener('keydown', function (event) {
                if (event.key === 'Escape') {
                    closeModal();
                    closeResolvedTicketsModal();
                    closeScorecardModal();
                }
            });
            window.addEventListener('focus', function () {
                loadDashboard({ silent: true });
            });
            document.addEventListener('visibilitychange', function () {
                if (!document.hidden) {
                    loadDashboard({ silent: true });
                }
            });
            modalAgentNotes.addEventListener('input', function () {
                modalNotesDirty = true;
            });

            setSectionState();
            loadDashboard();
            startDashboardAutoRefresh();
        })();
    </script>
