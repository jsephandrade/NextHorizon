@{
    ViewData["Title"] = "Agent Tickets";
    Layout = "~/Views/Shared/_QALayout.cshtml";
    var agentId = (int)(ViewData["AgentId"] ?? 0);
    var initialAgentName = (string)(ViewData["AgentName"] ?? string.Empty);
}

@section Styles {
<style>
    .page-wrap {
        background: #ffffff;
        border: 1px solid rgba(0, 0, 0, 0.12);
        border-radius: 14px;
        padding: 16px;
    }

    .head {
        display: grid;
        gap: 10px;
        margin-bottom: 12px;
    }

    .head h2 {
        margin: 0;
        font-size: 1.3rem;
    }

    .head-sub {
        color: #666666;
        font-size: .85rem;
    }

    .search-wrap {
        position: relative;
    }

    .search-wrap i {
        position: absolute;
        left: 10px;
        top: 50%;
        transform: translateY(-50%);
        color: #777777;
        font-size: .85rem;
    }

    .search {
        width: 100%;
        border: 1px solid rgba(0, 0, 0, 0.18);
        border-radius: 10px;
        padding: 9px 12px 9px 30px;
        font-size: .86rem;
        background: #ffffff;
    }

    .filters {
        display: grid;
        gap: 8px;
    }

    .filter-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr 1fr;
        gap: 8px;
    }

    .filter-field {
        display: grid;
        gap: 4px;
    }

    .filter-label {
        font-size: .74rem;
        font-weight: 700;
        color: #5a5a5a;
        letter-spacing: .01em;
    }

    .filter-help {
        font-size: .78rem;
        color: #6a6a6a;
    }

    .filter-input,
    .filter-select {
        width: 100%;
        border: 1px solid rgba(0, 0, 0, 0.18);
        border-radius: 10px;
        padding: 8px 10px;
        font-size: .82rem;
        background: #ffffff;
        color: #222222;
    }

    .tickets {
        display: grid;
        gap: 10px;
    }

    .ticket-tabs {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .tab-btn {
        border: 1px solid rgba(0, 0, 0, 0.14);
        background: #f3f3f3;
        color: #333333;
        border-radius: 999px;
        padding: 6px 10px;
        font-size: .78rem;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .tab-btn.active {
        background: #111111;
        color: #ffffff;
        border-color: #111111;
    }

    .tab-count {
        font-size: .72rem;
        font-weight: 700;
        background: rgba(255, 255, 255, 0.25);
        border-radius: 999px;
        padding: 4px 8px;
    }

    .ticket-panel {
        display: grid;
        gap: 10px;
    }

    .ticket {
        border: 1px solid rgba(0, 0, 0, 0.1);
        border-radius: 12px;
        padding: 12px;
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 8px;
        align-items: center;
        background: #f7f7f7;
    }

    .ticket.is-rated {
        background: #f1f1f1;
        border-color: rgba(0, 0, 0, 0.18);
    }

    .name { font-weight: 700; color: #111111; }
    .sub { color: #666666; }
    .score-pill {
        margin-top: 4px;
        display: inline-flex;
        width: fit-content;
        border-radius: 999px;
        padding: 4px 10px;
        font-size: .74rem;
        font-weight: 700;
        background: #e7e7e7;
        color: #111111;
    }

    .btn {
        text-decoration: none;
        border-radius: 10px;
        padding: 8px 12px;
        background: #111111;
        color: #ffffff;
        font-weight: 600;
        font-size: .82rem;
        text-align: center;
    }

    .empty-state {
        display: none;
        border: 1px dashed rgba(0, 0, 0, 0.2);
        border-radius: 12px;
        padding: 14px;
        color: #555555;
        background: #fafafa;
        font-size: .86rem;
    }

    .pager {
        display: none;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-top: 12px;
        flex-wrap: wrap;
    }

    .pager-pages {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .pager-btn {
        border: 1px solid rgba(0, 0, 0, 0.14);
        background: #ffffff;
        color: #111111;
        border-radius: 10px;
        padding: 8px 12px;
        font-size: .82rem;
        font-weight: 600;
        cursor: pointer;
    }

    .pager-btn.active {
        background: #111111;
        color: #ffffff;
    }

    .pager-btn:disabled {
        background: #e5e5e5;
        color: #8a8a8a;
        cursor: not-allowed;
    }

    .pager-ellipsis {
        color: #666666;
        font-size: .9rem;
        padding: 0 2px;
    }

    @@media (max-width: 700px) {
        .filter-grid {
            grid-template-columns: 1fr;
        }

        .ticket {
            grid-template-columns: 1fr;
        }
    }
</style>
}

<section class="page-wrap">
    <div class="head">
        <h2 id="agent-ticket-title">Agent tickets@(string.IsNullOrWhiteSpace(initialAgentName) ? string.Empty : " - " + initialAgentName)</h2>
        <div id="agent-ticket-sub" class="head-sub">Loading agent ticket history...</div>
        <div class="ticket-tabs" role="tablist" aria-label="Ticket status tabs">
            <button id="tab-awaiting" class="tab-btn active" type="button" role="tab" aria-selected="true">
                Not rated
                <span id="awaiting-count" class="tab-count">0</span>
            </button>
            <button id="tab-rated" class="tab-btn" type="button" role="tab" aria-selected="false">
                Rated
                <span id="rated-count" class="tab-count">0</span>
            </button>
        </div>
        <div class="filters">
            <div class="filter-help">Date filters are based on when the ticket was resolved.</div>
            <div class="filter-grid">
                <div class="filter-field">
                    <label class="filter-label" for="quick-range">Date preset</label>
                    <select id="quick-range" class="filter-select">
                        <option value="custom">Custom range</option>
                        <option value="today">Today</option>
                        <option value="last7">Last 7 days</option>
                        <option value="last30">Last 30 days</option>
                    </select>
                </div>
                <div class="filter-field">
                    <label class="filter-label" for="from-date">Resolved date from</label>
                    <input id="from-date" class="filter-input" type="date" />
                </div>
                <div class="filter-field">
                    <label class="filter-label" for="to-date">Resolved date to</label>
                    <input id="to-date" class="filter-input" type="date" />
                </div>
                <div class="filter-field">
                    <label class="filter-label" for="score-filter">Score range</label>
                    <select id="score-filter" class="filter-select">
                        <option value="">All rated scores</option>
                        <option value="high">90% to 100%</option>
                        <option value="good">80% to 89.9%</option>
                        <option value="mid">70% to 79.9%</option>
                        <option value="low">Below 70%</option>
                    </select>
                </div>
            </div>
            <div class="search-wrap">
                <i class="bi bi-search"></i>
                <input id="agent-ticket-search" class="search" type="text" placeholder="Search by ticket number, concern source, or date..." />
            </div>
        </div>
    </div>

    <div class="tickets" id="agent-ticket-list">
        <section id="awaiting-group" class="ticket-panel"></section>
        <section id="rated-group" class="ticket-panel" style="display:none;"></section>
    </div>
    <div id="agent-ticket-empty" class="empty-state">No tickets found for the selected filters.</div>
    <div id="agent-ticket-pager" class="pager">
        <div id="agent-ticket-pager-pages" class="pager-pages"></div>
        <button id="agent-ticket-pager-next" class="pager-btn" type="button">Next page</button>
    </div>
</section>

<script>
    (function () {
        var agentUserId = @agentId;
        var input = document.getElementById('agent-ticket-search');
        var quickRange = document.getElementById('quick-range');
        var fromDate = document.getElementById('from-date');
        var toDate = document.getElementById('to-date');
        var scoreFilter = document.getElementById('score-filter');
        var title = document.getElementById('agent-ticket-title');
        var sub = document.getElementById('agent-ticket-sub');
        var awaitingGroup = document.getElementById('awaiting-group');
        var ratedGroup = document.getElementById('rated-group');
        var awaitingCount = document.getElementById('awaiting-count');
        var ratedCount = document.getElementById('rated-count');
        var tabAwaiting = document.getElementById('tab-awaiting');
        var tabRated = document.getElementById('tab-rated');
        var emptyState = document.getElementById('agent-ticket-empty');
        var pager = document.getElementById('agent-ticket-pager');
        var pagerPages = document.getElementById('agent-ticket-pager-pages');
        var pagerNext = document.getElementById('agent-ticket-pager-next');
        if (!input || !quickRange || !fromDate || !toDate || !scoreFilter || !title || !sub || !awaitingGroup || !ratedGroup || !awaitingCount || !ratedCount || !tabAwaiting || !tabRated || !emptyState || !pager || !pagerPages || !pagerNext) return;

        var activeTab = 'awaiting';
        var searchDebounceHandle = 0;
        var currentAwaitingPage = 1;
        var currentRatedPage = 1;

        function escHtml(value) {
            return String(value || '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function toIsoDate(d) {
            var y = d.getFullYear();
            var m = String(d.getMonth() + 1).padStart(2, '0');
            var day = String(d.getDate()).padStart(2, '0');
            return y + '-' + m + '-' + day;
        }

        function applyQuickRange() {
            var now = new Date();
            var selected = quickRange.value;
            if (!selected || selected === 'custom') return;

            var end = new Date(now.getFullYear(), now.getMonth(), now.getDate());
            var start = new Date(end);
            if (selected === 'today') start = end;
            else if (selected === 'last7') start.setDate(start.getDate() - 6);
            else if (selected === 'last30') start.setDate(start.getDate() - 29);

            fromDate.value = toIsoDate(start);
            toDate.value = toIsoDate(end);
        }

        function getVisiblePages(currentPage, totalPages) {
            var pages = [];
            var start = Math.max(1, Math.min(currentPage - 2, totalPages - 4));
            var end = Math.min(totalPages, start + 4);
            for (var page = start; page <= end; page++) {
                pages.push(page);
            }
            return pages;
        }

        function buildQueryString() {
            var query = new URLSearchParams();
            query.set('id', String(agentUserId));
            query.set('awaitingPage', String(currentAwaitingPage));
            query.set('ratedPage', String(currentRatedPage));
            query.set('range', quickRange.value || 'custom');
            if (fromDate.value) query.set('from', fromDate.value);
            if (toDate.value) query.set('to', toDate.value);

            var search = (input.value || '').trim();
            if (search) query.set('search', search);
            if (scoreFilter.value) query.set('score', scoreFilter.value);

            return query.toString();
        }

        function setActiveTab(tab) {
            activeTab = tab;
            if (tab === 'rated') {
                awaitingGroup.style.display = 'none';
                ratedGroup.style.display = '';
                tabAwaiting.classList.remove('active');
                tabAwaiting.setAttribute('aria-selected', 'false');
                tabRated.classList.add('active');
                tabRated.setAttribute('aria-selected', 'true');
                return;
            }

            awaitingGroup.style.display = '';
            ratedGroup.style.display = 'none';
            tabAwaiting.classList.add('active');
            tabAwaiting.setAttribute('aria-selected', 'true');
            tabRated.classList.remove('active');
            tabRated.setAttribute('aria-selected', 'false');
        }

        function renderPagination(payload) {
            var isRatedTab = activeTab === 'rated';
            var page = isRatedTab ? (payload.ratedPage || 1) : (payload.awaitingPage || 1);
            var totalPages = isRatedTab ? (payload.ratedTotalPages || 1) : (payload.awaitingTotalPages || 1);
            var hasNext = isRatedTab ? !!payload.hasRatedNext : !!payload.hasAwaitingNext;
            var itemCount = isRatedTab ? (payload.ratedCount || 0) : (payload.awaitingCount || 0);
            var visiblePages = getVisiblePages(page, totalPages);
            var html = '';
            for (var i = 0; i < visiblePages.length; i++) {
                var visiblePage = visiblePages[i];
                html += '<button class="pager-btn' + (visiblePage === page ? ' active' : '') + '" type="button" data-page="' + visiblePage + '">' + visiblePage + '</button>';
            }
            if (visiblePages.length && visiblePages[visiblePages.length - 1] < totalPages) {
                html += '<span class="pager-ellipsis">...</span>';
            }
            pagerPages.innerHTML = html;
            pagerNext.disabled = !hasNext;
            pager.style.display = itemCount > 0 && totalPages > 1 ? 'flex' : 'none';
        }

        function renderTicketRow(item) {
            var html = '<div class="ticket' + (item.isRated ? ' is-rated' : '') + '">';
            html += '<div>';
            html += '<div class="name">Ticket #' + item.supportFaqId + ' - Agent: ' + escHtml(item.agentName) + ' - Concern from: ' + escHtml(item.concernFrom) + '</div>';
            if (item.isRated) {
                html += '<div class="sub">QA ' + escHtml(item.reviewerName) + ' on ' + escHtml(item.ratedAtLabel) + ' - <strong>' + escHtml(item.categorySummary || 'No category breakdown recorded.') + '</strong></div>';
            } else {
                html += '<div class="sub">Resolved ' + escHtml(item.resolvedAtLabel) + ', waiting QA rating</div>';
            }
            if (item.isRated && item.overallPercent !== null && item.overallPercent !== undefined) {
                html += '<div class="score-pill">' + Number(item.overallPercent).toFixed(1) + ' / 100</div>';
            }
            html += '</div>';
            html += '<a class="btn" href="/qa/rating/' + item.supportFaqId + '">View</a>';
            html += '</div>';
            return html;
        }

        function renderPayload(payload) {
            title.textContent = 'Agent tickets - ' + (payload.agentName || 'Unknown Agent');
            sub.textContent = 'Agent ID: ' + payload.agentUserId + '. Open any ticket to view the conversation and QA result.';
            awaitingCount.textContent = String(payload.awaitingCount || 0);
            ratedCount.textContent = String(payload.ratedCount || 0);
            currentAwaitingPage = payload.awaitingPage || 1;
            currentRatedPage = payload.ratedPage || 1;

            awaitingGroup.innerHTML = (payload.awaitingItems || []).map(renderTicketRow).join('');
            ratedGroup.innerHTML = (payload.ratedItems || []).map(renderTicketRow).join('');

            var activeCount = activeTab === 'rated'
                ? (payload.ratedItems || []).length
                : (payload.awaitingItems || []).length;
            emptyState.style.display = activeCount === 0 ? 'block' : 'none';
            renderPagination(payload);
        }

        function applyErrorState(message) {
            sub.textContent = message;
            awaitingGroup.innerHTML = '';
            ratedGroup.innerHTML = '';
            awaitingCount.textContent = '0';
            ratedCount.textContent = '0';
            pager.style.display = 'none';
            pagerPages.innerHTML = '';
            emptyState.textContent = message;
            emptyState.style.display = 'block';
        }

        function loadTickets() {
            if (agentUserId <= 0) {
                applyErrorState('No agent was selected.');
                return;
            }

            sub.textContent = 'Loading agent ticket history...';

            fetch('/qa/api/agent-tickets?' + buildQueryString(), {
                headers: { 'Accept': 'application/json' }
            })
                .then(function (response) {
                    if (response.status === 404) {
                        throw new Error('Agent not found.');
                    }
                    if (!response.ok) {
                        throw new Error('Unable to load agent tickets.');
                    }
                    return response.json();
                })
                .then(renderPayload)
                .catch(function (error) {
                    applyErrorState(error && error.message ? error.message : 'Unable to load agent tickets.');
                });
        }

        function setCustomRangeOnManualDate() {
            quickRange.value = 'custom';
        }

        function resetToFirstPage() {
            currentAwaitingPage = 1;
            currentRatedPage = 1;
        }

        tabAwaiting.addEventListener('click', function () {
            setActiveTab('awaiting');
            emptyState.style.display = awaitingGroup.children.length === 0 ? 'block' : 'none';
            loadTickets();
        });

        tabRated.addEventListener('click', function () {
            setActiveTab('rated');
            emptyState.style.display = ratedGroup.children.length === 0 ? 'block' : 'none';
            loadTickets();
        });

        input.addEventListener('input', function () {
            window.clearTimeout(searchDebounceHandle);
            resetToFirstPage();
            searchDebounceHandle = window.setTimeout(loadTickets, 200);
        });
        scoreFilter.addEventListener('change', function () {
            resetToFirstPage();
            loadTickets();
        });
        fromDate.addEventListener('change', function () {
            setCustomRangeOnManualDate();
            resetToFirstPage();
            loadTickets();
        });
        toDate.addEventListener('change', function () {
            setCustomRangeOnManualDate();
            resetToFirstPage();
            loadTickets();
        });
        fromDate.addEventListener('focus', setCustomRangeOnManualDate);
        toDate.addEventListener('focus', setCustomRangeOnManualDate);
        fromDate.addEventListener('click', setCustomRangeOnManualDate);
        toDate.addEventListener('click', setCustomRangeOnManualDate);
        quickRange.addEventListener('change', function () {
            if (quickRange.value === 'custom') {
                fromDate.value = '';
                toDate.value = '';
            }
            applyQuickRange();
            resetToFirstPage();
            loadTickets();
        });

        pagerNext.addEventListener('click', function () {
            if (activeTab === 'rated') {
                currentRatedPage++;
            } else {
                currentAwaitingPage++;
            }

            loadTickets();
        });

        pagerPages.addEventListener('click', function (event) {
            var target = event.target;
            if (!target || !target.matches('[data-page]')) return;
            var nextPage = parseInt(target.getAttribute('data-page') || '0', 10);
            if (!nextPage) return;

            if (activeTab === 'rated') {
                if (nextPage === currentRatedPage) return;
                currentRatedPage = nextPage;
            } else {
                if (nextPage === currentAwaitingPage) return;
                currentAwaitingPage = nextPage;
            }

            loadTickets();
        });

        setActiveTab('awaiting');
        loadTickets();
    })();
</script>
