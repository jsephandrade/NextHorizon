    <Compile Remove="Controllers\HelpCenter\**\*.cs" />
    <Compile Remove="Controllers\HomeController.cs" />
    <Compile Remove="Controllers\MemberTracker\**\*.cs" />
    <Compile Remove="Controllers\Messaging\**\*.cs" />
    <Compile Remove="Controllers\ProductsController.cs" />
    <Compile Remove="Controllers\PurchasesController.cs" />
    <Compile Remove="Controllers\ReviewsController.cs" />
    <Compile Remove="Controllers\SellerController.cs" />
    <Compile Remove="Controllers\WishlistController.cs" />
    <Content Remove="obj_verify\**\*" />
    <Content Remove="Views\Agent\**\*.cshtml" />
    <Content Remove="Views\Dashboard\**\*.cshtml" />
    <Content Remove="Views\HelpCenter\**\*.cshtml" />
    <Content Remove="Views\Home\**\*.cshtml" />
    <Content Remove="Views\MemberTracker\**\*.cshtml" />
    <Content Remove="Views\Messaging\**\*.cshtml" />
    <Content Remove="Views\Seller\**\*.cshtml" />
    <Content Remove="Views\Shared\_AgentLayout.cshtml" />
    <Content Remove="Views\Shared\_DashboardLayout.cshtml" />
    <Content Remove="Views\Shared\_Footer.cshtml" />
    <Content Remove="Views\Shared\_Layout.cshtml" />
    <Content Remove="Views\Shared\_Layout.cshtml.css" />
    <Content Remove="Views\Shared\_LoginPartial.cshtml" />
    <Content Remove="wwwroot\css\AgentDashboard.css" />
    <Content Remove="wwwroot\css\AgentLayout.css" />
    <Content Remove="wwwroot\css\consumer-messenger.css" />
    <Content Remove="wwwroot\css\Header.css" />
