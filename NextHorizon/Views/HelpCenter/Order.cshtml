@{
    ViewData["Title"] = "Order Help - FAQ";
}

@section Styles {
    <link href="~/HelpCenter/faq-pages.css" rel="stylesheet" asp-append-version="true" />
}

<div class="help-center-page">
    <a href="/Help" class="help-back-btn">
        <i class="fas fa-arrow-left"></i> Back to Help Center
    </a>

    <div class="help-page-header">
        <div class="help-page-icon">
            <i class="fa-solid fa-box"></i>
        </div>
        <h1>Order Help</h1>
        <p>Everything you need to know about managing your orders</p>
    </div>

    <div class="help-page-faq">
        <div class="help-faq-item">
            <div class="help-faq-question">
                <span>Can I cancel my order after placing it?</span>
                <i class="fas fa-chevron-down"></i>
            </div>
            <div class="help-faq-answer">
                Yes, if your order hasn't shipped yet. Go to <strong>My Purchases</strong>, select the order, and click <strong>Cancel Order</strong>. Once shipped, you'll need to request a return after delivery.
            </div>
        </div>

        <div class="help-faq-item">
            <div class="help-faq-question">
                <span>What does "Processing" mean?</span>
                <i class="fas fa-chevron-down"></i>
            </div>
            <div class="help-faq-answer">
                Your order is being prepared for shipment. This typically takes 1-2 business days before it's handed to the courier.
            </div>
        </div>

        <div class="help-faq-item">
            <div class="help-faq-question">
                <span>Can I modify my order after checkout?</span>
                <i class="fas fa-chevron-down"></i>
            </div>
            <div class="help-faq-answer">
                Order modifications (address, items) are only possible before processing begins. Contact support immediately if you need changes.
            </div>
        </div>

        <div class="help-faq-item">
            <div class="help-faq-question">
                <span>How do I know if my order was successful?</span>
                <i class="fas fa-chevron-down"></i>
            </div>
            <div class="help-faq-answer">
                You'll receive an order confirmation email immediately after checkout. You can also check your order status in <strong>My Purchases</strong>.
            </div>
        </div>

        <div class="help-faq-item">
            <div class="help-faq-question">
                <span>Can I add items to an existing order?</span>
                <i class="fas fa-chevron-down"></i>
            </div>
            <div class="help-faq-answer">
                No, items cannot be added to an existing order. Please place a new order for additional items.
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/help-center.js" asp-append-version="true"></script>
}
