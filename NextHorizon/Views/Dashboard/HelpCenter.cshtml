@{
    ViewData["Title"] = "Seller Help Center";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="/css/help-center.css" />
    <link rel="stylesheet" href="/css/help-center-chat.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
}

<div class="help-center-page">
    <div class="help-center-hero">
        <div>
            <p class="help-center-label">Support</p>
            <h1>Need help managing your seller account?</h1>
            <p class="help-center-subtitle">
                Explore quick answers, guides, and support options for orders, payouts, shipping, marketing, and account
                management.
            </p>
            <div class="help-search" style="margin-top:40px;">
                <i class="fas fa-search"></i>
                <input type="text" id="helpSearchInput" placeholder="Search help topics..." />
            </div>
        </div>
        <a class="help-center-action" href="mailto:support@nexthorizon.com">Email Support</a>
    </div>

    <div class="two-column-layout">
        <!-- ================= LEFT SIDE (HELP CENTER) ================= -->
        <div class="help-left">
            <p id="noResultsMessage" class="no-results">No results found.</p>

            <!-- CATEGORIES -->
            <h2 class="help-category-header">Categories</h2>
            <div class="carousel-container">
                <button class="carousel-arrow carousel-arrow-left" id="carouselLeft">&larr;</button>
                <div id="helpCenterGrid" class="help-center-grid">
                    <!-- Categories will be injected here dynamically -->
                </div>
                <button class="carousel-arrow carousel-arrow-right" id="carouselRight">&rarr;</button>
            </div>

            <!-- FAQ -->
            <div class="help-center-faq">
                <h2>Frequently Asked Questions</h2>
                <div id="faqContainer">
                    <!-- FAQs will be injected here dynamically -->
                </div>
                <div id="chatWithAgentRow" class="chat-with-agent-row hidden">
                    <button id="chatWithAgentBtn" type="button" class="chat-with-agent-btn" onclick="openChatWithAgent()">
                        Chat with Agent
                    </button>
                </div>
            </div>
        </div>

        <!-- ================= RIGHT SIDE (CHAT SUPPORT) ================= -->
        <div class="help-right">
            <div class="support-container">
                <!-- HEADER -->
                <div class="support-header">
                    <div class="support-header-left">
                        <div class="support-avatar">S</div>
                        <div>
                            <h3>Seller Support</h3>
                            <p>Customer Service</p>
                        </div>
                    </div>
                    <button id="resolveChatBtn" class="resolve-chat-btn hidden" onclick="resolveChat()">Resolve</button>
                    <button class="clear-chat-btn" onclick="clearChat()">Clear Chat</button>
                </div>

                <!-- CHAT BODY -->
                <div class="support-body">
                    <div id="chatThread" class="chat-thread"></div>
                    <div id="typingIndicator" class="typing-indicator" style="display:none;">Agent is typing...</div>

                    <div id="chatInputRow" class="chat-input-row hidden">
                        <input type="text" id="agentInput" placeholder="Type your message..." />
                        <button class="agent-btn" onclick="sendAgentMessage()">Send</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="/js/helpcenter.js"></script>
<script src="/js/help-center-chat.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    let selectedHelpCategory = null;

    // Load categories from DB (api/faqs/categories), fallback to hardcoded if needed
    async function loadCategories() {
        let categories = [];
        try {
            console.log('Loading categories from API...');
            const res = await fetch('/api/faqs/categories');
            console.log('API response status:', res.status);
            if (res.ok) {
                categories = await res.json();
                console.log('API returned categories:', categories);
            } else {
                console.warn('API returned status:', res.status);
            }
            if (!categories || categories.length === 0) {
                console.warn('No categories from API, using fallback list');
                categories = ['baligya', 'Testing'];
            }
            console.log('Final categories to display:', categories);

            const grid = document.getElementById('helpCenterGrid');
            if (!grid) return;

            grid.innerHTML = '';

            if (!categories || categories.length === 0) {
                grid.innerHTML = '<p>No categories available</p>';
                return;
            }

            categories.forEach(cat => {
                const card = document.createElement('div');
                card.className = 'help-card';
                card.setAttribute('data-title', cat);

                const icon = document.createElement('div');
                icon.className = 'help-card-icon';
                icon.innerHTML = '<i class="fas fa-question"></i>';

                const content = document.createElement('div');
                content.className = 'help-card-content';

                const title = document.createElement('h3');
                title.textContent = cat;

                const description = document.createElement('p');
                description.textContent = `Consumer FAQs for ${cat}.`;

                const link = document.createElement('a');
                link.href = '#';
                link.textContent = 'View Details';
                link.addEventListener('click', (event) => {
                    event.preventDefault();
                    loadFaqs(cat);
                });

                content.appendChild(title);
                content.appendChild(description);
                content.appendChild(link);

                card.appendChild(icon);
                card.appendChild(content);

                grid.appendChild(card);
            });
        } catch (err) {
            console.error('Error loading categories:', err);
            const grid = document.getElementById('helpCenterGrid');
            if (grid) grid.innerHTML = '<p>Error loading categories</p>';
        }
    }

    // Fetch and display FAQs for the selected category
    window.loadFaqs = async function(category) {
        try {
            selectedHelpCategory = category;
            console.log('Loading FAQs for category:', category);
            const res = await fetch(`/api/faqs/items/${encodeURIComponent(category)}`);
            if (!res.ok) {
                const body = await res.text();
                console.error('Failed to load FAQs:', res.status, body);
                throw new Error(body || `Failed to load FAQs: ${res.status}`);
            }
            const faqs = await res.json();
            console.log('FAQs received:', faqs);

            const container = document.getElementById('faqContainer');
            const chatWithAgentRow = document.getElementById('chatWithAgentRow');
            if (!container) return;
            
            container.innerHTML = '';

            if (!faqs || faqs.length === 0) {
                container.innerHTML = '<p>No FAQs available for this category</p>';
                if (chatWithAgentRow) chatWithAgentRow.classList.remove('hidden');
                return;
            }

            faqs.forEach(faq => {
                const item = document.createElement('div');
                item.className = 'faq-item';
                
                // Log the faq object to see its structure
                console.log('FAQ item:', faq);

                item.innerHTML = `
                    <button class="faq-question">${faq.question || faq.Question || 'No question'}</button>
                    <p class="faq-answer">${faq.answer || faq.Answer || 'No answer available'}</p>
                `;

                container.appendChild(item);
            });

            // Toggle FAQ answer display
            document.querySelectorAll('.faq-question').forEach(btn => {
                btn.addEventListener('click', () => {
                    const p = btn.nextElementSibling;
                    p.style.display = p.style.display === 'block' ? 'none' : 'block';
                });
            });

            if (chatWithAgentRow) chatWithAgentRow.classList.remove('hidden');

        } catch (err) {
            console.error('Error loading FAQs:', err);
            const container = document.getElementById('faqContainer');
            if (container) container.innerHTML = '<p>Error loading FAQs</p>';
        }
    }

    window.openChatWithAgent = function() {
        if (!selectedHelpCategory) {
            alert('Please choose a category first.');
            return;
        }

        if (typeof sendTopic === 'function') {
            sendTopic(selectedHelpCategory);
        }
    };

    // Load categories when page loads
    loadCategories();
});
</script>
}
