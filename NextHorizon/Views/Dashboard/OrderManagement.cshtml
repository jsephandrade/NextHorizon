@model List<NextHorizon.Models.Order>
@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}
@{
    ViewData["Title"] = "Order Management";
    ViewData["DashboardHeading"] = "Order Management";
    ViewData["SellerName"] = "NextHorizon Seller";

    var sellerCategories = Model
        .SelectMany(order => order.OrderItems ?? Enumerable.Empty<NextHorizon.Models.OrderItem>())
        .Select(item => item.Product?.Category?.Trim())
        .Where(category => !string.IsNullOrWhiteSpace(category))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(category => category)
        .ToList();
    var startDateValue = ViewBag.StartDate as string ?? string.Empty;
    var endDateValue = ViewBag.EndDate as string ?? string.Empty;
    var hasDateFilter = !string.IsNullOrWhiteSpace(startDateValue) || !string.IsNullOrWhiteSpace(endDateValue);
    var emptyStateMessage = hasDateFilter
        ? "No orders found within the selected date range."
        : "No orders match the current filters.";
}

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&amp;display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/css/ordermanagement.css" />

@if (TempData["ErrorMessage"] != null)
{
    <div class="order-page-alert">@TempData["ErrorMessage"]</div>
}

<div class="order-filters">
    <button type="button" class="order-filter-btn active" data-filter="all">All Orders</button>
    <button type="button" class="order-filter-btn" data-filter="Pending">Pending</button>
    <button type="button" class="order-filter-btn" data-filter="To Ship">To Ship</button>
    <button type="button" class="order-filter-btn" data-filter="Shipped">Shipped</button>
    <button type="button" class="order-filter-btn" data-filter="Delivered">Delivered</button>
    <button type="button" class="order-filter-btn" data-filter="Cancelled">Cancelled</button>
    <button type="button" class="order-filter-btn" data-filter="Return">Return</button>
</div>

<div class="order-toolbar">

    <!-- SEARCH -->
    
   <div class="search-box">
    <input type="search" id="orderSearch" placeholder="Search orders..." onkeyup="applyOrderFilters()" />
    <button type="button" id="searchBtn" onclick="applyOrderFilters()">Search</button>
</div>

    <!-- CATEGORY -->
    <select id="categoryFilter" class="order-select">
        <option value="all">All Categories</option>
        @foreach (var category in sellerCategories)
        {
            <option value="@category">@category</option>
        }
    </select>

    <!-- DATE FILTER -->
    <div class="date-filter">
        <input type="date" id="startDate" value="@startDateValue">
        <span>to</span>
        <input type="date" id="endDate" value="@endDateValue">
        <button id="clearDate">Clear</button>
    </div>

</div>


<table class="order-table">
    <thead>
        <tr>
            <th>Order ID</th>
            <th>Customer</th>
            <th>Date</th>
            <th>Product</th>
            <th>Qty</th>
            <th>Total</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            var orderCategories = order.OrderItems?
                .Select(item => item.Product?.Category?.Trim())
                .Where(category => !string.IsNullOrWhiteSpace(category))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList() ?? new List<string>();

            <tr class="order-row"
                data-order-id="@order.OrderID"
                data-status="@order.Status"
                data-categories="@string.Join("|", orderCategories)"
                data-courier="@order.Courier"
                data-tracking="@order.TrackingNumber"
                data-return-proof="@order.ReturnProofImage"
                data-return-note="@order.ReturnNote"
                data-return-reason="@order.ReturnReason"
                data-order-date="@order.OrderDate.ToString("yyyy-MM-dd")">

                <td>@order.OrderID</td>
                <td>@order.FullName
                    @if (!string.IsNullOrWhiteSpace(order.SellerNote))
    {
        <span title="This order has internal notes" style="color: #f59e0b; margin-left: 8px;">
            <i class="fa-solid fa-note-sticky"></i>
        </span>
    }</td>
                <td>@order.OrderDate.ToString("MMM dd, yyyy")</td>

                <!-- PRODUCT WITH IMAGE -->
                <td class="product-cell">
                    <img src="https://picsum.photos/50" class="product-img" />
                    <span>@order.ProductName</span>
                </td>

                <td>@order.Quantity</td>
                <td>₱@order.CalculatedTotal.ToString("N2")</td>
                <td>
                    <span class="status-badge @((order.Status ?? string.Empty).ToLower().Replace(" ", "-"))">
                        @order.Status
                    </span>
                </td>

                <td>
                    <div class="action-menu-wrap">
                        <button class="action-icon-btn">⋮</button>

                            <div class="action-menu">
                            @* VIEW DETAILS - always visible *@
                            <a class="action-menu-item"
                            asp-controller="Dashboard"
                            asp-action="OrderDetails"
                            asp-route-id="@order.OrderID">
                                View Details
                            </a>

                            @* CONTACT CUSTOMER - always visible *@
                            <button class="action-menu-item"
                                    onclick="window.location.href='@Url.Action("Messenger","Seller")'">
                                Contact Customer
                            </button>

                            @* VIEW ORDER - only for Pending *@
                            @if(order.Status == "Pending")
                            {
                               <button class="action-menu-item view-order-btn" 
                               onclick="openViewOrderModal(@order.OrderID)">
                                View Order
                                 </button>
                            }

                           @if(order.Status == "To Ship")
{
    string actualCourierName = "NextHorizon Partner";

    if (ViewBag.Couriers != null && order.logistics_id != null)
    {
        foreach (dynamic courier in ViewBag.Couriers) 
        {
            if (Convert.ToInt32(courier.logistics_id) == Convert.ToInt32(order.logistics_id))
            {
                actualCourierName = courier.courier_name;
                break;
            }
        }
    }

    <button class="action-menu-item mark-as-shipped-btn" 
            data-order-id="@order.OrderID" 
            data-customer="@order.FullName" 
            data-courier-id="@order.logistics_id"
            data-courier-name="@actualCourierName"> 
        Mark as Shipped
    </button>
}

                            @if(order.Status == "Shipped")
                            {
                                <button class="action-menu-item mark-returned-btn"
                                        data-order-id="@order.OrderID">
                                    Mark as Returned
                                </button>
                            }
                            else if (order.Status == "Return")
                            {
                                <button class="action-menu-item view-returned-btn"
                                        data-order-id="@order.OrderID">
                                    View Return Details
                                </button>
                            }

                            @* ADD NOTE - for Pending, To Ship, Shipped, Completed/Delivered *@
                            @if(order.Status == "Pending" 
                            || order.Status == "To Ship"
                            || order.Status == "Shipped"
                            || order.Status == "Delivered")
                            {
                             <button class="action-menu-item add-note-btn"
                                 data-order-id="@order.OrderID" 
                                     data-customer="@order.FullName">
                                    Add Note
                                    </button>
                            }

                            @* DOWNLOAD RECEIPT - only for Completed/Delivered *@
                            @if(order.Status == "Delivered")
                            {
                                <button class="action-menu-item download-receipt-btn"
                                        onclick='openDownloadReceiptModal(@Html.Raw(Json.Serialize(order)))'>
                                    Download Receipt
                                </button>
                            }

                        </div>
                    </div>
                </td>
            </tr>
        }
        <tr id="noOrdersRow" class="order-empty-row" style="@(Model.Any() ? "display:none;" : string.Empty)">
            <td colspan="8">
                <div class="order-empty-state">@emptyStateMessage</div>
            </td>
        </tr>
    </tbody>
</table>

<div id="orderSummaryModal" class="bw-modal-overlay">
    <div class="premium-modal-container">
        
        <div class="premium-header">
            <h3>Order #<span id="summaryOrderId">Loading...</span></h3>
            <span class="premium-close-btn" onclick="closeOrderSummaryModal()">✖</span>
        </div>

        <div class="premium-body">
            
            <div class="metrics-grid">
                <div class="metric-card">
                    <div class="metric-label">Date Placed</div>
                    <div class="metric-value" id="modalOrderDate">...</div>
                </div>
                <div class="metric-card">
                    <div class="metric-label">Payment Method</div>
                    <div class="metric-value" id="modalPayment">...</div>
                </div>
                <div class="metric-card">
                    <div class="metric-label">Order Total</div>
                    <div class="metric-value" id="modalTotal" style="color: #059669;">...</div>
                </div>
                <div class="metric-card">
                    <div class="metric-label">Status</div>
                    <div class="metric-value"><span class="status-badge pending">Pending</span></div>
                </div>
            </div>

            <div class="info-section">
                <h4>Order Items</h4>
                <table class="premium-table">
                    <thead>
                        <tr>
                            <th>Item Details</th>
                            <th style="text-align: center;">Qty</th>
                            <th style="text-align: right;">Total</th>
                        </tr>
                    </thead>
                    <tbody id="modalItemsBody">
                        <tr>
                            <td>
                                <strong style="display: block; color: #111827;">Comfort Sculpt Seamless Bra</strong>
                            </td>
                            <td style="text-align: center; font-weight: 500;">x4</td>
                            <td style="text-align: right; font-weight: 500;">₱2,600.00</td>
                        </tr>
                    </tbody>
                </table>
            </div>

         <div class="details-grid">
                
                <div class="info-section" style="margin-bottom: 0;">
                    <h4>Customer Details</h4>
                    <div class="premium-box" style="height: 100%;">
                        <p style="margin: 0 0 4px 0; color: #111827;"><strong><span id="modalCustomerName">...</span></strong></p>
                        <p style="margin: 0 0 12px 0; color: #6b7280; font-size: 0.85rem;" id="modalCustomerEmail">...</p>
                        
                        <p style="margin: 0 0 6px 0; font-size: 0.9rem;">📞 <span id="modalCustomerPhone">...</span></p>
                       <div style="margin-bottom: 15px;">
    <p style="font-size: 0.85rem; color: #6b7280; margin-bottom: 4px;">Shipping Address</p>
    
    <div style="display: flex; align-items: flex-start; gap: 10px;">
        <span id="modalCustomerAddress" style="font-weight: 500; color: #111827; flex: 1;">
            Loading address...
        </span>
        
        <button onclick="copyCustomerAddress()" title="Copy Address" style="background: none; border: 1px solid #d1d5db; border-radius: 4px; padding: 4px 8px; cursor: pointer; color: #4b5563; transition: all 0.2s;">
            <i class="fa-regular fa-copy"></i> Copy
        </button>
    </div>
                        
                        <p style="margin: 0; font-size: 0.85rem; color: #059669; font-weight: 500;">
                            🚚 Delivery: <span id="modalDeliveryOption">...</span>
                        </p>
                    </div>
                </div>
   </div>
                <div class="info-section" style="margin-bottom: 0;">
                    <h4>Order Summary</h4>
                    <div class="premium-box" style="height: 100%; display: flex; flex-direction: column; justify-content: center;">
                        
                        <div class="summary-line">
                            <span>Subtotal (<span id="modalTotalItems">0</span> items)</span>
                            <span id="modalSubtotal">₱0.00</span>
                        </div>
                        
                        <div class="summary-line">
                            <span>Shipping Fee</span>
                            <span id="modalShippingFee">₱0.00</span>
                        </div>
                        
                        <hr style="border: 0; border-top: 1px dashed #e5e7eb; margin: 12px 0;" />
                        
                        <div class="summary-line total-line">
                            <span>Grand Total</span>
                            <span id="modalGrandTotal" style="color: #059669;">₱0.00</span>
                        </div>
                        
                    </div>
                </div>

         </div>

            <div class="info-section" style="margin-top: 24px;">
                <h4>Logistics Preference</h4>
                <select id="courierSelect" class="form-select" style="width: 100%; padding: 12px; border-radius: 6px; border: 1px solid #d1d5db; background: #f9fafb;">
                    <option value="">Select a Courier...</option>
                    @if (ViewBag.Couriers != null)
                    {
                        foreach (var courier in ViewBag.Couriers)
                        {
                            <option value="@courier.logistics_id">@courier.courier_name</option>
                        }
                    }
                </select>
                <div id="courierWarning" class="validation-warning">
        <svg width="16" height="16" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path></svg>
        <span>Please select a courier before accepting this order.</span>
            </div>
        </div> 
       <div class="premium-footer" style="display: flex; flex-direction: row; flex-wrap: nowrap; gap: 10px; width: 100%; padding: 16px 24px; background: #fff; border-top: 1px solid #e5e7eb;">
    
    <button type="button" 
            onclick="openDeclineModal(document.getElementById('summaryOrderId').innerText)" 
            style="flex: 1; padding: 10px 16px; font-size: 13px; font-weight: 500; display: flex; justify-content: center; gap: 8px; align-items: center; border: none; color: #000; background: #e5e5e5; border-radius: 6px; cursor: pointer; white-space: nowrap; transition: background 0.2s ease;"> 
        <i class="fa-solid fa-xmark"></i> Decline
    </button>

    <button type="button" 
            onclick="confirmAndAcceptOrder()" 
            style="flex: 1; padding: 10px 16px; font-size: 13px; font-weight: 500; display: flex; justify-content: center; gap: 8px; align-items: center; border: none; border-radius: 6px; background-color: #000; color: #fff; cursor: pointer; white-space: nowrap; transition: background 0.2s ease;"> 
        <i class="fa-solid fa-check"></i> Accept
    </button>
    
</div>
    </div>
    </div>
</div>
<!-- ===== PROCESSING MODAL ===== -->
<div id="processingModal" class="modal-overlay">
    <div class="processing-box">
        <div class="loader"></div>
        <h3>Processing Order...</h3>
        <p>Step 5: System Execution (Automated)</p>

        <ul>
            <li>✔ Updating Status to TO SHIP</li>
            <li>✔ Deducting Live Inventory</li>
            <li>✔ Sending Buyer Notification</li>
        </ul>
    </div>
</div>

<!-- ORDER MOVED TO TO SHIP MODAL -->
<div id="orderToShipModal" class="notes-modal-overlay">
    <div class="notes-modal-container">
        <h3>📦 Order Updated!</h3>
        <p id="toShipMessage">Order #12345 has been moved to TO SHIP.</p>
        <div style="text-align: center; margin-top: 20px;">
            <button id="toShipOkBtn" 
                    style="background: #3b82f6; color: white; padding: 12px 24px; border-radius: 8px; border: none; font-size: 14px; cursor: pointer;">
                OK
            </button>
        </div>
    </div>
</div>


<!-- ===== REVIEW REQUEST MODAL ===== -->
<div id="reviewRequestModal" class="notes-modal-overlay">
    <div class="notes-modal-container">

        <!-- HEADER -->
        <div class="notes-header">
            <h3>📝 Review Request</h3>
            <span class="notes-close" onclick="closeReviewRequestModal()">✕</span>
        </div>

        <!-- ORDER & CUSTOMER INFO -->
        <div class="review-info">
            <p><strong>Order #:</strong> <span id="reviewOrderId">12345</span></p>
            <p><strong>Customer:</strong> <span id="reviewCustomer">Harvy</span></p>
            <p><strong>Product:</strong> <span id="reviewProduct">Comfort Sculpt Bra</span></p>
            <p><strong>Return Reason:</strong> <span id="reviewReason">Wrong Size</span></p>
        </div>

        <!-- ATTACHED PHOTOS -->
        <div class="review-attachments">
            <p><strong>Customer Proof:</strong></p>
            <div id="reviewPhotos" class="photo-grid">
                <!-- Customer photos will be inserted dynamically -->
            </div>
        </div>

        <!-- COMMENT -->
        <div class="review-comment">
            <div class="review-comment-header">
                <p class="review-comment-title">Seller Comment</p>
                <span class="review-comment-hint">Optional, but useful for explaining your decision.</span>
            </div>
            <textarea id="reviewComment" placeholder="Add comment (optional)..."></textarea>
        </div>

        <!-- DECISION -->
        <div class="review-decision">
            <label>
                <input type="radio" name="reviewDecision" value="approve"> Approve
            </label>
            <label>
                <input type="radio" name="reviewDecision" value="reject"> Reject
            </label>
        </div>

        <!-- ACTIONS -->
        <div class="notes-actions" style="justify-content: center;">
            <button onclick="closeReviewRequestModal()" 
                    style="background:#e5e7eb; color:#111; padding:12px 24px; border-radius:8px; border:none; font-size:14px; cursor:pointer;">
                Cancel
            </button>
            <button onclick="submitReviewRequest()" 
                    style="background:#000; color:#fff; padding:12px 24px; border-radius:8px; border:none; font-size:14px; cursor:pointer;">
                Submit
            </button>
        </div>

    </div>
</div>

<!-- NOTE SAVED MODAL (RESTORED) -->
<div id="noteSavedModal" class="notes-modal-overlay">
    <div class="notes-modal-container">
        <h3>✅ Note Saved!</h3>
        <p class="saved-note-order">Note saved for order #<span id="noteSavedOrderId"></span></p>
        <div class="saved-note-box">
            <p id="noteSavedMessage"></p>
        </div>
        <div style="text-align: center; margin-top: 20px;">
            <button id="noteSavedOkBtn" style="background: black; color: white; padding: 12px 24px; border-radius: 8px; border: none; font-size: 14px; cursor: pointer;">Okay</button>
        </div>
    </div>
</div>

<!-- ===== DOWNLOAD RECEIPT MODAL ===== -->
<div id="downloadReceiptModal" class="notes-modal-overlay">
    <div class="notes-modal-container">

        <!-- HEADER -->
        <div class="notes-header">
            <h3>🧾 Download Receipt</h3>
            <span class="notes-close" onclick="closeDownloadReceiptModal()">✕</span>
        </div>

        <!-- ORDER INFO -->
        <div class="receipt-info">
            <p><strong>Order #:</strong> <span id="receiptOrderId">12345</span></p>
            <p><strong>Customer:</strong> <span id="receiptCustomer">Harvy</span></p>
            <p><strong>Date:</strong> <span id="receiptDate">Mar 02, 2026</span></p>
            <p><strong>Total:</strong> ₱<span id="receiptTotal">2,600.00</span></p>
        </div>

        <!-- ITEMS TABLE -->
        <div class="summary-items">
            <table>
                <thead>
                    <tr>
                        <th>Item</th>
                        <th>Qty</th>
                        <th>Price</th>
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody id="receiptItemsBody">
                    <!-- Items will be dynamically inserted via JS -->
                </tbody>
            </table>
        </div>

        <!-- ACTIONS -->
        <div class="notes-actions" style="justify-content:center;">
            <button onclick="closeDownloadReceiptModal()" 
                    style="background:#e5e7eb; color:#111; padding:12px 24px; border-radius:8px; border:none; font-size:14px; cursor:pointer;">
                Close
            </button>

            <button onclick="downloadReceipt()" 
                    style="background:black; color:white; padding:12px 24px; border-radius:8px; border:none; font-size:14px; cursor:pointer;">
                Download PDF
            </button>
        </div>

    </div>
</div>

<div id="confirmShipmentModal" class="bw-modal-overlay">
    <div class="bw-modal-container bw-confirm-container">
        <div class="bw-modal-header">
            <h3>Confirm Shipment</h3>
            <span class="bw-close" onclick="closeConfirmShipmentModal()">&times;</span>
        </div>
        <div class="bw-info-box">
            <p>Are you sure you want to mark order #<span id="confirmShipOrderId">00000</span> as shipped?</p>
        </div>
        <div class="bw-actions">
            <button class="bw-btn cancel" onclick="closeConfirmShipmentModal()">Cancel</button>
            <button class="bw-btn confirm" onclick="completeShipment()">Confirm</button>
        </div>
    </div>
</div>

<div id="trackingRequiredModal" class="bw-modal-overlay">
    <div class="bw-modal-container bw-confirm-container">
        <div class="bw-modal-header">
            <h3 class="bw-error-icon">X</h3>
            <span class="bw-close" onclick="closeTrackingRequiredModal()">&times;</span>
        </div>
        <div class="bw-info-box">
            <p>Tracking number is required.</p>
        </div>
        <div class="bw-actions">
            <button class="bw-btn confirm" onclick="closeTrackingRequiredModal()">Okay</button>
        </div>
    </div>
</div>

<!-- ===== MARK AS RETURNED MODAL ===== -->
<div id="markReturnedModal" class="bw-modal-overlay">
    <div class="bw-modal-container">
        <div class="bw-modal-header">
            <h3>Mark Order #<span id="returnOrderId">00000</span> as Returned</h3>
            <span class="bw-close" onclick="closeReturnModal()">&times;</span>
        </div>

        <div class="bw-info-box bw-fulfillment-box">
            <p><strong>Customer:</strong> <span id="returnCustomer">---</span></p>
            <p><strong>Product:</strong> <span id="returnProduct">---</span></p>
            <p><strong>Quantity:</strong> <span id="returnItems">0</span></p>
            <p><strong>Total:</strong> <span id="returnTotal">P0.00</span></p>
            <p><strong>Courier:</strong> <span id="returnCourier">---</span></p>
            <p><strong>Tracking #:</strong> <span id="returnTracking">---</span></p>
        </div>

        <div class="bw-field">
            <label for="returnReason">Reason <span class="required">*</span></label>
            <select id="returnReason">
                <option value="">-- Select Reason --</option>
                <option value="Buyer Unreachable">Buyer Unreachable</option>
                <option value="Invalid Address">Invalid Address</option>
                <option value="Refused to Accept">Refused to Accept</option>
                <option value="Other Courier Failure">Other Courier Failure</option>
            </select>
        </div>

        <div class="bw-field">
            <label for="returnNote">Notes</label>
            <textarea id="returnNote" rows="4" placeholder="Add optional notes about the failed delivery and returned package."></textarea>
        </div>

        <div class="bw-field">
            <label>Proof Image</label>
            <div class="bw-upload-box" id="returnUploadBox">
                <input type="file" id="returnProof" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" hidden />
                <p>Drag or click to upload proof (JPG, PNG, WEBP up to 5MB)</p>
            </div>
            <div id="returnPreviewContainer" style="display:none;">
                <img id="returnPreviewImage" alt="Return proof preview" />
                <button type="button" class="remove-preview-btn" onclick="removeReturnPreview()">Remove</button>
            </div>
        </div>

        <div class="bw-actions">
            <button class="bw-btn cancel" type="button" onclick="closeReturnModal()">Cancel</button>
            <button class="bw-btn confirm" type="button" id="confirmReturnBtn" onclick="submitReturnedOrder()">Confirm</button>
        </div>
    </div>
</div>

<div id="returnedInfoModal" class="bw-modal-overlay">
    <div class="bw-modal-container bw-confirm-container">
        <div class="bw-modal-header bw-centered-header">
            <h3>Returned Order #<span id="returnInfoOrderId">00000</span></h3>
            <span class="bw-close" onclick="closeReturnedInfoModal()">&times;</span>
        </div>
        <div class="bw-info-box bw-fulfillment-box">
            <p><strong>Customer:</strong> <span id="returnInfoCustomer">---</span></p>
            <p><strong>Product:</strong> <span id="returnInfoProduct">---</span></p>
            <p><strong>Quantity:</strong> <span id="returnInfoQuantity">0</span></p>
            <p><strong>Total:</strong> <span id="returnInfoTotal">0.00</span></p>
            <p><strong>Courier:</strong> <span id="returnInfoCourier">---</span></p>
            <p><strong>Tracking #:</strong> <span id="returnInfoTracking">---</span></p>
            <p><strong>Reason:</strong> <span id="returnInfoReason">---</span></p>
            <div class="bw-proof-block" id="returnInfoProofBlock" style="display:none;">
                <p class="bw-section-title">Proof</p>
                <img id="returnInfoProofImage" class="bw-proof-image" src="" alt="Return proof" />
            </div>
            <div class="bw-note-block">
                <p class="bw-section-title">Note</p>
                <p id="returnInfoNote">---</p>
            </div>
        </div>
        <div class="bw-actions">
            <button class="bw-btn confirm" type="button" onclick="closeReturnedInfoModal()">Close</button>
        </div>
    </div>
</div>
</div>

<!-- add note -->
<div id="addNotesModal" class="notes-modal-overlay" style="display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 9999; background: rgba(0,0,0,0.5); justify-content: center; align-items: center;">
    <div class="notes-modal-container" style="background: white; padding: 20px; border-radius: 8px; width: 400px;">
        
        <input type="hidden" id="addNotesOrderId" value="" />

        <div class="notes-header" style="display: flex; justify-content: space-between;">
            <h3 id="customerHeaderText">Customer: </h3>
            <span class="notes-close" onclick="closeAddNotesModal()" style="cursor: pointer;">✕</span>
        </div>

        <div class="customer-card">
            <div class="customer-avatar">
                <img src="~/images/profile-icon.png" alt="Profile" /> 
            </div>
            <div class="customer-info">
                <p id="addNotesCustomerText"></p>
            </div>
        </div>


        <div class="notes-body">
            <label>Add Note</label>
            <textarea id="addNotesTextarea" maxlength="500" placeholder="Type your message..." style="width: 100%; height: 100px;"></textarea>
            <div class="notes-footer">
                <span id="charCount">0/500</span>
            </div>
        </div>

        <div class="notes-actions" style="margin-top: 15px; display: flex; justify-content: flex-end; gap: 10px;">
            <button id="addNotesCancelBtn" onclick="closeAddNotesModal()">Cancel</button>
            <button id="addNotesSaveBtn" onclick="saveOrderNote()" class="btn-primary">Save Note</button>
        </div>
    </div>
</div>
<div id="declineOrderModal" style="display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 9999; background: rgba(0,0,0,0.5); justify-content: center; align-items: center;">
    <div style="background: white; padding: 24px; border-radius: 12px; width: 450px; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
        
        <input type="hidden" id="declineOrderId" value="" />

        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
            <h3 style="margin: 0; color: #111827;">Decline Order #<span id="declineOrderNumberDisplay"></span></h3>
            <span onclick="closeDeclineModal()" style="cursor: pointer; font-size: 1.2rem; color: #6b7280;">✕</span>
        </div>

        <p style="color: #4b5563; font-size: 0.9rem; margin-bottom: 16px;">Please select a reason for declining this order. This action cannot be undone and the customer will be notified.</p>

        <div style="display: flex; flex-direction: column; gap: 12px; margin-bottom: 20px;">
            <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                <input type="radio" name="declineReason" value="Out of Stock" onchange="toggleDeclineTextarea()" checked>
                Out of Stock
            </label>
            <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                <input type="radio" name="declineReason" value="Invalid Delivery Address" onchange="toggleDeclineTextarea()">
                Invalid Delivery Address
            </label>
            <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                <input type="radio" name="declineReason" value="Customer Requested Cancellation" onchange="toggleDeclineTextarea()">
                Customer Requested Cancellation
            </label>
            <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                <input type="radio" name="declineReason" value="Other" onchange="toggleDeclineTextarea()">
                Other
            </label>
        </div>

        <div id="customReasonContainer" style="display: none; margin-bottom: 20px;">
            <textarea id="customDeclineReason" placeholder="Please specify the reason..." style="width: 100%; padding: 10px; border: 1px solid #d1d5db; border-radius: 6px; height: 80px;"></textarea>
        </div>

        <div style="display: flex; justify-content: flex-end; gap: 12px;">
            <button onclick="closeDeclineModal()" style="padding: 10px 16px; border: 1px solid #d1d5db; background: white; border-radius: 6px; cursor: pointer;">Cancel</button>
            <button onclick="submitDeclineOrder()" style="padding: 10px 16px; border: none; background: #ef4444; color: white; border-radius: 6px; cursor: pointer; font-weight: bold;">Confirm Decline</button>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/ordermanagement.js" asp-append-version="true"></script>
    
    <div id="toastContainer" style="position: fixed; bottom: 24px; right: 24px; z-index: 10000; display: flex; flex-direction: column; gap: 12px;"></div>
}

<script>
    setTimeout(() => {
        if (typeof window.applyOrderFilters === 'undefined') {
            console.error("🚨 CRITICAL: ordermanagement.js failed to load. Check for syntax errors or 404 paths.");
            alert("Warning: JavaScript failed to load. Check developer console.");
        } else {
            console.log("✅ JS LOADED AND CONNECTED!");
        }
    }, 500);
</script>









