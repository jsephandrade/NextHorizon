@model NextHorizon.Models.SellerDashboardViewModel
@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}
@{
    ViewData["Title"] = "Order Management";
    ViewData["DashboardHeading"] = "Order Management";
    ViewData["SellerName"] = Model.SellerName;
}

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&amp;display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/css/ordermanagement.css" />

<div class="order-filters">
    <button class="order-filter-btn active" data-filter="all">All Orders</button>
    <button class="order-filter-btn" data-filter="pending">Pending</button>
    <button class="order-filter-btn" data-filter="to-ship">To Ship</button>
    <button class="order-filter-btn" data-filter="shipped">Shipped</button>
    <button class="order-filter-btn" data-filter="delivered">Delivered</button>
    <button class="order-filter-btn" data-filter="cancelled">Cancelled</button>
    <button class="order-filter-btn" data-filter="return">Return</button>
</div>

<div class="order-toolbar">

    <!-- SEARCH -->
    <div class="search-box">
        <input type="search" id="orderSearch" placeholder="Search orders..." />
        <button id="searchBtn">Search</button>
    </div>

    <!-- CATEGORY -->
    <select id="categoryFilter" class="order-select">
        <option value="all">All Categories</option>
        <option value="footwear">Footwear</option>
        <option value="apparel">Apparel</option>
        <option value="accessories">Accessories</option>
    </select>

    <!-- DATE FILTER -->
    <div class="date-filter">
        <input type="date" id="startDate">
        <span>to</span>
        <input type="date" id="endDate">
        <button id="clearDate">Clear</button>
    </div>

</div>

<table class="order-table">
    <thead>
        <tr>
            <th>Order ID</th>
            <th>Customer</th>
            <th>Date</th>
            <th>Product</th>
            <th>Qty</th>
            <th>Total</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model.Orders)
        {
            <tr class="order-row"
                data-order-id="@order.OrderId"
                data-status="@order.FulfillmentStatus.ToLower().Replace(" ", "-")"
                data-courier="@order.Courier"
                data-tracking="@order.TrackingNumber"
                data-return-proof="@order.ReturnProofImage"
                data-return-note="@order.ReturnNote">

                <td>@order.OrderId</td>
                <td>@order.Customer</td>
                <td>@order.DateTime.ToString("MMM dd, yyyy")</td>

                <!-- PRODUCT WITH IMAGE -->
                <td class="product-cell">
                    <img src="https://picsum.photos/50" class="product-img" />
                    <span>@order.ProductName</span>
                </td>

                <td>@order.Quantity</td>
                <td>₱@order.TotalAmount.ToString("N2")</td>
                <td>
                    <span class="status-badge @order.FulfillmentStatus.ToLower().Replace(" ", "-")">
                        @order.FulfillmentStatus
                    </span>
                </td>

                <td>
                    <div class="action-menu-wrap">
                        <button class="action-icon-btn">⋮</button>

                            <div class="action-menu">
                            @* VIEW DETAILS - always visible *@
                            <a class="action-menu-item"
                            asp-controller="Dashboard"
                            asp-action="OrderDetails"
                            asp-route-id="@order.OrderId">
                                View Details
                            </a>

                            @* CONTACT CUSTOMER - always visible *@
                            <button class="action-menu-item"
                                    onclick="window.location.href='@Url.Action("Messenger","Seller")'">
                                Contact Customer
                            </button>

                            @* VIEW ORDER - only for Pending *@
                            @if(order.FulfillmentStatus == "Pending")
                            {
                                <button class="action-menu-item view-order-btn"
                                        data-order-id="@order.OrderId">
                                    View Order
                                </button>

                                <button class="action-menu-item decline-order-btn"
                                        data-order-id="@order.OrderId"
                                        data-customer="@order.Customer">
                                    Decline Order
                                </button>
                            }

                            @if(order.FulfillmentStatus == "To Ship")
                            {
                                <button class="action-menu-item mark-as-shipped-btn"
                                        data-order-id="@order.OrderId">
                                    Mark as Shipped
                                </button>
                            }

                            @if(order.FulfillmentStatus == "Shipped")
                            {
                                <button class="action-menu-item mark-returned-btn"
                                        data-order-id="@order.OrderId">
                                    Mark as Returned
                                </button>
                            }

                            @* ADD NOTE - for Pending, To Ship, Shipped, Completed/Delivered *@
                            @if(order.FulfillmentStatus == "Pending" 
                            || order.FulfillmentStatus == "To Ship"
                            || order.FulfillmentStatus == "Shipped"
                            || order.FulfillmentStatus == "Delivered")
                            {
                                <button class="action-menu-item add-note-btn"
                                        data-order-id="@order.OrderId"
                                        data-customer="@order.Customer">
                                    Add Note
                                </button>
                            }

                            @* DOWNLOAD RECEIPT - only for Completed/Delivered *@
                            @if(order.FulfillmentStatus == "Delivered")
                            {
                                <button class="action-menu-item download-receipt-btn"
                                        onclick='openDownloadReceiptModal(@Html.Raw(Json.Serialize(order)))'>
                                    Download Receipt
                                </button>
                            }

                        </div>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- ===== ORDER SUMMARY MODAL ===== -->
<div id="orderSummaryModal" class="modal-overlay">
    <div class="order-summary-container">

        <!-- HEADER -->
        <div class="summary-header">
            <h3>Order Summary - Order #<span id="summaryOrderId">061231</span></h3>
            <span class="close-btn" onclick="closeOrderSummaryModal()">✖</span>
        </div>

        <!-- ORDER DETAILS -->
        <div class="summary-box">
            <div class="summary-row">
                <div>
                    <p>Order Date</p>
                    <strong>March 2, 2026</strong>
                </div>
                <div>
                    <p>Payment</p>
                    <strong>COD</strong>
                </div>
                <div>
                    <p>Total</p>
                    <strong>₱2,600.00</strong>
                </div>
                <div>
                    <p>Status</p>
                    <span class="status-badge pending">PENDING</span>
                </div>
            </div>
        </div>

        <!-- ITEMS -->
        <div class="summary-items">
            <table>
                <thead>
                    <tr>
                        <th>Item</th>
                        <th>Qty</th>
                        <th>Price</th>
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Comfort Sculpt Seamless Bra</td>
                        <td>x4</td>
                        <td>₱650</td>
                        <td>₱2,600</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- CUSTOMER -->
        <div class="summary-box">
            <p><strong>Customer:</strong> Harvy</p>
            <p><strong>Address:</strong> Mandaue, Philippines</p>
        </div>

        <!-- COURIER -->
        <div class="summary-box">
            <label>Preferred Courier</label>
            <div class="courier-row">
                <select id="courierSelect">
                    <option>J&T Express</option>
                    <option>Flash Express</option>
                    <option>LBC</option>
                </select>
                <button class="add-courier-btn">+ Add</button>
            </div>
        </div>

        <!-- ACTIONS -->
        <div class="summary-actions">
            <button class="btn-cancel"
                onclick="openDeclineModal(
                    document.getElementById('summaryOrderId').textContent,
                    'Sample Customer' /* replace later if dynamic */
                )">
                Decline Order
            </button>
            <button class="btn-confirm" onclick="confirmOrder()">Confirm & Accept</button>
        </div>

    </div>
</div>


<!-- ===== PROCESSING MODAL ===== -->
<div id="processingModal" class="modal-overlay">
    <div class="processing-box">
        <div class="loader"></div>
        <h3>Processing Order...</h3>
        <p>Step 5: System Execution (Automated)</p>

        <ul>
            <li>✔ Updating Status to TO SHIP</li>
            <li>✔ Deducting Live Inventory</li>
            <li>✔ Sending Buyer Notification</li>
        </ul>
    </div>
</div>

<!-- ORDER MOVED TO TO SHIP MODAL -->
<div id="orderToShipModal" class="notes-modal-overlay">
    <div class="notes-modal-container">
        <h3>📦 Order Updated!</h3>
        <p id="toShipMessage">Order #12345 has been moved to TO SHIP.</p>
        <div style="text-align: center; margin-top: 20px;">
            <button id="toShipOkBtn" 
                    style="background: #3b82f6; color: white; padding: 12px 24px; border-radius: 8px; border: none; font-size: 14px; cursor: pointer;">
                OK
            </button>
        </div>
    </div>
</div>

<!-- ADD NOTE MODAL -->
<div id="addNotesModal" class="notes-modal-overlay">
    <div class="notes-modal-container">

        <!-- ADD NOTE MODAL HEADER -->
        <div class="notes-header">
            <h3 id="customerHeaderText">Customer: </h3> <!-- This will show: Customer: Kiboy - Order #123 -->
            <span class="notes-close" onclick="closeAddNotesModal()">✕</span>
        </div>

        <!-- CUSTOMER CARD -->
        <div class="customer-card">
            <div class="customer-avatar">
                <img src="~/images/profile-icon.png" alt="Profile" /> <!-- replace with your profile icon -->
            </div>
            <div class="customer-info">
                <p id="addNotesCustomerText"></p> <!-- optional: duplicate info if needed -->
            </div>
        </div>

        <!-- ADD NOTE -->
        <div class="notes-body">
            <label>Add Note</label>

            <textarea id="addNotesTextarea"
                      maxlength="500"
                      placeholder="Type your message..."></textarea>

            <div class="notes-footer">
                <span>Type special instruction or reminders here...</span>
                <span id="charCount">0/500</span>
            </div>
        </div>

        <!-- ACTIONS -->
        <div class="notes-actions">
            <button id="addNotesCancelBtn">Cancel</button>
            <button id="addNotesSaveBtn">Save Note</button>
        </div>

    </div>
</div>

<!-- ===== REVIEW REQUEST MODAL ===== -->
<div id="reviewRequestModal" class="notes-modal-overlay">
    <div class="notes-modal-container">

        <!-- HEADER -->
        <div class="notes-header">
            <h3>📝 Review Request</h3>
            <span class="notes-close" onclick="closeReviewRequestModal()">✕</span>
        </div>

        <!-- ORDER & CUSTOMER INFO -->
        <div class="review-info">
            <p><strong>Order #:</strong> <span id="reviewOrderId">12345</span></p>
            <p><strong>Customer:</strong> <span id="reviewCustomer">Harvy</span></p>
            <p><strong>Product:</strong> <span id="reviewProduct">Comfort Sculpt Bra</span></p>
            <p><strong>Return Reason:</strong> <span id="reviewReason">Wrong Size</span></p>
        </div>

        <!-- ATTACHED PHOTOS -->
        <div class="review-attachments">
            <p><strong>Customer Proof:</strong></p>
            <div id="reviewPhotos" class="photo-grid">
                <!-- Customer photos will be inserted dynamically -->
            </div>
        </div>

        <!-- COMMENT -->
        <div class="review-comment">
            <div class="review-comment-header">
                <p class="review-comment-title">Seller Comment</p>
                <span class="review-comment-hint">Optional, but useful for explaining your decision.</span>
            </div>
            <textarea id="reviewComment" placeholder="Add comment (optional)..."></textarea>
        </div>

        <!-- DECISION -->
        <div class="review-decision">
            <label>
                <input type="radio" name="reviewDecision" value="approve"> Approve
            </label>
            <label>
                <input type="radio" name="reviewDecision" value="reject"> Reject
            </label>
        </div>

        <!-- ACTIONS -->
        <div class="notes-actions" style="justify-content: center;">
            <button onclick="closeReviewRequestModal()" 
                    style="background:#e5e7eb; color:#111; padding:12px 24px; border-radius:8px; border:none; font-size:14px; cursor:pointer;">
                Cancel
            </button>
            <button onclick="submitReviewRequest()" 
                    style="background:#000; color:#fff; padding:12px 24px; border-radius:8px; border:none; font-size:14px; cursor:pointer;">
                Submit
            </button>
        </div>

    </div>
</div>

<!-- NOTE SAVED MODAL (RESTORED) -->
<div id="noteSavedModal" class="notes-modal-overlay">
    <div class="notes-modal-container">
        <h3>✅ Note Saved!</h3>
        <p class="saved-note-order">Note saved for order #<span id="noteSavedOrderId"></span></p>
        <div class="saved-note-box">
            <p id="noteSavedMessage"></p>
        </div>
        <div style="text-align: center; margin-top: 20px;">
            <button id="noteSavedOkBtn" style="background: black; color: white; padding: 12px 24px; border-radius: 8px; border: none; font-size: 14px; cursor: pointer;">Okay</button>
        </div>
    </div>
</div>

<!-- ===== DOWNLOAD RECEIPT MODAL ===== -->
<div id="downloadReceiptModal" class="notes-modal-overlay">
    <div class="notes-modal-container">

        <!-- HEADER -->
        <div class="notes-header">
            <h3>🧾 Download Receipt</h3>
            <span class="notes-close" onclick="closeDownloadReceiptModal()">✕</span>
        </div>

        <!-- ORDER INFO -->
        <div class="receipt-info">
            <p><strong>Order #:</strong> <span id="receiptOrderId">12345</span></p>
            <p><strong>Customer:</strong> <span id="receiptCustomer">Harvy</span></p>
            <p><strong>Date:</strong> <span id="receiptDate">Mar 02, 2026</span></p>
            <p><strong>Total:</strong> ₱<span id="receiptTotal">2,600.00</span></p>
        </div>

        <!-- ITEMS TABLE -->
        <div class="summary-items">
            <table>
                <thead>
                    <tr>
                        <th>Item</th>
                        <th>Qty</th>
                        <th>Price</th>
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody id="receiptItemsBody">
                    <!-- Items will be dynamically inserted via JS -->
                </tbody>
            </table>
        </div>

        <!-- ACTIONS -->
        <div class="notes-actions" style="justify-content:center;">
            <button onclick="closeDownloadReceiptModal()" 
                    style="background:#e5e7eb; color:#111; padding:12px 24px; border-radius:8px; border:none; font-size:14px; cursor:pointer;">
                Close
            </button>

            <button onclick="downloadReceipt()" 
                    style="background:black; color:white; padding:12px 24px; border-radius:8px; border:none; font-size:14px; cursor:pointer;">
                Download PDF
            </button>
        </div>

    </div>
</div>

<!-- ===== MARK AS SHIPPED MODAL ===== -->
<div id="markShippedModal" class="bw-modal-overlay">
    <div class="bw-modal-container">

        <!-- HEADER -->
        <div class="bw-modal-header">
            <h3>Mark Order #<span id="shipOrderId">00000</span> as Shipped</h3>
            <span class="bw-close" onclick="closeMarkShippedModal()">✕</span>
        </div>

        <!-- ORDER INFO -->
        <div class="bw-info-box">
            <p><strong>Customer:</strong> <span id="shipCustomer">---</span></p>
            <p><strong>Items:</strong> <span id="shipItems">0</span></p>
            <p><strong>Total:</strong> ₱<span id="shipTotal">0.00</span></p>
            <p><strong>Staff:</strong> <span>@Model.SellerName</span></p>
        </div>

        <!-- COURIER -->
        <div class="bw-field">
            <label>Courier Name</label>
            <input type="text" id="courierName" value="J&T Express" />
        </div>

        <!-- TRACKING -->
        <div class="bw-field">
            <label>Tracking Number <span class="required">*</span></label>
            <input type="text" id="trackingNumber" placeholder="e.g., J&T-123456789" />
        </div>

        <!-- DATE -->
        <div class="bw-field">
            <label>Actual Shipment Date</label>
            <input type="date" id="shipmentDate" />
        </div>

        <!-- NOTES -->
        <div class="bw-field">
            <label>Additional Shipment Notes</label>
            <textarea id="shipmentNotes"
                      placeholder="Enter branch location, staff details, or any specifics here."></textarea>
        </div>

        <!-- ACTIONS -->
        <div class="bw-actions">
            <button class="bw-btn cancel" onclick="closeMarkShippedModal()">Cancel</button>
            <button class="bw-btn confirm" onclick="confirmShipment()">Confirm Shipment</button>
        </div>

    </div>
</div>

<div id="confirmShipmentModal" class="bw-modal-overlay">
    <div class="bw-modal-container bw-confirm-container">
        <div class="bw-modal-header">
            <h3>Confirm Shipment</h3>
            <span class="bw-close" onclick="closeConfirmShipmentModal()">&times;</span>
        </div>
        <div class="bw-info-box">
            <p>Are you sure you want to mark order #<span id="confirmShipOrderId">00000</span> as shipped?</p>
        </div>
        <div class="bw-actions">
            <button class="bw-btn cancel" onclick="closeConfirmShipmentModal()">Cancel</button>
            <button class="bw-btn confirm" onclick="completeShipment()">Confirm</button>
        </div>
    </div>
</div>

<div id="trackingRequiredModal" class="bw-modal-overlay">
    <div class="bw-modal-container bw-confirm-container">
        <div class="bw-modal-header">
            <h3 class="bw-error-icon">X</h3>
            <span class="bw-close" onclick="closeTrackingRequiredModal()">&times;</span>
        </div>
        <div class="bw-info-box">
            <p>Tracking number is required.</p>
        </div>
        <div class="bw-actions">
            <button class="bw-btn confirm" onclick="closeTrackingRequiredModal()">Okay</button>
        </div>
    </div>
</div>

<!-- ===== MARK AS RETURNED MODAL ===== -->
<div id="markReturnedModal" class="bw-modal-overlay">
    <div class="bw-modal-container">

        <!-- HEADER -->
        <div class="bw-modal-header">
            <h3>Mark Order #<span id="returnOrderId">00000</span> as Returned</h3>
            <span class="bw-close" onclick="closeReturnModal()">✕</span>
        </div>

        <!-- ORDER INFO -->
        <div class="bw-info-box">
            <p><strong>Order #:</strong> <span id="returnOrderText">00000</span></p>
            <p><strong>Customer:</strong> <span id="returnCustomer">---</span></p>
            <p><strong>Items:</strong> <span id="returnItems">0</span></p>
            <p><strong>Total:</strong> <span id="returnTotal">₱0.00</span></p>
        </div>

        <!-- RETURN REASON -->
        <div class="bw-field">
            <label>Select Return Reason <span class="required">*</span></label>
            <select id="returnReason">
                <option value="">-- Select Reason --</option>
                <option>Buyer Unreachable</option>
                <option>Invalid Address</option>
                <option>Buyer Refused Package</option>
                <option>Courier Issue</option>
            </select>
        </div>

        <!-- UPLOAD PROOF -->
        <div class="bw-field">
            <label>Upload Proof of Delivery Attempt (Optional)</label>

            <div class="bw-upload-box" id="uploadBox">
                <input type="file" id="returnProof" accept="image/*" hidden />
                <p>Drag or click to upload proof (JPG/PNG up to 5MB)</p>
            </div>

            <div id="previewContainer"></div>
        </div>

        <!-- ACTIONS -->
        <div class="bw-actions">
            <button class="bw-btn cancel" onclick="closeReturnModal()">Cancel</button>
            <button class="bw-btn confirm" onclick="confirmReturn()">Confirm Return & Restock</button>
        </div>

    </div>
</div>

<div id="returnedInfoModal" class="bw-modal-overlay">
    <div class="bw-modal-container bw-confirm-container">
        <div class="bw-modal-header bw-centered-header">
            <h3>Mark Order #<span id="returnInfoOrderId">00000</span> as Returned</h3>
            <span class="bw-close" onclick="closeReturnedInfoModal()">&times;</span>
        </div>
        <div class="bw-info-box bw-fulfillment-box">
            <p class="bw-section-title">Fulfillment Info</p>
            <p><strong>Customer:</strong> <span id="returnInfoCustomer">---</span></p>
            <p><strong>Product:</strong> <span id="returnInfoProduct">---</span></p>
            <p><strong>Quantity:</strong> <span id="returnInfoQuantity">0</span></p>
            <p><strong>Total:</strong> <span id="returnInfoTotal">0.00</span></p>
            <p><strong>Courier:</strong> <span id="returnInfoCourier">J&amp;T Express</span></p>
            <p><strong>Tracking #:</strong> <span id="returnInfoTracking">123456789</span></p>
            <div class="bw-proof-block">
                <p class="bw-section-title">Proof</p>
                <img id="returnInfoProofImage" class="bw-proof-image" src="https://picsum.photos/seed/return-proof-1/360/220" alt="Return proof" />
            </div>
            <div class="bw-note-block">
                <p class="bw-section-title">Note</p>
                <p id="returnInfoNote">Package was sent back because the buyer could not be reached.</p>
            </div>
        </div>
        <div class="bw-actions">
            <button class="bw-btn cancel" onclick="closeReturnedInfoModal()">Cancel</button>
            <button class="bw-btn confirm" onclick="confirmReturn()">Mark as Returned</button>
        </div>
    </div>
</div>

<div id="confirmReturnModal" class="bw-modal-overlay">
    <div class="bw-modal-container bw-confirm-container">
        <div class="bw-modal-header">
            <h3>Return Confirmed</h3>
            <span class="bw-close" onclick="closeConfirmReturnModal()">&times;</span>
        </div>
        <div class="bw-info-box">
            <p>Order #<span id="confirmReturnOrderId">00000</span> has been moved to Return status.</p>
        </div>
        <div class="bw-actions">
            <button class="bw-btn confirm" onclick="closeConfirmReturnModal()">Okay</button>
        </div>
    </div>
</div>

<!-- ===== DECLINE ORDER MODAL ===== -->
<div id="declineOrderModal" class="notes-modal-overlay">
    <div class="notes-modal-container">

        <!-- HEADER -->
        <div class="notes-header">
            <h3>❌ Decline Order</h3>
            <span class="notes-close" onclick="closeDeclineModal()">✕</span>
        </div>

        <!-- ORDER INFO -->
        <div class="review-info">
            <p><strong>Order #:</strong> <span id="declineOrderId">00000</span></p>
            <p><strong>Customer:</strong> <span id="declineCustomer">---</span></p>
        </div>

        <!-- REASON -->
        <div class="notes-body">
            <label>Select Reason <span style="color:red">*</span></label>

            <select id="declineReason" style="width:100%; padding:10px; border-radius:8px; border:1px solid #ccc;">
                <option value="">-- Select Reason --</option>
                <option>Out of Stock</option>
                <option>Invalid Order</option>
                <option>Pricing Error</option>
                <option>Delivery Not Available</option>
                <option>Other</option>
            </select>

            <textarea id="declineMessage"
                      placeholder="Add additional details (optional)..."
                      style="margin-top:10px;"></textarea>
        </div>

        <!-- ACTIONS -->
        <div class="notes-actions">
            <button onclick="closeDeclineModal()">Cancel</button>
            <button onclick="submitDeclineOrder()" style="background:black; color:white;">
                Confirm Decline
            </button>
        </div>

    </div>
</div>

<!-- ===== DECLINE WARNING MODAL ===== -->
<div id="declineWarningModal" class="notes-modal-overlay">
    <div class="notes-modal-container" style="max-width:400px; text-align:center;">

        <!-- HEADER -->
        <div class="notes-header" style="justify-content:center;">
            <h3 style="color:black;">⚠ Missing Reason</h3>
        </div>

        <!-- MESSAGE -->
        <div class="notes-body">
            <p>Please select a reason before declining the order.</p>
        </div>

        <!-- ACTION -->
        <div class="notes-actions" style="justify-content:center;">
            <button class="btn-confirm" onclick="closeDeclineWarningModal()"
                style="background:black; color:white; padding:12px 24px; border-radius:8px; border:none; font-size:14px; cursor:pointer;">
                Okay
            </button>
        </div>

    </div>
</div>

<script src="@Url.Content("~/js/ordermanagement.js")"></script>
