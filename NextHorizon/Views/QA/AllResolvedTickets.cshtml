@{
    ViewData["Title"] = "Resolved Tickets Awaiting QA";
    Layout = "~/Views/Shared/_QALayout.cshtml";
}

@section Styles {
<style>
    .page-wrap {
        background: #ffffff;
        border: 1px solid rgba(0, 0, 0, 0.12);
        border-radius: 14px;
        padding: 16px;
    }

    .head {
        display: grid;
        gap: 10px;
        margin-bottom: 12px;
    }

    .head h2 {
        font-size: 1.3rem;
        margin: 0;
    }

    .head-sub {
        color: #666666;
        font-size: .85rem;
    }

    .progress-sub {
        font-size: .82rem;
        font-weight: 600;
        color: #333333;
        background: #f3f3f3;
        border: 1px solid rgba(0, 0, 0, 0.12);
        border-radius: 999px;
        padding: 6px 10px;
        width: fit-content;
    }

    .filters {
        display: grid;
        gap: 8px;
    }

    .filter-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 8px;
    }

    .filter-input,
    .filter-select {
        width: 100%;
        border: 1px solid rgba(0, 0, 0, 0.18);
        border-radius: 10px;
        padding: 8px 10px;
        font-size: .82rem;
        background: #ffffff;
        color: #222222;
    }

    .search-wrap {
        position: relative;
    }

    .search-wrap i {
        position: absolute;
        left: 10px;
        top: 50%;
        transform: translateY(-50%);
        color: #777777;
        font-size: .85rem;
    }

    .search {
        width: 100%;
        border: 1px solid rgba(0, 0, 0, 0.18);
        border-radius: 10px;
        padding: 9px 12px 9px 30px;
        font-size: .86rem;
        background: #ffffff;
    }

    .btn {
        text-decoration: none;
        border-radius: 10px;
        padding: 8px 12px;
        background: #111111;
        color: #ffffff;
        font-weight: 600;
        font-size: .82rem;
    }

    .tickets {
        display: grid;
        gap: 10px;
    }

    .ticket {
        border: 1px solid rgba(0, 0, 0, 0.1);
        border-radius: 12px;
        padding: 12px;
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 8px;
        align-items: center;
        background: #f7f7f7;
    }

    .name { font-weight: 700; color: #111111; }
    .sub { color: #666666; }

    .empty-state {
        display: none;
        border: 1px dashed rgba(0, 0, 0, 0.2);
        border-radius: 12px;
        padding: 14px;
        color: #555555;
        background: #fafafa;
        font-size: .86rem;
    }

    .pager {
        display: none;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-top: 12px;
        flex-wrap: wrap;
    }

    .pager-pages {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .pager-btn {
        border: 1px solid rgba(0, 0, 0, 0.14);
        background: #ffffff;
        color: #111111;
        border-radius: 10px;
        padding: 8px 12px;
        font-size: .82rem;
        font-weight: 600;
        cursor: pointer;
    }

    .pager-btn.active {
        background: #111111;
        color: #ffffff;
    }

    .pager-btn:disabled {
        background: #e5e5e5;
        color: #8a8a8a;
        cursor: not-allowed;
    }

    .pager-ellipsis {
        color: #666666;
        font-size: .9rem;
        padding: 0 2px;
    }

    @@media (max-width: 700px) {
        .filter-grid {
            grid-template-columns: 1fr 1fr;
        }

        .ticket {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 520px) {
        .filter-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
}

<section class="page-wrap">
    <div class="head">
        <h2>Resolved tickets awaiting QA</h2>
        <div class="head-sub">Clarification: this list means resolved tickets that still need QA review and rating.</div>
        <div id="ticket-progress" class="progress-sub">Loading queue summary...</div>
        <div class="filters">
            <div class="filter-grid">
                <select id="quick-range" class="filter-select">
                    <option id="custom-range-option" value="custom">Custom range</option>
                    <option value="today">Today</option>
                    <option value="last7">Last 7 days</option>
                    <option value="last30">Last 30 days</option>
                </select>
                <input id="from-date" class="filter-input" type="date" />
                <input id="to-date" class="filter-input" type="date" />
            </div>
            <div class="search-wrap">
                <i class="bi bi-search"></i>
                <input id="ticket-search" class="search" type="text" placeholder="Search by ticket number, concern source, or date..." />
            </div>
        </div>
    </div>

    <div class="tickets" id="ticket-list"></div>
    <div id="ticket-empty" class="empty-state">No tickets found for the selected filters.</div>
    <div id="ticket-pager" class="pager">
        <div id="pager-pages" class="pager-pages"></div>
        <button id="pager-next" class="pager-btn" type="button">Next page</button>
    </div>
</section>

<script>
    (function () {
        var progress = document.getElementById('ticket-progress');
        var input = document.getElementById('ticket-search');
        var quickRange = document.getElementById('quick-range');
        var customRangeOption = document.getElementById('custom-range-option');
        var fromDate = document.getElementById('from-date');
        var toDate = document.getElementById('to-date');
        var list = document.getElementById('ticket-list');
        var emptyState = document.getElementById('ticket-empty');
        var pager = document.getElementById('ticket-pager');
        var pagerPages = document.getElementById('pager-pages');
        var pagerNext = document.getElementById('pager-next');
        if (!progress || !input || !list || !quickRange || !customRangeOption || !fromDate || !toDate || !emptyState || !pager || !pagerPages || !pagerNext) return;

        var searchDebounceHandle = 0;
        var currentPage = 1;

        function toIsoDate(d) {
            var y = d.getFullYear();
            var m = String(d.getMonth() + 1).padStart(2, '0');
            var day = String(d.getDate()).padStart(2, '0');
            return y + '-' + m + '-' + day;
        }

        function escHtml(value) {
            return (value || '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function applyQuickRange() {
            var now = new Date();
            var selected = quickRange.value;
            if (!selected || selected === 'custom') return;

            var end = new Date(now.getFullYear(), now.getMonth(), now.getDate());
            var start = new Date(end);
            if (selected === 'today') start = end;
            else if (selected === 'last7') start.setDate(start.getDate() - 6);
            else if (selected === 'last30') start.setDate(start.getDate() - 29);

            fromDate.value = toIsoDate(start);
            toDate.value = toIsoDate(end);
        }

        function buildQueryString() {
            var query = new URLSearchParams();
            query.set('page', String(currentPage));
            query.set('range', quickRange.value || 'custom');

            if (fromDate.value) query.set('from', fromDate.value);
            if (toDate.value) query.set('to', toDate.value);

            var search = (input.value || '').trim();
            if (search) query.set('search', search);

            return query.toString();
        }

        function getVisiblePages(currentPage, totalPages) {
            var pages = [];
            var start = Math.max(1, Math.min(currentPage - 2, totalPages - 4));
            var end = Math.min(totalPages, start + 4);
            for (var page = start; page <= end; page++) {
                pages.push(page);
            }
            return pages;
        }

        function renderSummary(payload) {
            progress.textContent = (payload.ratedCount || 0) + ' tickets rated out of ' + (payload.resolvedCount || 0);
        }

        function renderPagination(payload) {
            var totalPages = payload && payload.totalPages ? payload.totalPages : 1;
            var page = payload && payload.page ? payload.page : 1;
            var visiblePages = getVisiblePages(page, totalPages);
            var html = '';
            for (var i = 0; i < visiblePages.length; i++) {
                var visiblePage = visiblePages[i];
                html += '<button class="pager-btn' + (visiblePage === page ? ' active' : '') + '" type="button" data-page="' + visiblePage + '">' + visiblePage + '</button>';
            }
            if (visiblePages.length && visiblePages[visiblePages.length - 1] < totalPages) {
                html += '<span class="pager-ellipsis">...</span>';
            }
            pagerPages.innerHTML = html;
            pagerNext.disabled = !(payload && payload.hasNext);
            pager.style.display = payload && payload.totalPendingCount > 0 && totalPages > 1 ? 'flex' : 'none';
        }

        function renderTickets(items) {
            if (!items || !items.length) {
                list.innerHTML = '';
                emptyState.style.display = 'block';
                return;
            }

            var html = '';
            for (var i = 0; i < items.length; i++) {
                var item = items[i];
                html += '<div class="ticket">';
                html += '<div><div class="name">Ticket #' + item.supportFaqId + ' - Agent: ' + escHtml(item.agentName) + ' - Concern from: ' + escHtml(item.concernFrom) + '</div>';
                html += '<div class="sub">Resolved ' + escHtml(item.resolvedAtLabel) + ', waiting QA rating</div></div>';
                html += '<a class="btn" href="/qa/rating/' + item.supportFaqId + '">Rate</a>';
                html += '</div>';
            }

            list.innerHTML = html;
            emptyState.style.display = 'none';
        }

        function loadTickets() {
            progress.textContent = 'Loading queue summary...';

            fetch('/qa/api/resolved-tickets?' + buildQueryString(), {
                headers: {
                    'Accept': 'application/json'
                }
            })
                .then(function (response) {
                    if (!response.ok) {
                        throw new Error('Resolved tickets request failed.');
                    }

                    return response.json();
                })
                .then(function (payload) {
                    currentPage = payload.page || 1;
                    renderSummary(payload);
                    renderTickets(payload.items || []);
                    renderPagination(payload);
                    emptyState.textContent = 'No tickets found for the selected filters.';
                })
                .catch(function () {
                    progress.textContent = 'Unable to load queue summary.';
                    list.innerHTML = '';
                    pager.style.display = 'none';
                    pagerPages.innerHTML = '';
                    emptyState.textContent = 'Unable to load tickets for the selected filters.';
                    emptyState.style.display = 'block';
                });
        }

        function setCustomRangeOnManualDate() {
            quickRange.value = 'custom';
        }

        function resetToFirstPage() {
            currentPage = 1;
        }

        function queueSearchReload() {
            window.clearTimeout(searchDebounceHandle);
            resetToFirstPage();
            searchDebounceHandle = window.setTimeout(loadTickets, 200);
        }

        input.addEventListener('input', queueSearchReload);
        fromDate.addEventListener('change', function () {
            setCustomRangeOnManualDate();
            resetToFirstPage();
            loadTickets();
        });
        toDate.addEventListener('change', function () {
            setCustomRangeOnManualDate();
            resetToFirstPage();
            loadTickets();
        });
        fromDate.addEventListener('focus', setCustomRangeOnManualDate);
        toDate.addEventListener('focus', setCustomRangeOnManualDate);
        fromDate.addEventListener('click', setCustomRangeOnManualDate);
        toDate.addEventListener('click', setCustomRangeOnManualDate);
        quickRange.addEventListener('change', function () {
            if (quickRange.value === 'custom') {
                fromDate.value = '';
                toDate.value = '';
            }

            applyQuickRange();
            resetToFirstPage();
            loadTickets();
        });

        pagerNext.addEventListener('click', function () {
            currentPage++;
            loadTickets();
        });

        pagerPages.addEventListener('click', function (event) {
            var target = event.target;
            if (!target || !target.matches('[data-page]')) return;
            var nextPage = parseInt(target.getAttribute('data-page') || '0', 10);
            if (!nextPage || nextPage === currentPage) return;
            currentPage = nextPage;
            loadTickets();
        });

        loadTickets();
    })();
</script>
