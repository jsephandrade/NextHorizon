<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NextHorizon</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/seller.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>

@{
    var currentAction = (ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty).ToLowerInvariant();
    var sellerName = ViewData["SellerName"]?.ToString() ?? "Seller";
    var pageHeading = ViewData["DashboardHeading"]?.ToString() ?? ViewData["Title"]?.ToString() ?? "Dashboard";
    var isMessenger = currentAction == "sellermessenger";
}

<body class="@(isMessenger ? "seller-messenger-layout" : string.Empty)">

    <div class="dashboard-container @(isMessenger ? "seller-messenger-shell" : string.Empty)">
        <aside class="sidebar @(isMessenger ? "seller-messenger-sidebar" : string.Empty)">
            <div class="logo">
                <a asp-controller="Seller" asp-action="SellerMessenger">
                    <img src="~/images/logo.png" alt="NEXT HORIZON" class="seller-logo-img" />
                </a>
            </div>

            <nav class="sidebar-nav">
                <ul>
                    <li>
                        <a href="#" class="is-placeholder"><i class="fas fa-home"></i> Dashboard</a>
                    </li>
                    <li>
                        <a href="#" class="is-placeholder"><i class="fas fa-shopping-bag"></i> Orders</a>
                    </li>
                    <li>
                        <a href="#" class="is-placeholder"><i class="fas fa-box"></i> Products</a>
                    </li>
                    <li class="@(isMessenger ? "active" : string.Empty)">
                        <a asp-controller="Seller" asp-action="SellerMessenger"><i class="fas fa-envelope"></i> Message</a>
                    </li>
                    <li>
                        <a href="#" class="is-placeholder"><i class="fas fa-wallet"></i> Finances</a>
                    </li>
                    <li>
                        <a href="#" class="is-placeholder"><i class="fas fa-chart-bar"></i> Analytics</a>
                    </li>
                </ul>
            </nav>
        </aside>

        <main class="main-content @(isMessenger ? "seller-messenger-main" : string.Empty)">
            <header class="top-header order-header @(isMessenger ? "seller-messenger-topbar" : string.Empty)">
                <h2 class="section-title">@pageHeading</h2>
                <div class="header-right">
                    <button class="icon-btn" type="button" aria-label="Notifications">
                        <i class="fas fa-bell"></i>
                    </button>
                    <button class="icon-btn" type="button" aria-label="Profile">
                        <i class="fas fa-user-circle"></i>
                    </button>
                    <div class="seller-dropdown @(isMessenger ? "seller-messenger-dropdown" : string.Empty)">
                        <span>@sellerName</span>
                        <i class="fas fa-chevron-down"></i>
                    </div>
                </div>
            </header>

            <div class="dashboard-content @(isMessenger ? "seller-messenger-content" : string.Empty)">
                @RenderBody()
            </div>
        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
