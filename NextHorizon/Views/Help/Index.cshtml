@{
    ViewData["Title"] = "Seller Help Center";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="/css/help-center.css" />
    <link rel="stylesheet" href="/css/help-center-chat.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
}

<div class="help-center-page">
    <div class="help-center-hero">
        <div>
            <p class="help-center-label">Support</p>
            <h1>Need help managing your seller account?</h1>
            <p class="help-center-subtitle">
                Explore quick answers, guides, and support options for orders, payouts, shipping, marketing, and account
                management.
            </p>
            <div class="help-search" style="margin-top:40px;">
                <i class="fas fa-search"></i>
                <input type="text" id="helpSearchInput" placeholder="Search help topics..." />
            </div>
        </div>
        <a class="help-center-action" href="mailto:support@nexthorizon.com">Email Support</a>
    </div>

    <div class="two-column-layout">
        <!-- ================= LEFT SIDE (HELP CENTER) ================= -->
        <div class="help-left">
            <p id="noResultsMessage" class="no-results">No results found.</p>

            <p id="noResultsMessage" class="no-results">No results found.</p>

            <!-- CATEGORIES -->
            <h2 class="help-category-header">Categories</h2>
            <div class="help-center-grid">
                <div class="help-card" data-title="orders management">
                    <div class="help-card-icon"><i class="fas fa-box-open"></i></div>
                    <div class="help-card-content">
                        <h3>Orders Management</h3>
                        <a href="/Help/Orders">View order guides</a>
                    </div>
                </div>

                <div class="help-card" data-title="payouts transactions">
                    <div class="help-card-icon"><i class="fas fa-dollar-sign"></i></div>
                    <div class="help-card-content">
                        <h3>Payouts & Transactions</h3>
                        <a href="/Help/Payouts">View payout help</a>
                    </div>
                </div>

                <div class="help-card" data-title="account settings">
                    <div class="help-card-icon"><i class="fas fa-user-cog"></i></div>
                    <div class="help-card-content">
                        <h3>Account Settings</h3>
                        <a href="/Help/Account">View account help</a>
                    </div>
                </div>

                <div class="help-card" data-title="shipping logistics">
                    <div class="help-card-icon"><i class="fas fa-truck-loading"></i></div>
                    <div class="help-card-content">
                        <h3>Shipping & Logistics</h3>
                        <a href="/Help/Shipping">View shipping help</a>
                    </div>
                </div>

                <div class="help-card" data-title="promotions marketing">
                    <div class="help-card-icon"><i class="fas fa-bullhorn"></i></div>
                    <div class="help-card-content">
                        <h3>Promotions & Marketing</h3>
                        <a href="/Help/Marketing">View marketing help</a>
                    </div>
                </div>
            </div>

            <!-- FAQ -->
            <div class="help-center-faq">
                <h2>Frequently Asked Questions</h2>

                <div class="faq-item" data-title="manage orders">
                    <button class="faq-question">How do I manage my orders?</button>
                    <p class="faq-answer">Go to Orders Management in your seller dashboard and update order statuses.
                    </p>
                </div>

                <div class="faq-item" data-title="view payouts">
                    <button class="faq-question">How do I view my payouts?</button>
                    <p class="faq-answer">Visit the Payouts & Transactions section to check your payments.</p>
                </div>

                <div class="faq-item" data-title="account settings">
                    <button class="faq-question">How do I update my account?</button>
                    <p class="faq-answer">Go to Account Settings to update your personal information.</p>
                </div>

                <div class="faq-item" data-title="shipping logistics">
                    <button class="faq-question">How can I manage shipping?</button>
                    <p class="faq-answer">Use the Shipping section to manage deliveries and tracking.</p>
                </div>

                <div class="faq-item" data-title="marketing promotions">
                    <button class="faq-question">How do I run promotions?</button>
                    <p class="faq-answer">Go to Promotions & Marketing to create campaigns.</p>
                </div>
            </div>

        </div>

        <!-- ================= RIGHT SIDE (CHAT SUPPORT) ================= -->
        <div class="help-right">

            <div class="support-container">

                <!-- HEADER -->
                <div class="support-header">
                    <div style="display:flex; align-items:center; gap:12px;">
                        <div class="support-avatar">S</div>
                        <div>
                            <h3>Seller Support</h3>
                            <p>Customer Service</p>
                        </div>
                    </div>
                </div>

                <!-- CHAT BODY -->
                <div class="support-body">
                    <div class="chat-meta-row">
                        <div>
                            <h4 class="chat-title">Live Seller Agent</h4>
                            <p class="chat-subtitle">Ask about orders, payouts, shipping, and account help.</p>
                        </div>
                        <button class="clear-chat-btn" onclick="clearChat()">Clear Chat</button>
                    </div>

                    <div class="quick-actions">
                        <div class="quick-item" onclick="handleTopic('Manage Orders')">
                            <i class="fas fa-box"></i>
                            <span>Manage Orders</span>
                        </div>
                        <div class="quick-item" onclick="handleTopic('Refund Requests')">
                            <i class="fas fa-undo"></i>
                            <span>Refund Requests</span>
                        </div>
                        <div class="quick-item" onclick="handleTopic('Shipping Issues')">
                            <i class="fas fa-truck"></i>
                            <span>Shipping Issues</span>
                        </div>
                        <div class="quick-item" onclick="handleTopic('Payouts')">
                            <i class="fas fa-wallet"></i>
                            <span>Payouts</span>
                        </div>
                    </div>

                    <div class="chat-actions">
                        <button id="chatWithAgentBtn" class="agent-btn" onclick="openChatInput()">Chat with Agent</button>
                    </div>

                    <div id="chatThread" class="chat-thread">
                        <div class="chat-message bot">Welcome Seller, how can we help you today?</div>
                    </div>
                    <div id="typingIndicator" class="typing-indicator" style="display:none;">Agent is typing...</div>
                </div>

                <div id="chatInputRow" class="chat-input-row hidden">
                    <input type="text" id="agentInput" placeholder="Type your message..." />
                    <button class="agent-btn" onclick="sendAgentMessage()">Send</button>
                </div>

            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="/js/helpcenter.js"></script>
    <script>
        const chatThread = document.getElementById("chatThread");
        const agentInput = document.getElementById("agentInput");
        const typingIndicator = document.getElementById("typingIndicator");
        const chatWithAgentBtn = document.getElementById("chatWithAgentBtn");
        const chatInputRow = document.getElementById("chatInputRow");

        function formatDate() {
            const d = new Date();
            return d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        }

        function addMessage(text, type) {
            const msg = document.createElement("div");
            msg.className = "chat-message " + type;
            msg.innerHTML = `<div>${text}</div><div class='chat-ts'>${formatDate()}</div>`;
            chatThread.appendChild(msg);
            chatThread.scrollTop = chatThread.scrollHeight;
        }

        function setTyping(visible) {
            typingIndicator.style.display = visible ? 'block' : 'none';
        }

        function openChatInput() {
            chatWithAgentBtn.classList.add('hidden');
            chatInputRow.classList.remove('hidden');
            agentInput.focus();
            addMessage('Agent: Hello! I am here to help. Type your message below.', 'bot');
        }

        function handleTopic(topic) {
            addMessage(topic, 'user');
            setTyping(true);
            setTimeout(() => {
                setTyping(false);
                addMessage('Agent: Great question! We will help you with ' + topic.toLowerCase() + '.', 'bot');
            }, 600);

            if (!chatInputRow.classList.contains('hidden')) return;
            openChatInput();
        }

        function clearChat() {
            chatThread.innerHTML = '<div class="chat-message bot">Welcome Seller, how can we help you today?</div>';
            setTyping(false);
        }

        function sendAgentMessage() {
            const text = agentInput.value.trim();
            if (!text) return;
            addMessage(text, 'user');
            agentInput.value = '';
            setTyping(true);
            setTimeout(() => {
                setTyping(false);
                addMessage('Agent: Thanks for your message! We are looking into this and will respond shortly.', 'bot');
            }, 700);
        }

        agentInput.addEventListener('keypress', (event) => {
            if (event.key === 'Enter') {
                event.preventDefault();
                sendAgentMessage();
            }
        });
    </script>
}