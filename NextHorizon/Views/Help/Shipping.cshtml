@{
    ViewData["Title"] = "Shipping Help";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="/css/help-center.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
}

<div class="help-center-page">
    <div class="help-center-hero">
        <div>
            <p class="help-center-label">Help Center</p>
            <h1>Shipping & Logistics</h1>
            <p class="help-center-subtitle">Manage shipping labels, tracking, and delivery issues.</p>
        </div>
        <a class="help-center-action" href="/Help/Index">Back to Help Center</a>
    </div>

    <div class="help-category-layout">
        <aside class="help-side-nav">
            <h3>Shop with NextHorizon</h3>
            <ul>
                <li><a href="/Help/Orders">Orders Management</a></li>
                <li><a href="/Help/Payouts">Payouts & Transactions</a></li>
                <li><a href="/Help/Account">Account Settings</a></li>
                <li><a href="/Help/Shipping" class="active">Shipping & Logistics</a></li>
                <li><a href="/Help/Marketing">Promotions & Marketing</a></li>
            </ul>
        </aside>

        <section class="help-content-panel">
            <h2>Shipping & Logistics</h2>

            <div class="help-article-list">

                <div class="help-article">
                    <a href="#" class="answer-toggle">
                        How do I print shipping labels?
                        <i class="fas fa-chevron-down"></i>
                    </a>
                    <div class="answer-text">
                        Open your order details and click "Print Shipping Label".
                        You can download and print it directly for packaging.
                    </div>
                </div>

                <div class="help-article">
                    <a href="#" class="answer-toggle">
                        How do I track a shipment?
                        <i class="fas fa-chevron-down"></i>
                    </a>
                    <div class="answer-text">
                        Go to Orders Management and select the order. Use the tracking number
                        provided to monitor delivery status in real-time.
                    </div>
                </div>

                <div class="help-article">
                    <a href="#" class="answer-toggle">
                        How do I handle return requests?
                        <i class="fas fa-chevron-down"></i>
                    </a>
                    <div class="answer-text">
                        Navigate to Returns & Refunds, review the request, and approve or reject it.
                        Coordinate with the customer for item return and processing.
                    </div>
                </div>

            </div>
        </section>
    </div>
</div>

@section Scripts {
    <script src="/js/account-help.js"></script>
}