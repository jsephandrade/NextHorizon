@{
    ViewData["Title"] = "Order Tracking - FAQ";
}

<div class="help-center-page">
    <a href="/Home" class="help-back-btn">
        <i class="fas fa-arrow-left"></i> Back to Help Center
    </a>

    <div class="help-page-header">
        <div class="help-page-icon">
            <i class="fa-solid fa-truck"></i>
        </div>
        <h1>Order Tracking</h1>
        <p>Track your shipments and delivery updates</p>
    </div>

    <div class="help-page-faq">
        <div class="help-faq-item">
            <div class="help-faq-question">
                <span>Where is my order?</span>
                <i class="fas fa-chevron-down"></i>
            </div>
            <div class="help-faq-answer">
                Track it in <strong>My Purchases</strong> → <strong>Track Order</strong> for real-time updates, carrier info, and estimated delivery.
            </div>
        </div>
        
        <div class="help-faq-item">
            <div class="help-faq-question">
                <span>How long will delivery take?</span>
                <i class="fas fa-chevron-down"></i>
            </div>
            <div class="help-faq-answer">
                Standard: 3–7 business days. Express: 1–3 business days. Times vary by location and carrier conditions.
            </div>
        </div>
        
        <div class="help-faq-item">
            <div class="help-faq-question">
                <span>Why is my order delayed?</span>
                <i class="fas fa-chevron-down"></i>
            </div>
            <div class="help-faq-answer">
                Delays may occur due to weather, logistics issues, customs (international), or high order volume. Check tracking for updates.
            </div>
        </div>

        <div class="help-faq-item">
            <div class="help-faq-question">
                <span>Can I receive my order earlier?</span>
                <i class="fas fa-chevron-down"></i>
            </div>
            <div class="help-faq-answer">
                Delivery speed depends on the courier service selected at checkout. Upgrade to Express at checkout for faster delivery.
            </div>
        </div>

        <div class="help-faq-item">
            <div class="help-faq-question">
                <span>What if I'm not home during delivery?</span>
                <i class="fas fa-chevron-down"></i>
            </div>
            <div class="help-faq-answer">
                The courier will leave a notice with redelivery instructions. You can also arrange pickup at a nearby collection point.
            </div>
        </div>

        <div class="help-faq-item">
            <div class="help-faq-question">
                <span>Do you ship internationally?</span>
                <i class="fas fa-chevron-down"></i>
            </div>
            <div class="help-faq-answer">
                Yes! We ship to over 50 countries. International shipping times and fees vary. Customs duties may apply and are the responsibility of the recipient.
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function() {
    document.querySelectorAll(".help-faq-question").forEach(q => {
        q.addEventListener("click", () => {
            const item = q.parentElement;
            document.querySelectorAll(".help-faq-item").forEach(i => {
                if (i !== item) i.classList.remove("active");
            });
            item.classList.toggle("active");
        });
    });
});
</script>