@{
    ViewData["Title"] = "Help Center";
}

<!-- Chat Component CSS -->
<link rel="stylesheet" href="~/css/chat-component.css" asp-append-version="true" />

<div class="help-center-page">
    <!-- HERO -->
    <div class="help-center-hero">
        <div>
            <p class="help-center-label">Support</p>
            <h1>Need help? We've got your back.</h1>
            <p class="help-center-subtitle">
                Explore quick answers, troubleshooting guides, and support options for
                orders, payments, and account management.
            </p>
        </div>
        <a class="help-center-action" href="mailto:support@nexthorizon.com">Email Support</a>
    </div>

    <!-- 🔍 CATEGORY SEARCH -->
    <div class="help-search-bar">
        <input type="text" id="categorySearch" placeholder="Search help topics..." />
        <i class="fas fa-search"></i>
    </div>

    <!-- HELP OPTIONS GRID -->
    <div class="help-center-grid">
        <!-- Order Help -->
        <div class="help-card" data-help="order">
            <div class="help-card-icon"><i class="fa-solid fa-box"></i></div>
            <div class="help-card-content">
                <h3>Order Help</h3>
                <p class="help-card-desc">Manage, cancel, or modify your orders</p>
            </div>
            <a href="/Help/Order" class="help-card-view">View Details</a>
        </div>

        <!-- Order Tracking -->
        <div class="help-card" data-help="tracking">
            <div class="help-card-icon"><i class="fa-solid fa-truck"></i></div>
            <div class="help-card-content">
                <h3>Order Tracking</h3>
                <p class="help-card-desc">Track shipments & delivery updates</p>
            </div>
            <a href="/Help/Tracking" class="help-card-view">View Details</a>
        </div>

        <!-- Billing & Payments -->
        <div class="help-card" data-help="billing">
            <div class="help-card-icon"><i class="fa-solid fa-credit-card"></i></div>
            <div class="help-card-content">
                <h3>Billing & Payments</h3>
                <p class="help-card-desc">Payment methods, issues & refunds</p>
            </div>
            <a href="/Help/Billing" class="help-card-view">View Details</a>
        </div>

        <!-- Account Help -->
        <div class="help-card" data-help="account">
            <div class="help-card-icon"><i class="fa-solid fa-user-gear"></i></div>
            <div class="help-card-content">
                <h3>Account Help</h3>
                <p class="help-card-desc">Profile, security & settings</p>
            </div>
            <a href="/Help/Account" class="help-card-view">View Details</a>
        </div>

        <!-- Returns & Refunds -->
        <div class="help-card" data-help="returns">
            <div class="help-card-icon"><i class="fa-solid fa-rotate-left"></i></div>
            <div class="help-card-content">
                <h3>Returns & Refunds</h3>
                <p class="help-card-desc">Return items & get refunds</p>
            </div>
            <a href="/Help/Returns" class="help-card-view">View Details</a>
        </div>

        <!-- Technical Support -->
        <div class="help-card" data-help="technical">
            <div class="help-card-icon"><i class="fa-solid fa-screwdriver-wrench"></i></div>
            <div class="help-card-content">
                <h3>Technical Support</h3>
                <p class="help-card-desc">App, website & connectivity issues</p>
            </div>
            <a href="/Help/Technical" class="help-card-view">View Details</a>
        </div>

        <!-- Contact Support -->
        <div class="help-card" data-help="contact">
            <div class="help-card-icon"><i class="fa-solid fa-life-ring"></i></div>
            <div class="help-card-content">
                <h3>Contact Support</h3>
                <p class="help-card-desc">Get in touch with our team</p>
            </div>
            <a href="/Help/Contact" class="help-card-view">View Details</a>
        </div>
    </div>

    <!-- ✅ FAQ + CHAT SIDE-BY-SIDE CONTAINER -->
    <div class="help-content-split">
        <!-- General FAQ SECTION -->
        <div class="help-center-faq">
            <div class="faq-header-mini">
                <h4>🔥 Quick Answers</h4>
                <span class="faq-toggle-all">Expand All</span>
            </div>

            <!-- Tabs -->
            <div class="faq-tabs">
                <span class="active" data-tab="hot">Hot Questions</span>
                <span data-tab="presale">Pre-sale</span>
                <span data-tab="payment">Payment & Account</span>
            </div>

            <!-- 🔥 HOT QUESTIONS -->
            <div class="faq-list active" id="hot">
                <div class="faq-item">
                    <div class="faq-question">
                        <span class="faq-number">1</span>
                        <span>How do I track my order?</span>
                        <span class="arrow">›</span>
                    </div>
                    <div class="faq-answer">
                        Go to <strong>My Purchases</strong> → <strong>Track Order</strong> to see real-time delivery updates, carrier info, and estimated arrival date.
                    </div>
                </div>
                <div class="faq-item">
                    <div class="faq-question">
                        <span class="faq-number">2</span>
                        <span>How do I request a refund?</span>
                        <span class="arrow">›</span>
                    </div>
                    <div class="faq-answer">
                        Open your order details and click <strong>Return / Refund</strong>. Follow the prompts to select a reason and submit. Refunds process within 5-7 business days.
                    </div>
                </div>
                <div class="faq-item">
                    <div class="faq-question">
                        <span class="faq-number">3</span>
                        <span>Can I cancel my order after placing it?</span>
                        <span class="arrow">›</span>
                    </div>
                    <div class="faq-answer">
                        Yes, if your order hasn't shipped yet. Go to <strong>My Purchases</strong>, select the order, and click <strong>Cancel Order</strong>. Once shipped, you'll need to request a return after delivery.
                    </div>
                </div>
                <div class="faq-item">
                    <div class="faq-question">
                        <span class="faq-number">4</span>
                        <span>What if my item arrives damaged?</span>
                        <span class="arrow">›</span>
                    </div>
                    <div class="faq-answer">
                        Contact us within 48 hours of delivery with photos of the damage. We'll arrange a free replacement or full refund. Email: <a href="mailto:support@nexthorizon.com">support@nexthorizon.com</a>
                    </div>
                </div>
                <div class="faq-item">
                    <div class="faq-question">
                        <span class="faq-number">5</span>
                        <span>How long does shipping take?</span>
                        <span class="arrow">›</span>
                    </div>
                    <div class="faq-answer">
                        Standard shipping: 3-7 business days. Express: 1-3 business days. Delivery times vary by location and carrier. Track your order for real-time updates.
                    </div>
                </div>
            </div>

            <!-- 🛒 PRE-SALE -->
            <div class="faq-list" id="presale">
                <div class="faq-item">
                    <div class="faq-question">
                        <span class="faq-number">1</span>
                        <span>Do you offer discounts or promo codes?</span>
                        <span class="arrow">›</span>
                    </div>
                    <div class="faq-answer">
                        Yes! Sign up for our newsletter for exclusive offers. Promo codes can be applied at checkout. Some restrictions may apply.
                    </div>
                </div>
                <div class="faq-item">
                    <div class="faq-question">
                        <span class="faq-number">2</span>
                        <span>Can I ask the seller a question before buying?</span>
                        <span class="arrow">›</span>
                    </div>
                    <div class="faq-answer">
                        Absolutely. Click <strong>Contact Seller</strong> on any product page to send a message. Most sellers respond within 24 hours.
                    </div>
                </div>
                <div class="faq-item">
                    <div class="faq-question">
                        <span class="faq-number">3</span>
                        <span>Are all items brand new?</span>
                        <span class="arrow">›</span>
                    </div>
                    <div class="faq-answer">
                        Most items are new, but some sellers offer certified refurbished or open-box products. Check the product description and condition label before purchasing.
                    </div>
                </div>
                <div class="faq-item">
                    <div class="faq-question">
                        <span class="faq-number">4</span>
                        <span>How do I know if an item is in stock?</span>
                        <span class="arrow">›</span>
                    </div>
                    <div class="faq-answer">
                        Stock status appears below the price: <strong>In Stock</strong>, <strong>Low Stock</strong>, or <strong>Out of Stock</strong>. You can also enable "Notify Me" for restock alerts.
                    </div>
                </div>
                <div class="faq-item">
                    <div class="faq-question">
                        <span class="faq-number">5</span>
                        <span>Can I reserve an item before buying?</span>
                        <span class="arrow">›</span>
                    </div>
                    <div class="faq-answer">
                        We don't offer reservations, but you can add items to your Wishlist or Cart. Items in your Cart are held for 30 minutes during checkout.
                    </div>
                </div>
            </div>

            <!-- 💳 PAYMENT & ACCOUNT -->
            <div class="faq-list" id="payment">
                <div class="faq-item">
                    <div class="faq-question">
                        <span class="faq-number">1</span>
                        <span>What payment methods do you accept?</span>
                        <span class="arrow">›</span>
                    </div>
                    <div class="faq-answer">
                        We accept Visa, Mastercard, American Express, PayPal, Apple Pay, Google Pay, and Cash on Delivery (select regions).
                    </div>
                </div>
                <div class="faq-item">
                    <div class="faq-question">
                        <span class="faq-number">2</span>
                        <span>How do I change my password?</span>
                        <span class="arrow">›</span>
                    </div>
                    <div class="faq-answer">
                        Go to <strong>Account Settings</strong> → <strong>Security</strong> → <strong>Change Password</strong>. Enter your current password, then create a new one (min. 8 characters).
                    </div>
                </div>
                <div class="faq-item">
                    <div class="faq-question">
                        <span class="faq-number">3</span>
                        <span>How do I update my payment method?</span>
                        <span class="arrow">›</span>
                    </div>
                    <div class="faq-answer">
                        Navigate to <strong>Account Settings</strong> → <strong>Payment Methods</strong>. Add, edit, or remove cards. Your default payment method is used at checkout.
                    </div>
                </div>
                <div class="faq-item">
                    <div class="faq-question">
                        <span class="faq-number">4</span>
                        <span>Is my payment information secure?</span>
                        <span class="arrow">›</span>
                    </div>
                    <div class="faq-answer">
                        Yes. We use PCI-DSS compliant encryption and never store full card details. All transactions are processed through secure, trusted payment gateways.
                    </div>
                </div>
                <div class="faq-item">
                    <div class="faq-question">
                        <span class="faq-number">5</span>
                        <span>How do I delete my account?</span>
                        <span class="arrow">›</span>
                    </div>
                    <div class="faq-answer">
                        Go to <strong>Account Settings</strong> → <strong>Privacy</strong> → <strong>Delete Account</strong>. Note: This action is permanent and removes all order history.
                    </div>
                </div>
            </div>
        </div>

        <!-- 🤖 DUAL-MODE CHAT SECTION -->
        <div class="help-chat" id="helpChat">
            
            <!-- Chat Header with Mode Toggle -->
            <div class="help-chat-header">
                <div class="chat-header-left">
                    <i class="fas fa-robot" id="chatModeIcon"></i>
                    <span id="chatModeLabel">Quick Help Chat</span>
                </div>
                <div class="chat-header-controls">
                    <!-- Mode Toggle Switch -->
                    <div class="chat-mode-toggle">
                        <button class="mode-btn active" data-mode="bot" title="Quick Help Bot">
                            <i class="fas fa-robot"></i>
                        </button>
                        <button class="mode-btn" data-mode="agent" title="Live Agent">
                            <i class="fas fa-headset"></i>
                            <span>Live Agent</span>
                        </button>
                    </div>
                    <!-- Clear Button -->
                    <button class="chat-clear-btn" id="clearChatBtn" title="Clear current chat">
                        <i class="fas fa-trash-alt"></i>
                    </button>
                </div>
            </div>

            <!-- Status Bar -->
            <div class="chat-status-bar" id="chatStatusBar">
                <span class="status-dot online"></span>
                <span class="status-text">Bot ready to help</span>
            </div>

            <!-- CHAT BODY -->
            <div class="help-chat-body" id="helpChatBox">
                <!-- Messages load dynamically based on active mode -->
            </div>

            <!-- ✅ QUICK SOLUTIONS (Professional with Toggle) -->
            <div class="chat-quick-solutions" id="quickSolutions">
                <!-- Header: Label + Toggle (always visible) -->
                <div class="quick-solutions-header">
                    <span class="quick-solutions-label">Quick Actions</span>
                    <button class="quick-solutions-toggle" id="toggleQuickSolutions" title="Toggle quick solutions">
                        <span>Hide</span>
                        <i class="fas fa-chevron-up"></i>
                    </button>
                </div>
                
                <!-- Content: Buttons (collapsible) -->
                <div class="quick-solutions-content">
                    <button class="quick-solution-btn primary" data-message="Track my order">
                        <i class="fas fa-box"></i>
                        <span>Track Order</span>
                    </button>
                    <button class="quick-solution-btn" data-message="Request a refund">
                        <i class="fas fa-undo"></i>
                        <span>Refund</span>
                    </button>
                    <button class="quick-solution-btn" data-message="Change my password">
                        <i class="fas fa-lock"></i>
                        <span>Reset Password</span>
                    </button>
                    <button class="quick-solution-btn" data-message="Payment issue">
                        <i class="fas fa-credit-card"></i>
                        <span>Payment Help</span>
                    </button>
                </div>
            </div>

            <!-- CHAT INPUT -->
            <div class="help-chat-input">
                <input type="text" id="chatInput" placeholder="Type your message here..." />
                <button id="sendBtn">Send</button>
            </div>

            <!-- Chat Footer -->
            <div class="help-chat-footer">
                <span class="chat-hint" id="chatHint">💡 Tip: Click any category card for instant help</span>
            </div>

        </div>
    </div>
</div>

<!-- Link Chat Component JS -->
<script src="~/js/chat-component.js" asp-append-version="true"></script>
<script src="~/js/help-center.js" asp-append-version="true"></script>

@section Scripts {
    <!-- Agent modal JS removed - now handled in chat-component.js -->
}