<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NEXT HORIZON QA</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    @await RenderSectionAsync("Styles", required: false)
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Poppins', sans-serif;
            font-size: 12px;
            min-height: 100vh;
            color: #111111;
            background:
                radial-gradient(circle at 20% 20%, rgba(0, 0, 0, 0.05) 0%, rgba(0, 0, 0, 0) 45%),
                radial-gradient(circle at 80% 10%, rgba(0, 0, 0, 0.06) 0%, rgba(0, 0, 0, 0) 38%),
                linear-gradient(180deg, #f6f6f6 0%, #ececec 100%);
        }

        button,
        input,
        select,
        textarea {
            font: inherit;
        }

        .qa-shell {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .qa-header {
            position: sticky;
            top: 0;
            z-index: 100;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 14px 24px;
            backdrop-filter: blur(8px);
            background: rgba(255, 255, 255, 0.8);
            border-bottom: 1px solid rgba(0, 0, 0, 0.12);
        }

        .qa-brand {
            display: flex;
            align-items: center;
            gap: 0;
        }

        .qa-logo {
            width: 120px;
            height: 42px;
            object-fit: contain;
            display: block;
        }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-left: auto;
        }

        .hdr-icon-btn {
            background: none;
            border: none;
            cursor: pointer;
            padding: 8px;
            border-radius: 8px;
            color: #4a4a4a;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.15s ease;
            line-height: 1;
        }

        .hdr-icon-btn:hover {
            color: #111111;
            background-color: rgba(0, 0, 0, 0.06);
        }

        .notif-wrap,
        .profile-dropdown-wrap {
            position: relative;
        }

        .notif-dot {
            position: absolute;
            top: 4px;
            right: 4px;
            width: 7px;
            height: 7px;
            background-color: #d62323;
            border-radius: 50%;
            border: 1px solid #ffffff;
        }

        .profile-dropdown {
            position: absolute;
            top: calc(100% + 8px);
            right: 0;
            background: #ffffff;
            border: 1px solid #d9d9d9;
            border-radius: 8px;
            box-shadow: 0 10px 24px rgba(0, 0, 0, 0.12);
            min-width: 190px;
            display: none;
            z-index: 1001;
        }

        .profile-dropdown.open {
            display: block;
        }

        .profile-dropdown-item {
            display: flex;
            align-items: center;
            gap: 10px;
            width: 100%;
            border: none;
            background: none;
            text-align: left;
            padding: 11px 14px;
            color: #222222;
            font-size: 0.88rem;
            cursor: pointer;
            text-decoration: none;
        }

        .profile-dropdown-item:hover {
            background: #f4f4f4;
        }

        .profile-dropdown-item.profile-dd-logout {
            border-top: 1px solid #e6e6e6;
        }

        .qa-main {
            width: 100%;
            min-width: 0;
            flex: 1;
        }

        .qa-workspace {
            width: min(1380px, 97vw);
            margin: 22px auto;
            display: grid;
            grid-template-columns: 206px minmax(0, 1fr);
            gap: 12px;
            flex: 1;
        }

        .qa-sidebar {
            align-self: start;
            position: sticky;
            top: 84px;
            margin-left: -10px;
            background: rgba(255, 255, 255, 0.88);
            border: 1px solid rgba(0, 0, 0, 0.12);
            border-radius: 12px;
            padding: 10px;
            backdrop-filter: blur(4px);
        }

        .qa-side-title {
            font-size: 0.72rem;
            font-weight: 600;
            color: #4a4a4a;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            margin: 0 0 8px;
        }

        .qa-side-nav {
            display: grid;
            gap: 6px;
        }

        .qa-side-link {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            color: #2b2b2b;
            border-radius: 8px;
            padding: 9px 10px;
            border: 1px solid transparent;
            font-size: 0.86rem;
            font-weight: 500;
            transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
        }

        .qa-side-link:hover {
            background: #f3f3f3;
            border-color: rgba(0, 0, 0, 0.1);
            color: #111111;
        }

        .qa-side-link.active {
            background: #111111;
            border-color: #111111;
            color: #ffffff;
        }

        @@media (max-width: 768px) {
            .qa-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 10px;
                padding: 12px 16px;
            }

            .header-actions {
                margin-left: auto;
            }

            .qa-main {
                width: 100%;
            }

            .qa-workspace {
                width: 94vw;
                grid-template-columns: 1fr;
                gap: 10px;
            }

            .qa-sidebar {
                position: static;
                margin-left: 0;
            }

            .qa-side-nav {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media (max-width: 560px) {
            .qa-side-nav {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    @{
        var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
        var action = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
        var qaUserName = Context.Session.GetString("FullName");
        qaUserName = string.IsNullOrWhiteSpace(qaUserName)
            ? Context.Session.GetString("Username") ?? "QA User"
            : qaUserName;
    }
    <div class="qa-shell">
        <header class="qa-header">
            <div class="qa-brand">
                <img src="/images/nh-logo.jpg" alt="NEXT HORIZON" class="qa-logo" />
            </div>
            <div class="header-actions">
                <div class="notif-wrap">
                    <button class="hdr-icon-btn" aria-label="Notifications" title="Notifications" type="button">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                            <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                        </svg>
                        <span class="notif-dot"></span>
                    </button>
                </div>

                <div class="profile-dropdown-wrap" id="profile-wrap">
                    <button class="hdr-icon-btn" id="profile-btn" onclick="toggleProfileDropdown()" aria-label="Account" aria-expanded="false" title="Account" type="button">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                            <circle cx="12" cy="7" r="4"/>
                        </svg>
                    </button>
                    <div class="profile-dropdown" id="profile-dropdown">
                        <a href="@Url.Action("Dashboard", "QA")" class="profile-dropdown-item">
                            <i class="bi bi-person-badge"></i> @qaUserName
                        </a>
                        <a href="@Url.Action("Index", "Home")" class="profile-dropdown-item">
                            <i class="bi bi-arrow-left-circle"></i> Back to storefront
                        </a>
                        <a href="@Url.Action("Logout", "Login")" class="profile-dropdown-item profile-dd-logout">
                            <i class="bi bi-box-arrow-right"></i> Log out
                        </a>
                    </div>
                </div>
            </div>
        </header>
        <div class="qa-workspace">
            <aside class="qa-sidebar" aria-label="QA navigation">
                <p class="qa-side-title">QA Workspace</p>
                <nav class="qa-side-nav">
                    <a href="@Url.Action("Dashboard", "QA")" class="qa-side-link @(controller == "QA" && action == "Dashboard" ? "active" : "")">
                        <i class="bi bi-grid-1x2"></i>
                        <span>Dashboard</span>
                    </a>
                    <a href="@Url.Action("AllAgents", "QA")" class="qa-side-link @(controller == "QA" && (action == "AllAgents" || action == "AgentTickets") ? "active" : "")">
                        <i class="bi bi-people"></i>
                        <span>Agents</span>
                    </a>
                    <a href="@Url.Action("AllResolvedTickets", "QA")" class="qa-side-link @(controller == "QA" && action == "AllResolvedTickets" ? "active" : "")">
                        <i class="bi bi-check2-square"></i>
                        <span>Resolved tickets</span>
                    </a>
                    <a href="@Url.Action("Rating", "QA")" class="qa-side-link @(controller == "QA" && action == "Rating" ? "active" : "")">
                        <i class="bi bi-star"></i>
                        <span>Rating queue</span>
                    </a>
                    <a href="@Url.Action("RatedHistory", "QA")" class="qa-side-link @(controller == "QA" && action == "RatedHistory" ? "active" : "")">
                        <i class="bi bi-clock-history"></i>
                        <span>Rated history</span>
                    </a>
                </nav>
            </aside>

            <main class="qa-main">
                @RenderBody()
            </main>
        </div>
    </div>

    <script>
        function toggleProfileDropdown() {
            var dd = document.getElementById('profile-dropdown');
            if (!dd) return;
            dd.classList.toggle('open');
        }

        document.addEventListener('click', function (e) {
            var wrap = document.getElementById('profile-wrap');
            if (!wrap) return;
            if (!wrap.contains(e.target)) {
                var dd = document.getElementById('profile-dropdown');
                if (dd) dd.classList.remove('open');
            }
        });

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                var dd = document.getElementById('profile-dropdown');
                if (dd) dd.classList.remove('open');
            }
        });
    </script>
</body>
</html>
