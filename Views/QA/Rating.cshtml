@{
    ViewData["Title"] = "QA Rating Page";
    Layout = "~/Views/Shared/_QALayout.cshtml";
    var conversationId = (int)(ViewData["ConversationId"] ?? 0);
    var hasActiveTicket = (bool)(ViewData["HasActiveTicket"] ?? false);
    var currentTicketId = conversationId;
    var prevTicketId = (int)(ViewData["PrevTicketId"] ?? currentTicketId);
    var nextTicketId = (int)(ViewData["NextTicketId"] ?? currentTicketId);
    var queueRange = (string)(ViewData["QueueRange"] ?? "custom");
    var queueFromDate = (string)(ViewData["QueueFromDate"] ?? string.Empty);
    var queueToDate = (string)(ViewData["QueueToDate"] ?? string.Empty);
    var queueSearch = (string)(ViewData["QueueSearch"] ?? string.Empty);
    var queueCount = (int)(ViewData["QueueCount"] ?? 0);
    var queuePosition = ViewData["QueuePosition"] is int queuePositionValue ? queuePositionValue : (int?)null;
    var currentTicketInQueue = (bool)(ViewData["CurrentTicketInQueue"] ?? false);
    var isRated = (bool)(ViewData["IsRated"] ?? false);
    var ratedAccuracy = (int)(ViewData["RatedAccuracy"] ?? 5);
    var ratedTone = (int)(ViewData["RatedTone"] ?? 5);
    var ratedResolution = (int)(ViewData["RatedResolution"] ?? 5);
    var ratedAccuracyQ1 = (int)(ViewData["RatedAccuracyQ1"] ?? ratedAccuracy);
    var ratedAccuracyQ2 = (int)(ViewData["RatedAccuracyQ2"] ?? ratedAccuracy);
    var ratedAccuracyQ3 = (int)(ViewData["RatedAccuracyQ3"] ?? ratedAccuracy);
    var ratedToneQ1 = (int)(ViewData["RatedToneQ1"] ?? ratedTone);
    var ratedToneQ2 = (int)(ViewData["RatedToneQ2"] ?? ratedTone);
    var ratedToneQ3 = (int)(ViewData["RatedToneQ3"] ?? ratedTone);
    var ratedResolutionQ1 = (int)(ViewData["RatedResolutionQ1"] ?? ratedResolution);
    var ratedResolutionQ2 = (int)(ViewData["RatedResolutionQ2"] ?? ratedResolution);
    var ratedResolutionQ3 = (int)(ViewData["RatedResolutionQ3"] ?? ratedResolution);
    var ratedAccuracyPoints = (double)(ViewData["RatedAccuracyPoints"] ?? 0.0);
    var ratedTonePoints = (double)(ViewData["RatedTonePoints"] ?? 0.0);
    var ratedResolutionPoints = (double)(ViewData["RatedResolutionPoints"] ?? 0.0);
    var ratedOverallPercent = (double)(ViewData["RatedOverallPercent"] ?? 0.0);
    var ratedNotes = (string)(ViewData["RatedNotes"] ?? string.Empty);
    var ratedSubmittedToAgent = (bool)(ViewData["RatedSubmittedToAgent"] ?? false);
    var ratedSubmittedOn = (string)(ViewData["RatedSubmittedOn"] ?? string.Empty);
    var conversationAgent = (string)(ViewData["ConversationAgent"] ?? string.Empty);
    var conversationCustomer = (string)(ViewData["ConversationCustomer"] ?? string.Empty);
    var conversationDate = (string)(ViewData["ConversationDate"] ?? string.Empty);
    var conversationMessages = ViewData["ConversationMessages"] as IReadOnlyList<NextHorizon.Models.QA.QaConversationMessageViewModel>
        ?? Array.Empty<NextHorizon.Models.QA.QaConversationMessageViewModel>();
    var inlineCommentsJson = (string)(ViewData["InlineCommentsJson"] ?? "{}");
    var reviewerDisplayName = (string)(ViewData["ReviewerDisplayName"] ?? ViewData["RatedBy"] ?? "QA Analyst - You");
    var navQueryParts = new List<string>
    {
        $"range={Uri.EscapeDataString(queueRange)}"
    };
    if (!string.IsNullOrWhiteSpace(queueFromDate))
    {
        navQueryParts.Add($"from={Uri.EscapeDataString(queueFromDate)}");
    }

    if (!string.IsNullOrWhiteSpace(queueToDate))
    {
        navQueryParts.Add($"to={Uri.EscapeDataString(queueToDate)}");
    }

    if (!string.IsNullOrWhiteSpace(queueSearch))
    {
        navQueryParts.Add($"search={Uri.EscapeDataString(queueSearch)}");
    }

    var queueQueryString = navQueryParts.Count == 0 ? string.Empty : "?" + string.Join("&", navQueryParts);
    var prevTicketUrl = $"/qa/rating/{prevTicketId}{queueQueryString}";
    var nextTicketUrl = $"/qa/rating/{nextTicketId}{queueQueryString}";
    var queueHelpText = currentTicketInQueue
        ? $"Pending queue position {queuePosition ?? 1} of {queueCount}."
        : (queueCount > 0
            ? $"Current ticket is outside the pending queue. {queueCount} pending ticket(s) match the current filters."
            : "No pending QA tickets match the current filters.");

    var accuracyQuestions = new[]
    {
        "Did the agent provide correct policy or product details?",
        "Did the response avoid factual errors or contradictions?",
        "Were the next steps accurate and actionable?"
    };

    var toneQuestions = new[]
    {
        "Did the agent acknowledge the customer concern with empathy?",
        "Was the tone respectful and professional throughout?",
        "Did the language stay clear, calm, and customer-friendly?"
    };

    var resolutionQuestions = new[]
    {
        "Was the core issue fully resolved?",
        "Did the agent provide a complete and practical solution?",
        "Did the agent set clear follow-up expectations when needed?"
    };
}

@section Styles {
<style>
    .jump-bar {
        background: #ffffff;
        border: 0.5px solid rgba(0, 0, 0, 0.12);
        border-radius: 12px;
        padding: 10px 12px;
        margin-bottom: 12px;
        display: grid;
        gap: 8px;
    }

    .jump-label {
        font-size: .8rem;
        color: #555555;
        font-weight: 500;
    }

    .jump-btn {
        border: none;
        border-radius: 8px;
        padding: 7px 12px;
        font-size: .8rem;
        font-weight: 500;
        color: #ffffff;
        background: #111111;
        cursor: pointer;
    }

    .jump-btn:hover {
        background: #333333;
    }

    .queue-search-wrap {
        position: relative;
    }

    .queue-search-wrap i {
        position: absolute;
        left: 10px;
        top: 50%;
        transform: translateY(-50%);
        color: #777777;
        font-size: .8rem;
    }

    .queue-search {
        width: 100%;
        border: 0.5px solid rgba(0, 0, 0, 0.2);
        border-radius: 8px;
        padding: 7px 10px 7px 28px;
        font-size: .8rem;
        background: #ffffff;
    }

    .queue-search-row {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .queue-filters {
        display: grid;
        gap: 8px;
    }

    .queue-filter-help {
        font-size: .76rem;
        color: #666666;
    }

    .queue-filter-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr 1fr;
        gap: 8px;
    }

    .queue-filter-field {
        display: grid;
        gap: 4px;
    }

    .queue-filter-label {
        font-size: .72rem;
        font-weight: 600;
        color: #5a5a5a;
    }

    .queue-filter {
        border: 0.5px solid rgba(0, 0, 0, 0.2);
        border-radius: 8px;
        padding: 7px 10px;
        font-size: .8rem;
        background: #ffffff;
        color: #111111;
    }

    .queue-feedback {
        display: none;
        border: 0.5px dashed rgba(0, 0, 0, 0.2);
        border-radius: 8px;
        padding: 8px 10px;
        font-size: .78rem;
        color: #555555;
        background: #fafafa;
    }

    .rating-empty-state {
        border: 0.5px dashed rgba(0, 0, 0, 0.18);
        border-radius: 12px;
        padding: 16px;
        background: #fafafa;
        color: #4f4f4f;
        font-size: .85rem;
        line-height: 1.5;
    }

    .rating-shell {
        display: grid;
        grid-template-columns: minmax(0, 1.4fr) minmax(320px, .8fr);
        gap: 16px;
        min-height: calc(100vh - 150px);
    }

    body.qa-fixed-layout {
        overflow: hidden;
    }

    body.qa-fixed-layout .rating-shell {
        height: var(--qa-shell-height, calc(100vh - 255px));
        min-height: 0;
    }

    body.qa-fixed-layout .rating-shell > .panel:first-child {
        display: flex;
        flex-direction: column;
        min-height: 0;
    }

    body.qa-fixed-layout .rating-shell > .panel:first-child .convo-body {
        flex: 1;
        min-height: 0;
        max-height: none;
        overflow-y: auto;
    }

    .panel {
        background: #ffffff;
        border-radius: 12px;
        border: 0.5px solid rgba(0, 0, 0, 0.12);
        overflow: hidden;
    }

    .panel.qa-panel {
        display: flex;
        flex-direction: column;
        max-height: calc(100vh - 150px);
    }

    body.qa-fixed-layout .panel.qa-panel {
        height: 100%;
        max-height: none;
        min-height: 0;
    }

    .panel-head {
        padding: 14px 16px;
        border-bottom: 0.5px solid rgba(0, 0, 0, 0.1);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }

    .panel-title {
        font-size: .9rem;
        font-weight: 600;
        color: #111111;
    }

    .sub {
        font-size: .78rem;
        color: #666666;
        margin-top: 2px;
    }

    .conversation-summary {
        font-size: 1rem;
        font-weight: 700;
        color: #2f2f2f;
    }

    .convo-body {
        padding: 16px;
        display: grid;
        gap: 10px;
        max-height: calc(100vh - 250px);
        overflow-y: auto;
        background: #f7f7f7;
    }

    .msg {
        max-width: 82%;
        padding: 11px 13px;
        border-radius: 10px;
        font-size: .875rem;
        line-height: 1.5;
        border: 0.5px solid rgba(0, 0, 0, 0.1);
    }

    .msg.selectable-msg {
        cursor: pointer;
        transition: border-color .15s ease, box-shadow .15s ease;
    }

    .msg.selectable-msg:hover {
        border-color: rgba(0, 0, 0, 0.3);
    }

    .msg.selected-for-comment {
        border-color: #111111;
        box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.22);
        background: #f0f5ff;
    }

    .msg.has-inline-comment {
        border-color: #d8b44c;
        box-shadow: inset 3px 0 0 #e0b124;
    }

    .msg-comment-thread {
        margin-top: 8px;
        display: grid;
        gap: 7px;
    }

    .msg-comment-entry {
        background: #fff9e8;
        border: 0.5px solid #e6d3a0;
        border-radius: 8px;
        padding: 7px 9px;
        font-size: .77rem;
        color: #3f3421;
        line-height: 1.4;
    }

    .msg-comment-meta {
        font-size: .72rem;
        font-weight: 700;
        color: #6a5a35;
        margin-bottom: 4px;
    }

    .msg-comment-images {
        display: block;
        margin-top: 4px;
        color: #5d4c2a;
        font-size: .72rem;
    }

    .msg-comment-composer {
        margin-top: 8px;
        display: none;
        gap: 6px;
        border: 0.5px dashed rgba(0, 0, 0, 0.18);
        border-radius: 8px;
        padding: 8px;
        background: #ffffff;
    }

    .msg-comment-composer textarea {
        width: 100%;
        min-height: 64px;
        resize: vertical;
        border: 0.5px solid rgba(0, 0, 0, 0.2);
        border-radius: 8px;
        padding: 8px;
        font: inherit;
        font-size: .78rem;
    }

    .msg-comment-actions {
        display: flex;
        gap: 6px;
    }

    .msg-comment-inline-actions {
        margin-top: 5px;
        display: flex;
        gap: 6px;
    }

    .msg-comment-btn {
        border: 0.5px solid rgba(0, 0, 0, 0.2);
        border-radius: 8px;
        background: #ffffff;
        color: #111111;
        font-size: .74rem;
        font-weight: 600;
        padding: 5px 9px;
        cursor: pointer;
    }

    .msg-comment-btn.small {
        font-size: .7rem;
        padding: 4px 8px;
    }

    .msg.user {
        background: #ffffff;
        justify-self: start;
    }

    .msg.agent {
        background: #ececec;
        justify-self: end;
        border-color: rgba(0, 0, 0, 0.12);
    }

    .msg-meta {
        display: block;
        font-size: .82rem;
        color: #888888;
        margin-top: 5px;
    }

    .msg-sender {
        font-weight: 700;
        color: #5f5f5f;
    }

    .msg-time {
        font-weight: 700;
        color: #616161;
        font-size: .84rem;
    }

    .convo-footer {
        padding: 12px 16px;
        border-top: 0.5px solid rgba(0, 0, 0, 0.1);
        background: #ffffff;
    }

    .ticket-nav {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .nav-arrow {
        width: 30px;
        height: 30px;
        border-radius: 8px;
        border: 0.5px solid rgba(0, 0, 0, 0.18);
        background: #ffffff;
        color: #111111;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: .85rem;
        font-weight: 500;
    }

    .ticket-chip {
        border: 0.5px solid rgba(0, 0, 0, 0.16);
        background: #f5f5f5;
        border-radius: 999px;
        padding: 4px 12px;
        font-size: .9rem;
        color: #111111;
        font-weight: 700;
    }

    .rate-body {
        padding: 16px;
        display: grid;
        gap: 14px;
        overflow-y: auto;
    }

    .panel.qa-panel .rate-body {
        max-height: calc(100vh - 230px);
    }

    body.qa-fixed-layout .panel.qa-panel .rate-body {
        flex: 1;
        min-height: 0;
        max-height: none;
        overflow-y: auto;
    }

    .score-group {
        display: grid;
        gap: 5px;
    }

    .category-block {
        border: 0.5px solid rgba(0, 0, 0, 0.14);
        border-radius: 10px;
        background: #fafafa;
        padding: 10px;
        display: grid;
        gap: 10px;
    }

    .category-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }

    .category-title {
        font-size: .82rem;
        font-weight: 600;
        color: #111111;
    }

    .category-average {
        font-size: .76rem;
        color: #444444;
        background: #eeeeee;
        border-radius: 999px;
        padding: 3px 10px;
    }

    .question-grid {
        display: grid;
        gap: 8px;
    }

    .question-row {
        display: grid;
        grid-template-columns: 1fr;
        gap: 10px;
    }

    .question-text {
        font-size: .8rem;
        color: #222222;
        line-height: 1.4;
    }

    .score-radio-group {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .score-radio-option {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        border: 0.5px solid rgba(0, 0, 0, 0.18);
        border-radius: 999px;
        padding: 4px 8px;
        font-size: .76rem;
        color: #222222;
        background: #ffffff;
        cursor: pointer;
    }

    .score-radio-option input {
        margin: 0;
        accent-color: #111111;
    }

    .rated-readonly .score-radio-group {
        pointer-events: none;
    }

    .rated-readonly {
        display: grid;
        gap: 12px;
        padding-bottom: 10px;
    }

    .rated-readonly .category-block {
        margin: 0;
    }

    .rated-readonly .question-grid {
        gap: 10px;
    }

    .rated-readonly .question-row {
        gap: 11px;
    }

    .rated-readonly .score-radio-option {
        cursor: default;
    }

    .rated-readonly .score-radio-option input {
        opacity: 1;
        accent-color: #111111;
    }

    .form-hint {
        font-size: .76rem;
        color: #666666;
    }

    .message-comment-list {
        display: grid;
        gap: 10px;
    }

    .message-comment-item {
        border: 0.5px solid rgba(0, 0, 0, 0.16);
        border-radius: 10px;
        background: #ffffff;
        padding: 10px;
        display: grid;
        gap: 8px;
    }

    .message-comment-head {
        font-size: .78rem;
        color: #444444;
        font-weight: 600;
    }

    .message-image-input {
        border: 0.5px solid rgba(0, 0, 0, 0.2);
        border-radius: 8px;
        padding: 6px 8px;
        background: #ffffff;
        font-size: .78rem;
    }

    .message-image-files {
        font-size: .74rem;
        color: #5a5a5a;
    }

    .score-error {
        display: none;
        border: 0.5px solid #e6b0b0;
        border-radius: 8px;
        background: #fff4f4;
        color: #9a2f2f;
        font-size: .76rem;
        padding: 8px 10px;
    }

    .score-success {
        display: none;
        border: 0.5px solid #b7d9c0;
        border-radius: 8px;
        background: #f2fbf4;
        color: #1c6a36;
        font-size: .76rem;
        padding: 8px 10px;
    }

    .submit-choice-modal {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.46);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 1100;
        padding: 16px;
    }

    .submit-choice-modal.is-open {
        display: flex;
    }

    .submit-choice-card {
        width: min(480px, 100%);
        background: #ffffff;
        border-radius: 14px;
        border: 0.5px solid rgba(0, 0, 0, 0.14);
        box-shadow: 0 22px 50px rgba(0, 0, 0, 0.28);
        padding: 16px;
        display: grid;
        gap: 10px;
    }

    .submit-choice-title {
        font-size: 1rem;
        font-weight: 700;
        color: #111111;
    }

    .submit-choice-text {
        font-size: .86rem;
        color: #4a4a4a;
        line-height: 1.5;
    }

    .submit-choice-actions {
        margin-top: 4px;
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        flex-wrap: wrap;
    }

    body.modal-open {
        overflow: hidden;
    }

    .score-group label {
        font-size: .8rem;
        font-weight: 500;
        color: #111111;
    }

    .score-group select,
    .score-group textarea {
        border: 0.5px solid rgba(0, 0, 0, 0.2);
        border-radius: 8px;
        padding: 9px 11px;
        font: inherit;
        font-size: .875rem;
        color: #111111;
        background: #ffffff;
    }

    .score-group textarea {
        min-height: 110px;
        resize: vertical;
    }

    .actions {
        display: flex;
        gap: 8px;
    }

    .rated-badge {
        border-radius: 999px;
        padding: 5px 10px;
        font-size: .74rem;
        font-weight: 600;
        background: #e9f2e9;
        color: #165f2e;
        border: 0.5px solid #bcd7c4;
    }

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 8px;
    }

    .summary-card {
        border: 0.5px solid rgba(0, 0, 0, 0.14);
        border-radius: 10px;
        background: #fafafa;
        padding: 11px;
    }

    .summary-label {
        font-size: .74rem;
        color: #666666;
        margin-bottom: 3px;
        white-space: nowrap;
    }

    .summary-value {
        font-size: 1rem;
        font-weight: 600;
        color: #111111;
    }

    .summary-note {
        border: 0.5px solid rgba(0, 0, 0, 0.14);
        border-radius: 10px;
        background: #fafafa;
        padding: 10px;
        color: #333333;
        line-height: 1.5;
    }

    .summary-meta {
        display: grid;
        gap: 2px;
        font-size: .78rem;
        color: #666666;
    }

    .summary-actions {
        display: flex;
        gap: 8px;
    }

    .submit-agent-box {
        border: 0.5px solid rgba(0, 0, 0, 0.14);
        border-radius: 10px;
        background: #fafafa;
        padding: 10px;
        display: grid;
        gap: 8px;
    }

    .submit-agent-status {
        border-radius: 999px;
        padding: 4px 10px;
        font-size: .74rem;
        font-weight: 700;
        width: fit-content;
    }

    .submit-agent-status.sent {
        background: #e8f6ea;
        color: #1c6a36;
        border: 1px solid #b7d9c0;
    }

    .submit-agent-status.pending {
        background: #fff4dd;
        color: #8a5a10;
        border: 1px solid #f1d198;
    }

    .submit-agent-note {
        font-size: .77rem;
        color: #666666;
    }

    .summary-actions.tight {
        margin-top: 8px;
    }

    .question-summary-list {
        display: grid;
        gap: 6px;
    }

    .question-summary-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        font-size: .79rem;
        color: #222222;
        padding: 6px 8px;
        border-radius: 8px;
        background: #f4f4f4;
    }

    .question-summary-item strong {
        white-space: nowrap;
        min-width: 52px;
        text-align: right;
        flex-shrink: 0;
    }

    .detail-panel {
        border: 0.5px solid rgba(0, 0, 0, 0.14);
        border-radius: 10px;
        background: #fafafa;
        padding: 10px;
        display: grid;
        gap: 10px;
    }

    #rated-summary-view,
    #rated-edit-form {
        display: grid;
        gap: 12px;
    }

    .btn {
        border: none;
        border-radius: 8px;
        padding: 9px 14px;
        font-weight: 500;
        font-size: .82rem;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .btn.primary { background: #111111; color: #ffffff; }
    .btn.secondary { background: #f2f2f2; color: #111111; border: 0.5px solid rgba(0,0,0,0.12); }

    @@media (max-width: 980px) {
        .rating-shell {
            grid-template-columns: 1fr;
        }

        body.qa-fixed-layout {
            overflow: auto;
        }

        body.qa-fixed-layout .rating-shell {
            height: auto;
        }

        .panel.qa-panel {
            max-height: none;
        }

        .panel.qa-panel .rate-body {
            max-height: none;
            overflow-y: visible;
        }

        .queue-filter-grid {
            grid-template-columns: 1fr 1fr;
        }

        .summary-grid {
            grid-template-columns: 1fr;
        }

        .convo-body {
            max-height: 380px;
        }
    }

    @@media (max-width: 620px) {
        .queue-filter-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
}

<section class="jump-bar" aria-label="Go to conversation">
    <div class="queue-filters">
        <div class="queue-filter-grid">
            <div class="queue-filter-field">
                <label class="queue-filter-label" for="queue-quick-range">Date preset</label>
                <select id="queue-quick-range" class="queue-filter">
                    <option value="custom">Custom range</option>
                    <option value="today">Today</option>
                    <option value="last7">Last 7 days</option>
                    <option value="last30">Last 30 days</option>
                </select>
            </div>
            <div class="queue-filter-field">
                <label class="queue-filter-label" for="queue-from-date">Resolved date from</label>
                <input id="queue-from-date" class="queue-filter" type="date" value="@queueFromDate" />
            </div>
            <div class="queue-filter-field">
                <label class="queue-filter-label" for="queue-to-date">Resolved date to</label>
                <input id="queue-to-date" class="queue-filter" type="date" value="@queueToDate" />
            </div>
            <div class="queue-filter-field">
                <label class="queue-filter-label" for="rating-ticket-search">Ticket or agent</label>
                <div class="queue-search-row">
                    <div class="queue-search-wrap">
                        <i class="bi bi-search"></i>
                        <input id="rating-ticket-search" class="queue-search" type="search" placeholder="Enter ticket ID or agent name" value="@queueSearch" />
                    </div>
                    <button id="rating-jump-btn" class="jump-btn" type="button">Go</button>
                </div>
            </div>
        </div>
        <div id="queue-filter-help" class="queue-filter-help">@queueHelpText</div>
        <div id="queue-feedback" class="queue-feedback">No tickets match the current queue filters.</div>
    </div>
</section>

<section class="rating-shell">
    <article class="panel">
        <header class="panel-head">
            <div>
                <div class="panel-title">Conversation view</div>
                @if (hasActiveTicket)
                {
                    <div class="sub conversation-summary">Ticket #@currentTicketId - Agent: @conversationAgent - Customer: @conversationCustomer - Date: @conversationDate</div>
                    <div class="sub">Click specific chat messages to tag them for QA comments.</div>
                }
                else
                {
                    <div class="sub conversation-summary">No ticket selected</div>
                    <div class="sub">The current filters do not have any pending QA conversations to open.</div>
                }
            </div>
        </header>

        <div class="convo-body">
            @if (!hasActiveTicket)
            {
                <div class="rating-empty-state">
                    No pending QA ticket matches the current queue filters. Adjust the date or search filters, or open another QA list to select a conversation.
                </div>
            }
            else if (conversationMessages.Count == 0)
            {
                <div class="msg user">
                    No conversation messages are available for this ticket yet.
                    @if (!string.IsNullOrWhiteSpace(conversationDate))
                    {
                        <span class="msg-meta"><span class="msg-sender">System</span> - <span class="msg-time">@conversationDate</span></span>
                    }
                </div>
            }
            else
            {
                foreach (var message in conversationMessages)
                {
                    var messageClasses = message.IsSelectable
                        ? $"msg {message.SenderCssClass} selectable-msg"
                        : $"msg {message.SenderCssClass}";
                    var messageLabel = $"{message.SenderDisplayName} {message.TimestampLabel}";
                    <div class="@messageClasses" data-message-id="@message.MessageId" data-message-label="@messageLabel">
                        @message.MessageText
                        <span class="msg-meta"><span class="msg-sender">@message.SenderDisplayName</span> - <span class="msg-time">@message.TimestampLabel</span></span>
                    </div>
                }
            }
        </div>

        <div class="convo-footer">
            <div class="ticket-nav">
                @if (hasActiveTicket)
                {
                    <a id="prev-ticket-nav" href="@prevTicketUrl" class="nav-arrow" title="Previous ticket" aria-label="Previous ticket">&lt;</a>
                    <span class="ticket-chip">Ticket #@currentTicketId - Agent: @conversationAgent - Customer: @conversationCustomer</span>
                    <a id="next-ticket-nav" href="@nextTicketUrl" class="nav-arrow" title="Next ticket" aria-label="Next ticket">&gt;</a>
                }
                else
                {
                    <span class="ticket-chip">No active QA ticket</span>
                }
            </div>
        </div>
    </article>

    <article class="panel qa-panel">
        <header class="panel-head">
            <div>
                <div class="panel-title">QA rating panel</div>
                <div class="sub">@(hasActiveTicket ? (isRated ? "This conversation is already rated" : "Rate this conversation from QA side") : "No conversation is available to rate right now")</div>
            </div>
            @if (hasActiveTicket && isRated)
            {
                <span class="rated-badge">Rated</span>
            }
        </header>

        @if (!hasActiveTicket)
        {
            <div class="rate-body">
                <div class="rating-empty-state">
                    No QA rating form is available because no ticket is currently selected.
                </div>
            </div>
        }
        else if (!isRated)
        {
            <form id="new-rating-form" class="rate-body" onsubmit="return false;">
                <div class="form-hint">Complete all 9 questions. Each question must be scored from 1 to 5.</div>

                <div class="category-block">
                    <div class="category-head">
                        <div class="category-title">Accuracy</div>
                        <div id="new-avg-accuracy" class="category-average"><strong>0.0 / 35</strong></div>
                    </div>
                    <div class="question-grid">
                        @for (var i = 0; i < accuracyQuestions.Length; i++)
                        {
                            <div class="question-row">
                                <div class="question-text">Q@(i + 1). @accuracyQuestions[i]</div>
                                <div class="score-radio-group">
                                    @for (var score = 1; score <= 5; score++)
                                    {
                                        <label class="score-radio-option" for="new-accuracy-q@(i + 1)-@score">
                                            <input id="new-accuracy-q@(i + 1)-@score" class="new-score-input" type="radio" name="new-accuracy-q@(i + 1)" value="@score" data-group="accuracy" />
                                            <span>@score</span>
                                        </label>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="category-block">
                    <div class="category-head">
                        <div class="category-title">Tone and empathy</div>
                        <div id="new-avg-tone" class="category-average"><strong>0.0 / 35</strong></div>
                    </div>
                    <div class="question-grid">
                        @for (var i = 0; i < toneQuestions.Length; i++)
                        {
                            <div class="question-row">
                                <div class="question-text">Q@(i + 1). @toneQuestions[i]</div>
                                <div class="score-radio-group">
                                    @for (var score = 1; score <= 5; score++)
                                    {
                                        <label class="score-radio-option" for="new-tone-q@(i + 1)-@score">
                                            <input id="new-tone-q@(i + 1)-@score" class="new-score-input" type="radio" name="new-tone-q@(i + 1)" value="@score" data-group="tone" />
                                            <span>@score</span>
                                        </label>
                                    }
                                </div>
