<div id="ticket-nav-confirm-modal" class="submit-choice-modal" aria-hidden="true">
    <div class="submit-choice-card" role="dialog" aria-modal="true" aria-labelledby="ticket-nav-confirm-title">
        <div id="ticket-nav-confirm-title" class="submit-choice-title">Continue to another ticket?</div>
        <div id="ticket-nav-confirm-text" class="submit-choice-text">QA changes are still in progress on this ticket. Save and continue?</div>
        <div class="submit-choice-actions">
            <button id="ticket-nav-stay-btn" class="btn secondary" type="button">Stay</button>
            <button id="ticket-nav-save-continue-btn" class="btn primary" type="button">Save and continue</button>
        </div>
    </div>
</div>

<script>
    (function () {
        document.body.classList.add('qa-fixed-layout');
        window.addEventListener('beforeunload', function () {
            document.body.classList.remove('qa-fixed-layout');
        });

        var ratingShell = document.querySelector('.rating-shell');
        function fitShellToViewport() {
            if (!ratingShell || window.innerWidth <= 980) return;
            var top = ratingShell.getBoundingClientRect().top;
            var available = Math.floor(window.innerHeight - top - 12);
            if (available > 320) {
                document.documentElement.style.setProperty('--qa-shell-height', available + 'px');
            }
        }

        fitShellToViewport();
        window.addEventListener('resize', fitShellToViewport);

        var search = document.getElementById('rating-ticket-search');
        var btn = document.getElementById('rating-jump-btn');
        var quickRange = document.getElementById('queue-quick-range');
        var fromDate = document.getElementById('queue-from-date');
        var toDate = document.getElementById('queue-to-date');
        var queueHelp = document.getElementById('queue-filter-help');
        var feedback = document.getElementById('queue-feedback');
        var prevTicketNav = document.getElementById('prev-ticket-nav');
        var nextTicketNav = document.getElementById('next-ticket-nav');
        var navConfirmModal = document.getElementById('ticket-nav-confirm-modal');
        var navConfirmTitle = document.getElementById('ticket-nav-confirm-title');
        var navConfirmText = document.getElementById('ticket-nav-confirm-text');
        var navStayBtn = document.getElementById('ticket-nav-stay-btn');
        var navSaveContinueBtn = document.getElementById('ticket-nav-save-continue-btn');
        var currentSupportFaqId = @currentTicketId;
        var initialQueueRange = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(queueRange));
        var hasActiveTicket = @hasActiveTicket.ToString().ToLowerInvariant();
        var saveActivityCount = 0;
        var isNavigatingBetweenTickets = false;
        var pendingNavigationTicketId = 0;

        if (!search || !btn || !quickRange || !fromDate || !toDate || !feedback || !queueHelp) return;

        quickRange.value = initialQueueRange || 'custom';

        function beginSaveActivity() {
            saveActivityCount += 1;
        }

        function endSaveActivity() {
            saveActivityCount = Math.max(0, saveActivityCount - 1);
        }

        function isSaveInProgress() {
            return saveActivityCount > 0;
        }

        function toIsoDate(d) {
            var y = d.getFullYear();
            var m = String(d.getMonth() + 1).padStart(2, '0');
            var day = String(d.getDate()).padStart(2, '0');
            return y + '-' + m + '-' + day;
        }

        function applyQuickRange() {
            var selected = quickRange.value;
            if (selected === 'custom') return;

            var now = new Date();
            var end = new Date(now.getFullYear(), now.getMonth(), now.getDate());
            var start = new Date(end);
            if (selected === 'today') start = end;
            else if (selected === 'last7') start.setDate(start.getDate() - 6);
            else if (selected === 'last30') start.setDate(start.getDate() - 29);

            fromDate.value = toIsoDate(start);
            toDate.value = toIsoDate(end);
        }

        function updateQueueFeedback(show, message) {
            feedback.textContent = message || 'No tickets match the current queue filters.';
            feedback.style.display = show ? 'block' : 'none';
        }

        function buildQueueQueryString() {
            var params = new URLSearchParams();
            params.set('range', quickRange.value || 'custom');

            if (fromDate.value) params.set('from', fromDate.value);
            if (toDate.value) params.set('to', toDate.value);

            var rawSearch = (search.value || '').trim();
            if (rawSearch) params.set('search', rawSearch);

            return params.toString();
        }

        function updateQueueHelp(state) {
            if (!state) return;

            if (state.currentTicketInQueue && state.queuePosition) {
                queueHelp.textContent = 'Pending queue position ' + state.queuePosition + ' of ' + state.queueCount + '.';
                return;
            }

            if (state.queueCount > 0) {
                queueHelp.textContent = 'Current ticket is outside the pending queue. ' + state.queueCount + ' pending ticket(s) match the current filters.';
                return;
            }

            queueHelp.textContent = 'No pending QA tickets match the current filters.';
        }

        function fetchQueueState() {
            var queryString = buildQueueQueryString();
            var url = '/qa/api/rating-queue?' + queryString + '&ticketId=' + encodeURIComponent(String(currentSupportFaqId));

            return fetch(url, {
                headers: {
                    'Accept': 'application/json'
                }
            }).then(function (response) {
                return response.json().catch(function () { return null; }).then(function (result) {
                    if (!response.ok || !result) {
                        throw new Error('Unable to load the QA queue.');
                    }

                    return result;
                });
            });
        }

        function navigateToTicket(ticketId) {
            var queryString = buildQueueQueryString();
            var targetUrl = '/qa/rating/' + ticketId;
            window.location.href = queryString ? targetUrl + '?' + queryString : targetUrl;
        }

        function resolveNeighborTicketId(state, direction) {
            if (!state) return null;
            if (direction === 'prev') {
                return state.previousFilteredSupportFaqId || null;
            }

            if (direction === 'next') {
                return state.nextFilteredSupportFaqId || null;
            }

            return null;
        }

        function closeTicketNavConfirm() {
            if (!navConfirmModal) return;
            navConfirmModal.classList.remove('is-open');
            navConfirmModal.setAttribute('aria-hidden', 'true');
            document.body.classList.remove('modal-open');
            pendingNavigationTicketId = 0;
        }

        function openTicketNavConfirm(direction, targetTicketId) {
            if (!navConfirmModal) {
                return false;
            }

            pendingNavigationTicketId = targetTicketId;

            var directionText = direction === 'prev' ? 'previous' : 'next';
            if (navConfirmTitle) {
                navConfirmTitle.textContent = 'Continue to ticket #' + targetTicketId + '?';
            }
            if (navConfirmText) {
                navConfirmText.textContent = 'QA work is still active on this ticket. Save and continue to the ' + directionText + ' ticket?';
            }

            navConfirmModal.classList.add('is-open');
            navConfirmModal.setAttribute('aria-hidden', 'false');
            document.body.classList.add('modal-open');
            return true;
        }

        function attemptNavigateToDirection(direction) {
            if (!hasActiveTicket || !currentSupportFaqId || currentSupportFaqId <= 0 || isNavigatingBetweenTickets) {
                return;
            }

            fetchQueueState()
                .then(function (state) {
                    updateQueueHelp(state);
                    var targetTicketId = resolveNeighborTicketId(state, direction);
                    if (!targetTicketId) {
                        updateQueueFeedback(true, direction === 'prev'
                            ? 'No previous ticket matches the current queue filters.'
                            : 'No next ticket matches the current queue filters.');
                        return;
                    }

                    updateQueueFeedback(false);
                    if (hasActiveReviewState()) {
                        openTicketNavConfirm(direction, targetTicketId);
                        return;
                    }

                    isNavigatingBetweenTickets = true;
                    navigateToTicket(targetTicketId);
                })
                .catch(function (error) {
                    updateQueueFeedback(true, error && error.message ? error.message : 'Unable to load the QA queue.');
                });
        }

        function refreshQueueState() {
            fetchQueueState()
                .then(function (state) {
                    updateQueueHelp(state);
                    updateQueueFeedback(false);
                })
                .catch(function (error) {
                    updateQueueHelp({ queueCount: 0, currentTicketInQueue: false, queuePosition: null });
                    updateQueueFeedback(true, error && error.message ? error.message : 'Unable to load the QA queue.');
                });
        }

        function jumpToConversation() {
            fetchQueueState()
                .then(function (state) {
                    updateQueueHelp(state);

                    if (!state || !state.matchedSupportFaqId) {
                        updateQueueFeedback(true, 'No filtered ticket matches that ticket ID or agent name.');
                        return;
                    }

                    updateQueueFeedback(false);
                    navigateToTicket(state.matchedSupportFaqId);
                })
                .catch(function (error) {
                    updateQueueFeedback(true, error && error.message ? error.message : 'Unable to load the QA queue.');
                });
        }

        function setCustomRangeOnManualDate() {
            quickRange.value = 'custom';
            refreshQueueState();
        }

        search.addEventListener('keydown', function (e) {
            if (e.key !== 'Enter') return;
            e.preventDefault();
            jumpToConversation();
        });

        btn.addEventListener('click', jumpToConversation);

        if (prevTicketNav) {
            prevTicketNav.addEventListener('click', function (e) {
                e.preventDefault();
                attemptNavigateToDirection('prev');
            });
        }

        if (nextTicketNav) {
            nextTicketNav.addEventListener('click', function (e) {
                e.preventDefault();
                attemptNavigateToDirection('next');
            });
        }

        if (navStayBtn) {
            navStayBtn.addEventListener('click', function () {
                closeTicketNavConfirm();
            });
        }

        if (navSaveContinueBtn) {
            navSaveContinueBtn.addEventListener('click', function () {
                var targetTicketId = pendingNavigationTicketId;
                if (!targetTicketId) {
                    closeTicketNavConfirm();
                    return;
                }

                setButtonBusy(navSaveContinueBtn, true, 'Saving...');
                persistActiveWorkIfNeeded()
                    .then(function () {
                        closeTicketNavConfirm();
                        isNavigatingBetweenTickets = true;
                        navigateToTicket(targetTicketId);
                    })
                    .catch(function (error) {
                        updateQueueFeedback(true, error && error.message ? error.message : 'Unable to save active QA work.');
                    })
                    .finally(function () {
                        setButtonBusy(navSaveContinueBtn, false);
                    });
            });
        }

        if (navConfirmModal) {
            navConfirmModal.addEventListener('click', function (e) {
                if (e.target === navConfirmModal) {
                    closeTicketNavConfirm();
                }
            });
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && navConfirmModal.classList.contains('is-open')) {
                    closeTicketNavConfirm();
                }
            });
        }

        fromDate.addEventListener('focus', setCustomRangeOnManualDate);
        toDate.addEventListener('focus', setCustomRangeOnManualDate);
        fromDate.addEventListener('click', setCustomRangeOnManualDate);
        toDate.addEventListener('click', setCustomRangeOnManualDate);
        fromDate.addEventListener('change', setCustomRangeOnManualDate);
        toDate.addEventListener('change', setCustomRangeOnManualDate);
        search.addEventListener('change', refreshQueueState);

        quickRange.addEventListener('change', function () {
            if (quickRange.value === 'custom') {
                fromDate.value = '';
                toDate.value = '';
            }
            applyQuickRange();
            updateQueueFeedback(false);
            refreshQueueState();
        });

        refreshQueueState();

        var selectableMessages = document.querySelectorAll('.convo-body .selectable-msg');
        var inlineCommentThreads = {};
        var defaultQaName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(reviewerDisplayName));
        var inlineCommentsJsonRaw = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(inlineCommentsJson));

        function normalizeInlineCommentMap(value) {
            if (!value || typeof value !== 'object' || Array.isArray(value)) {
                return {};
            }

            return value;
        }

        function cloneInlineCommentMap(value) {
            try {
                return JSON.parse(JSON.stringify(normalizeInlineCommentMap(value)));
            } catch (error) {
                return {};
            }
        }

        function parseInlineCommentMap(value) {
            if (typeof value !== 'string') {
                return normalizeInlineCommentMap(value);
            }

            var trimmedValue = value.trim();
            if (!trimmedValue) {
                return {};
            }

            try {
                return normalizeInlineCommentMap(JSON.parse(trimmedValue));
            } catch (error) {
                return {};
            }
        }

        inlineCommentThreads = parseInlineCommentMap(inlineCommentsJsonRaw);
        var persistedInlineCommentSignature = serializeInlineCommentMap(inlineCommentThreads);
        var persistedNewRatingSignature = captureRatingSignature('new');
        var persistedEditRatingSignature = captureRatingSignature('edit');

        function escHtml(value) {
            return (value || '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function buildCurrentTimestamp() {
            var d = new Date();
            var month = d.toLocaleString('en-US', { month: 'short' });
            var day = d.getDate();
            var year = d.getFullYear();
            var hrs = d.getHours();
            var mins = String(d.getMinutes()).padStart(2, '0');
            var ampm = hrs >= 12 ? 'PM' : 'AM';
            var h12 = hrs % 12;
            if (h12 === 0) h12 = 12;
            return month + ' ' + day + ', ' + year + ' ' + h12 + ':' + mins + ' ' + ampm;
        }

        function renderInlineThread(msgEl, messageId) {
            var threadWrap = msgEl.querySelector('.msg-comment-thread');
            if (!threadWrap) {
                threadWrap = document.createElement('div');
                threadWrap.className = 'msg-comment-thread';
                msgEl.appendChild(threadWrap);
            }

            var entries = inlineCommentThreads[messageId] || [];
            if (!entries.length) {
                threadWrap.innerHTML = '';
                msgEl.classList.remove('has-inline-comment');
                return;
            }

            var html = '';
            for (var i = 0; i < entries.length; i++) {
                var entry = entries[i];
                var by = entry.by || defaultQaName;
                var on = entry.on || '';
                html += '<div class="msg-comment-entry">';
                html += '<div class="msg-comment-meta">' + escHtml(by) + (on ? ' - ' + escHtml(on) : '') + '</div>';
                html += escHtml(entry.comment);
                if (entry.images && entry.images.length) {
                    html += '<span class="msg-comment-images">Images: ' + escHtml(entry.images.join(', ')) + '</span>';
                }
                html += '<div class="msg-comment-inline-actions"><button type="button" class="msg-comment-btn small edit-inline-comment" data-entry-index="' + i + '">Edit</button></div>';
                html += '</div>';
            }
            threadWrap.innerHTML = html;
            msgEl.classList.add('has-inline-comment');

            var editButtons = threadWrap.querySelectorAll('.edit-inline-comment');
            editButtons.forEach(function (btn) {
                btn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    var idx = parseInt(btn.getAttribute('data-entry-index') || '-1', 10);
                    if (Number.isNaN(idx) || idx < 0 || idx >= entries.length) return;

                    var composer = ensureComposer(msgEl);
                    var textArea = composer.querySelector('textarea');
                    var saveBtn = composer.querySelector('.save-msg-comment');
                    if (!textArea || !saveBtn) return;

                    hideOtherComposers(msgEl);
                    msgEl.classList.add('selected-for-comment');
                    composer.style.display = 'grid';
                    composer.setAttribute('data-edit-index', String(idx));
                    textArea.value = entries[idx].comment || '';
                    saveBtn.textContent = 'Update comment';
                    textArea.focus();
                });
            });
        }

        function hideOtherComposers(activeMsgEl) {
            selectableMessages.forEach(function (msgEl) {
                if (msgEl !== activeMsgEl) msgEl.classList.remove('selected-for-comment');
                var composer = msgEl.querySelector('.msg-comment-composer');
                if (composer && msgEl !== activeMsgEl) composer.style.display = 'none';
            });
        }

        function ensureComposer(msgEl) {
            var composer = msgEl.querySelector('.msg-comment-composer');
            if (composer) return composer;

            composer = document.createElement('div');
            composer.className = 'msg-comment-composer';
            composer.innerHTML = ''
                + '<textarea placeholder="Add QA comment for this message..."></textarea>'
                + '<div class="msg-comment-actions">'
                + '  <button type="button" class="msg-comment-btn save-msg-comment">Save comment</button>'
                + '  <button type="button" class="msg-comment-btn cancel-msg-comment">Cancel</button>'
                + '</div>';

            msgEl.appendChild(composer);

            var textArea = composer.querySelector('textarea');
            var saveBtn = composer.querySelector('.save-msg-comment');
            var cancelBtn = composer.querySelector('.cancel-msg-comment');

            if (saveBtn && textArea) {
                saveBtn.addEventListener('click', function () {
                    var messageId = msgEl.getAttribute('data-message-id') || '';
                    var commentText = (textArea.value || '').trim();
                    if (!messageId || !commentText) return;
                    if (!currentSupportFaqId || currentSupportFaqId <= 0) return;

                    var editIndex = parseInt(composer.getAttribute('data-edit-index') || '-1', 10);
                    var previousThreads = cloneInlineCommentMap(inlineCommentThreads);
                    var saveBtnOriginalText = saveBtn.textContent || 'Save comment';

                    if (!inlineCommentThreads[messageId]) inlineCommentThreads[messageId] = [];
                    if (!Number.isNaN(editIndex) && editIndex >= 0 && inlineCommentThreads[messageId][editIndex]) {
                        inlineCommentThreads[messageId][editIndex].comment = commentText;
                        inlineCommentThreads[messageId][editIndex].on = buildCurrentTimestamp();
                    } else {
                        inlineCommentThreads[messageId].push({
                            by: defaultQaName,
                            on: buildCurrentTimestamp(),
                            comment: commentText,
                            images: []
                        });
                    }

                    renderInlineThread(msgEl, messageId);
                    saveBtn.disabled = true;
                    saveBtn.textContent = 'Saving...';

                    saveInlineComments()
                        .then(function () {
                            persistedInlineCommentSignature = serializeInlineCommentMap(inlineCommentThreads);
                            textArea.value = '';
                            composer.style.display = 'none';
                            composer.setAttribute('data-edit-index', '-1');
                            msgEl.classList.remove('selected-for-comment');
                        })
                        .catch(function (error) {
                            inlineCommentThreads = previousThreads;
                            renderInlineThread(msgEl, messageId);
                            if (window.console && window.console.error) {
                                window.console.error(error);
                            }
                            window.alert(error && error.message ? error.message : 'Unable to save QA conversation comments.');
                        })
                        .finally(function () {
                            saveBtn.disabled = false;
                            saveBtn.textContent = saveBtnOriginalText;
                        });
                });
            }

            if (cancelBtn && textArea) {
                cancelBtn.addEventListener('click', function () {
                    textArea.value = '';
                    composer.style.display = 'none';
                    composer.setAttribute('data-edit-index', '-1');
                    if (saveBtn) saveBtn.textContent = 'Save comment';
                    msgEl.classList.remove('selected-for-comment');
                });
            }

            return composer;
        }

        var allMessages = document.querySelectorAll('.convo-body .msg[data-message-id]');
        allMessages.forEach(function (msgEl) {
            var messageId = msgEl.getAttribute('data-message-id') || '';
            if (!messageId || !inlineCommentThreads[messageId]) return;
            renderInlineThread(msgEl, messageId);
        });

        if (selectableMessages.length) {
            selectableMessages.forEach(function (msgEl) {
                msgEl.addEventListener('click', function (e) {
                    if (e.target.closest('.msg-comment-composer') || e.target.closest('.msg-comment-thread')) return;

                    var messageId = msgEl.getAttribute('data-message-id') || '';
                    if (!messageId) return;

                    hideOtherComposers(msgEl);
                    var composer = ensureComposer(msgEl);
                    msgEl.classList.add('selected-for-comment');
                    composer.style.display = 'grid';
                });
            });
        }

        function readGroupScores(groupName, rootPrefix) {
            var values = [];
            for (var q = 1; q <= 3; q++) {
                var selector = 'input[name="' + rootPrefix + '-' + groupName + '-q' + q + '"]:checked';
                var selected = document.querySelector(selector);
                if (!selected) return null;
                var val = parseInt(selected.value || '', 10);
                if (Number.isNaN(val) || val < 1 || val > 5) return null;
                values.push(val);
            }
            return values;
        }

        function serializeInlineCommentMap(value) {
            try {
                return JSON.stringify(cloneInlineCommentMap(value));
            } catch (error) {
                return '{}';
            }
        }

        function captureRatingSignature(rootPrefix) {
            var scoreParts = [];
            var groups = ['accuracy', 'tone', 'resolution'];
            for (var g = 0; g < groups.length; g++) {
                var groupName = groups[g];
                for (var q = 1; q <= 3; q++) {
                    var selector = 'input[name="' + rootPrefix + '-' + groupName + '-q' + q + '"]:checked';
                    var selected = document.querySelector(selector);
                    scoreParts.push(selected ? String(selected.value || '') : '');
                }
            }

            var notesField = document.getElementById(rootPrefix + '-notes');
            var notesValue = notesField ? (notesField.value || '').trim() : '';
            return scoreParts.join('|') + '||' + notesValue;
        }

        function hasUnsavedInlineCommentText() {
            var composers = document.querySelectorAll('.msg-comment-composer');
            for (var i = 0; i < composers.length; i++) {
                var textArea = composers[i].querySelector('textarea');
                if (!textArea) continue;
                if ((textArea.value || '').trim()) {
                    return true;
                }
            }

            return false;
        }

        function hasVisibleCommentComposer() {
            var composers = document.querySelectorAll('.msg-comment-composer');
            for (var i = 0; i < composers.length; i++) {
                if (composers[i].style.display === 'grid') {
                    return true;
                }
            }

            return false;
        }

        function collectPendingComposerComments() {
            var changed = false;
            var composers = document.querySelectorAll('.msg-comment-composer');

            for (var i = 0; i < composers.length; i++) {
                var composer = composers[i];
                var msgEl = composer.closest('.msg[data-message-id]');
                if (!msgEl) continue;

                var textArea = composer.querySelector('textarea');
                if (!textArea) continue;

                var commentText = (textArea.value || '').trim();
                if (!commentText) continue;

                var messageId = msgEl.getAttribute('data-message-id') || '';
                if (!messageId) continue;

                var editIndex = parseInt(composer.getAttribute('data-edit-index') || '-1', 10);

                if (!inlineCommentThreads[messageId]) inlineCommentThreads[messageId] = [];
                if (!Number.isNaN(editIndex) && editIndex >= 0 && inlineCommentThreads[messageId][editIndex]) {
                    inlineCommentThreads[messageId][editIndex].comment = commentText;
                    inlineCommentThreads[messageId][editIndex].on = buildCurrentTimestamp();
                } else {
                    inlineCommentThreads[messageId].push({
                        by: defaultQaName,
                        on: buildCurrentTimestamp(),
                        comment: commentText,
                        images: []
                    });
                }

                renderInlineThread(msgEl, messageId);
                textArea.value = '';
                composer.style.display = 'none';
                composer.setAttribute('data-edit-index', '-1');
                msgEl.classList.remove('selected-for-comment');
                var saveBtn = composer.querySelector('.save-msg-comment');
                if (saveBtn) saveBtn.textContent = 'Save comment';
                changed = true;
            }

            return changed;
        }

        function isInlineCommentsDirty() {
            return serializeInlineCommentMap(inlineCommentThreads) !== persistedInlineCommentSignature;
        }

        function isNewRatingDirty() {
            var newForm = document.getElementById('new-rating-form');
            if (!newForm) return false;
            return captureRatingSignature('new') !== persistedNewRatingSignature;
        }

        function isEditRatingDirty() {
            var ratedEditForm = document.getElementById('rated-edit-form');
            if (!ratedEditForm || ratedEditForm.style.display === 'none') return false;
            return captureRatingSignature('edit') !== persistedEditRatingSignature;
        }

        function hasActiveReviewState() {
            if (isSaveInProgress()) {
                return true;
            }

            if (hasVisibleCommentComposer() || hasUnsavedInlineCommentText()) {
                return true;
            }

            if (isInlineCommentsDirty()) {
                return true;
            }

            if (isNewRatingDirty() || isEditRatingDirty()) {
                return true;
            }

            return false;
        }

        function persistActiveWorkIfNeeded() {
            var hadPendingCommentText = collectPendingComposerComments();
            var shouldPersistInlineComments = hadPendingCommentText || isInlineCommentsDirty();
            var shouldPersistRating = isNewRatingDirty() || isEditRatingDirty();
            var ratingRootPrefix = isEditRatingDirty() ? 'edit' : 'new';

            var task = Promise.resolve();

            if (shouldPersistInlineComments) {
                task = task.then(function () {
                    return saveInlineComments().then(function () {
                        persistedInlineCommentSignature = serializeInlineCommentMap(inlineCommentThreads);
                    });
                });
            }

            if (shouldPersistRating) {
                task = task.then(function () {
                    return saveReview(ratingRootPrefix, false).then(function () {
                        persistedNewRatingSignature = captureRatingSignature('new');
                        persistedEditRatingSignature = captureRatingSignature('edit');
                        persistedInlineCommentSignature = serializeInlineCommentMap(inlineCommentThreads);
                    });
                });
            }

            return task;
        }

        function average(values) {
            if (!values || values.length === 0) return 0;
            var sum = 0;
            for (var i = 0; i < values.length; i++) sum += values[i];
            return sum / values.length;
        }

        function round1(value) {
            return Math.round(value * 10) / 10;
        }

        function updateAverages(rootPrefix, targetPrefix) {
            var accuracy = average(readGroupScores('accuracy', rootPrefix) || []);
            var tone = average(readGroupScores('tone', rootPrefix) || []);
            var resolution = average(readGroupScores('resolution', rootPrefix) || []);

            var accuracyPoints = round1((accuracy / 5) * 35);
            var tonePoints = round1((tone / 5) * 35);
            var resolutionPoints = round1((resolution / 5) * 30);
            var overallPercent = round1(accuracyPoints + tonePoints + resolutionPoints);

            var accEl = document.getElementById(targetPrefix + '-avg-accuracy');
            var toneEl = document.getElementById(targetPrefix + '-avg-tone');
            var resEl = document.getElementById(targetPrefix + '-avg-resolution');
            if (accEl) accEl.innerHTML = '<strong>' + accuracyPoints.toFixed(1) + ' / 35</strong>';
            if (toneEl) toneEl.innerHTML = '<strong>' + tonePoints.toFixed(1) + ' / 35</strong>';
            if (resEl) resEl.innerHTML = '<strong>' + resolutionPoints.toFixed(1) + ' / 30</strong>';

            return {
                accuracy: accuracy,
                tone: tone,
                resolution: resolution,
                accuracyPoints: accuracyPoints,
                tonePoints: tonePoints,
                resolutionPoints: resolutionPoints,
                overallPercent: overallPercent
            };
        }

        function bindRealtimeAverage(selector, rootPrefix, targetPrefix) {
            var inputs = document.querySelectorAll(selector);
            if (!inputs.length) return;

            for (var i = 0; i < inputs.length; i++) {
                inputs[i].addEventListener('change', function () {
                    updateAverages(rootPrefix, targetPrefix);
                });
            }

            updateAverages(rootPrefix, targetPrefix);
        }

        bindRealtimeAverage('.new-score-input', 'new', 'new');
        bindRealtimeAverage('.edit-score-input', 'edit', 'edit');

        function setButtonBusy(button, isBusy, busyText) {
            if (!button) return;
            if (isBusy) {
                button.setAttribute('data-original-text', button.textContent || '');
                button.disabled = true;
                button.textContent = busyText;
                return;
            }

            var originalText = button.getAttribute('data-original-text');
            button.disabled = false;
            if (originalText) button.textContent = originalText;
        }

        function buildReviewPayload(rootPrefix, submitToAgentNow) {
            var accuracyScores = readGroupScores('accuracy', rootPrefix);
            var toneScores = readGroupScores('tone', rootPrefix);
            var resolutionScores = readGroupScores('resolution', rootPrefix);

            if (!accuracyScores || !toneScores || !resolutionScores) {
                return null;
            }

            var notesField = document.getElementById(rootPrefix + '-notes');
            var normalizedInlineCommentThreads = normalizeInlineCommentMap(inlineCommentThreads);

            return {
                accuracyScores: accuracyScores,
                toneScores: toneScores,
                resolutionScores: resolutionScores,
                notes: notesField ? (notesField.value || '').trim() : '',
                submitToAgentNow: !!submitToAgentNow,
                inlineCommentThreads: normalizedInlineCommentThreads
            };
        }

        function saveInlineComments() {
            var payload = {
                inlineCommentThreads: normalizeInlineCommentMap(inlineCommentThreads)
            };

            beginSaveActivity();
            return fetch('/qa/api/reviews/' + currentSupportFaqId + '/inline-comments', {
                method: 'POST',
                headers: {
                    'Accept': 'application/json',
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(payload)
            })
                .then(function (response) {
                    return response.json().catch(function () { return { success: false, message: 'Unable to save QA conversation comments.' }; })
                        .then(function (result) {
                            if (!response.ok || !result.success) {
                                throw new Error(result.message || 'Unable to save QA conversation comments.');
                            }

                            return result;
                        });
                })
                .finally(function () {
                    endSaveActivity();
                });
        }

        function saveReview(rootPrefix, submitToAgentNow) {
            var payload = buildReviewPayload(rootPrefix, submitToAgentNow);
            if (!payload) {
                return Promise.reject(new Error('All 9 questions must be scored from 1 to 5.'));
            }

            beginSaveActivity();
            return fetch('/qa/api/reviews/' + currentSupportFaqId, {
                method: 'POST',
                headers: {
                    'Accept': 'application/json',
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(payload)
            })
                .then(function (response) {
                    return response.json().catch(function () { return { success: false, message: 'Unable to save QA review.' }; })
                        .then(function (result) {
                            if (!response.ok || !result.success) {
                                throw new Error(result.message || 'Unable to save QA review.');
                            }

                            return result;
                        });
                })
                .finally(function () {
                    endSaveActivity();
                });
        }

        function submitReviewToAgent() {
            beginSaveActivity();
            return fetch('/qa/api/reviews/' + currentSupportFaqId + '/submit-agent', {
                method: 'POST',
                headers: {
                    'Accept': 'application/json'
                }
            })
                .then(function (response) {
                    return response.json().catch(function () { return { success: false, message: 'Unable to submit QA review to the agent.' }; })
                        .then(function (result) {
                            if (!response.ok || !result.success) {
                                throw new Error(result.message || 'Unable to submit QA review to the agent.');
                            }

                            return result;
                        });
                })
                .finally(function () {
                    endSaveActivity();
                });
        }

        var submitNewBtn = document.getElementById('submit-new-rating');
        var newError = document.getElementById('new-rating-error');
        var newSuccess = document.getElementById('new-rating-success');
        var submitChoiceModal = document.getElementById('submit-choice-modal');
        var submitChoiceYesBtn = document.getElementById('submit-choice-yes');
        var submitChoiceNoBtn = document.getElementById('submit-choice-no');
        var submitChoiceCancelBtn = document.getElementById('submit-choice-cancel');
        var submitChoiceCallback = null;

        function closeSubmitChoice(decision) {
            if (!submitChoiceModal) return;
            submitChoiceModal.classList.remove('is-open');
            submitChoiceModal.setAttribute('aria-hidden', 'true');
            document.body.classList.remove('modal-open');

            var cb = submitChoiceCallback;
            submitChoiceCallback = null;
            if (typeof cb === 'function') cb(decision);
        }

        function openSubmitChoice(onDecision) {
            if (!submitChoiceModal) {
                onDecision(true);
                return;
            }
            submitChoiceCallback = onDecision;
            submitChoiceModal.classList.add('is-open');
            submitChoiceModal.setAttribute('aria-hidden', 'false');
            document.body.classList.add('modal-open');
        }

        if (submitChoiceYesBtn) submitChoiceYesBtn.addEventListener('click', function () { closeSubmitChoice(true); });
        if (submitChoiceNoBtn) submitChoiceNoBtn.addEventListener('click', function () { closeSubmitChoice(false); });
        if (submitChoiceCancelBtn) submitChoiceCancelBtn.addEventListener('click', function () { closeSubmitChoice(null); });
        if (submitChoiceModal) {
            submitChoiceModal.addEventListener('click', function (e) {
                if (e.target === submitChoiceModal) closeSubmitChoice(null);
            });
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && submitChoiceModal.classList.contains('is-open')) closeSubmitChoice(null);
            });
        }

        if (submitNewBtn) {
            submitNewBtn.addEventListener('click', function () {
                var previewPayload = buildReviewPayload('new', false);
                if (!previewPayload) {
                    if (newSuccess) newSuccess.style.display = 'none';
                    if (newError) newError.style.display = 'block';
                    if (newError) newError.textContent = 'Please score all 9 questions using the 1-5 scale.';
                    return;
                }

                openSubmitChoice(function (sendToAgent) {
                    if (sendToAgent === null) return;

                    if (newError) newError.style.display = 'none';
                    setButtonBusy(submitNewBtn, true, 'Saving...');

                    saveReview('new', sendToAgent)
                        .then(function () {
                            persistedNewRatingSignature = captureRatingSignature('new');
                            persistedInlineCommentSignature = serializeInlineCommentMap(inlineCommentThreads);
                            if (newSuccess) {
                                var metrics = updateAverages('new', 'new');
                                var submitStateText = sendToAgent
                                    ? 'Submitted to agent.'
                                    : 'Saved by QA only (not sent to agent).';
                                newSuccess.innerHTML = '<strong>Scores captured.</strong> Accuracy <strong>' + metrics.accuracyPoints.toFixed(1) + '/35</strong>, Empathy <strong>' + metrics.tonePoints.toFixed(1) + '/35</strong>, Resolution <strong>' + metrics.resolutionPoints.toFixed(1) + '/30</strong>, Total <strong>' + metrics.overallPercent.toFixed(1) + ' / 100</strong>. <strong>' + submitStateText + '</strong>';
                                newSuccess.style.display = 'block';
                            }

                            window.location.reload();
                        })
                        .catch(function (error) {
                            if (newSuccess) newSuccess.style.display = 'none';
                            if (newError) {
                                newError.textContent = error && error.message ? error.message : 'Unable to save the QA review.';
                                newError.style.display = 'block';
                            }
                        })
                        .finally(function () {
                            setButtonBusy(submitNewBtn, false);
                        });
                });
            });
        }

        var editBtn = document.getElementById('edit-rated-btn');
        var viewBtn = document.getElementById('view-rated-btn');
        var cancelBtn = document.getElementById('cancel-rated-btn');
        var saveBtn = document.getElementById('save-rated-btn');
        var summaryView = document.getElementById('rated-summary-view');
        var viewForm = document.getElementById('rated-view-form');
        var backViewBtn = document.getElementById('back-rated-view-btn');
        var editForm = document.getElementById('rated-edit-form');
        var editError = document.getElementById('edit-rating-error');
        var ratedSubmitBtn = document.getElementById('rated-submit-agent-btn');
        var ratedSubmitStatus = document.getElementById('rated-submit-status');
        var ratedSubmitNote = document.getElementById('rated-submit-note');
        var ratedSubmitConfirmModal = document.getElementById('rated-submit-confirm-modal');
        var ratedSubmitConfirmTitle = document.getElementById('rated-submit-confirm-title');
        var ratedSubmitConfirmText = document.getElementById('rated-submit-confirm-text');
        var ratedSubmitConfirmOk = document.getElementById('rated-submit-confirm-ok');
        var ratedSubmitConfirmCancel = document.getElementById('rated-submit-confirm-cancel');
        var ratedSubmitConfirmCallback = null;

        function closeRatedSubmitConfirm(decision) {
            if (!ratedSubmitConfirmModal) return;
            ratedSubmitConfirmModal.classList.remove('is-open');
            ratedSubmitConfirmModal.setAttribute('aria-hidden', 'true');
            document.body.classList.remove('modal-open');

            var cb = ratedSubmitConfirmCallback;
            ratedSubmitConfirmCallback = null;
            if (typeof cb === 'function') cb(decision);
        }

        function openRatedSubmitConfirm(alreadySubmitted, onDecision) {
            if (!ratedSubmitConfirmModal) {
                onDecision(true);
                return;
            }

            if (ratedSubmitConfirmTitle) {
                ratedSubmitConfirmTitle.textContent = alreadySubmitted
                    ? 'This score was already submitted. Submit again to the agent?'
                    : 'Submit this QA score to the agent now?';
            }

            if (ratedSubmitConfirmText) {
                ratedSubmitConfirmText.textContent = alreadySubmitted
                    ? 'This will send the score again and refresh the submission timestamp.'
                    : 'This sends the current QA score summary to the agent.';
            }

            ratedSubmitConfirmCallback = onDecision;
            ratedSubmitConfirmModal.classList.add('is-open');
            ratedSubmitConfirmModal.setAttribute('aria-hidden', 'false');
            document.body.classList.add('modal-open');
        }

        if (ratedSubmitConfirmOk) ratedSubmitConfirmOk.addEventListener('click', function () { closeRatedSubmitConfirm(true); });
        if (ratedSubmitConfirmCancel) ratedSubmitConfirmCancel.addEventListener('click', function () { closeRatedSubmitConfirm(false); });
        if (ratedSubmitConfirmModal) {
            ratedSubmitConfirmModal.addEventListener('click', function (e) {
                if (e.target === ratedSubmitConfirmModal) closeRatedSubmitConfirm(false);
            });
        }

        if (ratedSubmitBtn && ratedSubmitStatus && ratedSubmitNote) {
            ratedSubmitBtn.addEventListener('click', function () {
                var alreadySubmitted = ratedSubmitStatus.classList.contains('sent');
                openRatedSubmitConfirm(alreadySubmitted, function (confirmed) {
                    if (!confirmed) return;

                    setButtonBusy(ratedSubmitBtn, true, 'Submitting...');

                    submitReviewToAgent()
                        .then(function () {
                            window.location.reload();
                        })
                        .catch(function (error) {
                            if (ratedSubmitNote) {
                                ratedSubmitNote.textContent = error && error.message
                                    ? error.message
                                    : 'Unable to submit the QA review to the agent.';
                            }
                        })
                        .finally(function () {
                            setButtonBusy(ratedSubmitBtn, false);
                        });
                });
            });
        }

        if (viewBtn && backViewBtn && summaryView && viewForm) {
            viewBtn.addEventListener('click', function () {
                summaryView.style.display = 'none';
                viewForm.style.display = 'grid';
            });

            backViewBtn.addEventListener('click', function () {
                viewForm.style.display = 'none';
                summaryView.style.display = '';
            });
        }

        if (editBtn && cancelBtn && saveBtn && summaryView && editForm) {
            editBtn.addEventListener('click', function () {
                summaryView.style.display = 'none';
                if (viewForm) viewForm.style.display = 'none';
                editForm.style.display = 'grid';
                if (editError) editError.style.display = 'none';
            });

            cancelBtn.addEventListener('click', function () {
                editForm.style.display = 'none';
                summaryView.style.display = '';
                if (editError) editError.style.display = 'none';
            });

            saveBtn.addEventListener('click', function () {
                var previewPayload = buildReviewPayload('edit', false);
                if (!previewPayload) {
                    if (editError) editError.style.display = 'block';
                    if (editError) editError.textContent = 'Please score all 9 questions using the 1-5 scale.';
                    return;
                }

                if (editError) editError.style.display = 'none';
                setButtonBusy(saveBtn, true, 'Saving...');

                saveReview('edit', false)
                    .then(function () {
                        persistedEditRatingSignature = captureRatingSignature('edit');
                        persistedInlineCommentSignature = serializeInlineCommentMap(inlineCommentThreads);
                        window.location.reload();
                    })
                    .catch(function (error) {
                        if (editError) {
                            editError.textContent = error && error.message ? error.message : 'Unable to save the QA review.';
                            editError.style.display = 'block';
                        }
                    })
                    .finally(function () {
                        setButtonBusy(saveBtn, false);
                    });
            });
        }

    })();
</script>
