@{
    ViewData["Title"] = "Returns & Refunds - FAQ";
}

@section Styles {
    <link href="~/HelpCenter/faq-pages.css" rel="stylesheet" asp-append-version="true" />
}

<div class="help-center-page">
    <a href="/Help" class="help-back-btn">
        <i class="fas fa-arrow-left"></i> Back to Help Center
    </a>

    <div class="help-page-header">
        <div class="help-page-icon">
            <i class="fa-solid fa-rotate-left"></i>
        </div>
        <h1>Returns & Refunds</h1>
        <p>Return items and get refunds</p>
    </div>

    <div class="help-page-faq">
        <div class="help-faq-item">
            <div class="help-faq-question">
                <span>How do I request a refund?</span>
                <i class="fas fa-chevron-down"></i>
            </div>
            <div class="help-faq-answer">
                Go to your order details and click <strong>Return / Refund</strong>. Select a reason, upload photos if needed, and submit. Refunds process within 5-10 business days.
            </div>
        </div>

        <div class="help-faq-item">
            <div class="help-faq-question">
                <span>Can I return used items?</span>
                <i class="fas fa-chevron-down"></i>
            </div>
            <div class="help-faq-answer">
                Only unused items with original packaging, tags, and proof of purchase are accepted. Hygiene-sensitive items (underwear, cosmetics) cannot be returned.
            </div>
        </div>

        <div class="help-faq-item">
            <div class="help-faq-question">
                <span>Who pays for return shipping?</span>
                <i class="fas fa-chevron-down"></i>
            </div>
            <div class="help-faq-answer">
                If the item is defective or we sent the wrong item: we cover return shipping. For change-of-mind returns: customer pays return shipping.
            </div>
        </div>

        <div class="help-faq-item">
            <div class="help-faq-question">
                <span>What if my item arrives damaged?</span>
                <i class="fas fa-chevron-down"></i>
            </div>
            <div class="help-faq-answer">
                Contact us within 48 hours with photos of the damage. We'll arrange a free replacement or full refund. Email: <a href="mailto:support@nexthorizon.com">support@nexthorizon.com</a>
            </div>
        </div>

        <div class="help-faq-item">
            <div class="help-faq-question">
                <span>How long do I have to return an item?</span>
                <i class="fas fa-chevron-down"></i>
            </div>
            <div class="help-faq-answer">
                You have 30 days from delivery date to initiate a return. After 30 days, returns are not accepted unless the item is defective.
            </div>
        </div>

        <div class="help-faq-item">
            <div class="help-faq-question">
                <span>When will I receive my refund?</span>
                <i class="fas fa-chevron-down"></i>
            </div>
            <div class="help-faq-answer">
                Refunds are processed within 5-10 business days after we receive and inspect your return. The amount will appear on your original payment method.
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/help-center.js" asp-append-version="true"></script>
}
